l id="v27" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ff6b35;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="42" y="912" width="30" height="30" as="geometry"/></mxCell><mxCell id="v28" value="Shown (HTTP 404) when the past IDP doesn't exist, was deleted or belongs to another designer - when the update form is opened, or when Save changes finds it gone." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;fontStyle=0;fontColor=#1e293b;fontFamily=Helvetica;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="90" y="916" width="1150" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="d329594" name="5 BCE Class Diagram"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="2100" pageHeight="915" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v5001" value="Boundary" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="55" y="88" width="150" height="37" as="geometry"/></mxCell><mxCell id="v5002" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="55" y="125" width="500" height="750" as="geometry"/></mxCell><mxCell id="v5003" value="Control" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="630" y="88" width="150" height="37" as="geometry"/></mxCell><mxCell id="v5004" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="630" y="125" width="620" height="750" as="geometry"/></mxCell><mxCell id="v5005" value="Entity" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1325" y="88" width="150" height="37" as="geometry"/></mxCell><mxCell id="v5006" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="1325" y="125" width="630" height="750" as="geometry"/></mxCell><mxCell id="v2" value="B-C-E Class Diagram - UC27 Update past IDP (US27)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=29;fontStyle=1;fontColor=#1e293b;fontFamily=Helvetica;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="24" y="15" width="2000" height="43" as="geometry"/></mxCell><mxCell id="v3" value="«boundary»&lt;br&gt;EditPastIDPPage" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;fontStyle=1;fontSize=17;" vertex="1" parent="1"><mxGeometry x="83" y="182" width="444" height="60" as="geometry"/></mxCell><mxCell id="v4" value="-updatePastIDPController: UpdatePastIDPController&lt;br&gt;-idp: IDP&lt;br&gt;-fieldErrors: dict" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="83" y="242" width="444" height="88" as="geometry"/></mxCell><mxCell id="v5" value="+openEditForm(idpId)&lt;br&gt;+getAvailableCategories(): list&lt;br&gt;+displayEditForm(msg=None)&lt;br&gt;+validateInput(idp): bool&lt;br&gt;+submitUpdatedDetails(idpId, title, categoryId, description, location)&lt;br&gt;+displaySuccessMessage(msg)&lt;br&gt;+displayErrorMessage(msg)&lt;br&gt;+displayNotFoundMessage(msg)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="83" y="330" width="444" height="232" as="geometry"/></mxCell><mxCell id="v6" value="" style="rounded=0;html=1;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="83" y="182" width="444" height="380" as="geometry"/></mxCell><mxCell id="v7" value="submitUpdatedDetails() trims the spaces and builds idp = IDP(idpId, session userId, categoryId, title, description, location, 'Past'). validateInput(idp) checks every field rule (the same as US25) and that the category is one of the Active ones from getAvailableCategories()." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;whiteSpace=wrap;spacing=12;" vertex="1" parent="1"><mxGeometry x="83" y="602" width="444" height="140" as="geometry"/></mxCell><mxCell id="v8" value="«control»&lt;br&gt;UpdatePastIDPController" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;fontStyle=1;fontSize=17;" vertex="1" parent="1"><mxGeometry x="658" y="182" width="564" height="60" as="geometry"/></mxCell><mxCell id="v9" value="+getPastIDP(designerId, idpId): IDP&lt;br&gt;+updatePastIDP(idp): bool" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="658" y="242" width="564" height="64" as="geometry"/></mxCell><mxCell id="v10" value="" style="rounded=0;html=1;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="658" y="182" width="564" height="124" as="geometry"/></mxCell><mxCell id="v11" value="«control» (from US45)&lt;br&gt;SearchIDPCategoryController" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;fontStyle=1;fontSize=17;" vertex="1" parent="1"><mxGeometry x="658" y="356" width="564" height="60" as="geometry"/></mxCell><mxCell id="v12" value="+searchIDPCategories(keyword): list" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="658" y="416" width="564" height="40" as="geometry"/></mxCell><mxCell id="v13" value="" style="rounded=0;html=1;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="658" y="356" width="564" height="100" as="geometry"/></mxCell><mxCell id="v14" value="The controller just calls the entity and returns the result - no checks. getPastIDP() is US27's own loader for the form (the page also asks it again after a failed update). Listing the categories is US45's job, so the page borrows that control (empty keyword). Precondition: logged in as an interior designer (UC13). designerLoginRequired in app.py only sends someone with no session to /designer/login." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;whiteSpace=wrap;spacing=12;" vertex="1" parent="1"><mxGeometry x="658" y="506" width="564" height="165" as="geometry"/></mxCell><mxCell id="v15" value="«entity»&lt;br&gt;IDP" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;fontStyle=1;fontSize=17;" vertex="1" parent="1"><mxGeometry x="1353" y="182" width="