Cell><mxCell id="v7" value="The same page class as US26 (the past IDPs list and details); these are its US28 methods. Cancel never calls the controller." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;whiteSpace=wrap;spacing=12;" vertex="1" parent="1"><mxGeometry x="83" y="482" width="444" height="93" as="geometry"/></mxCell><mxCell id="v8" value="«control»&lt;br&gt;DeletePastIDPController" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;fontStyle=1;fontSize=17;" vertex="1" parent="1"><mxGeometry x="658" y="182" width="564" height="60" as="geometry"/></mxCell><mxCell id="v9" value="+getPastIDP(designerId, idpId): IDP&lt;br&gt;+deletePastIDP(designerId, idpId): bool" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="658" y="242" width="564" height="64" as="geometry"/></mxCell><mxCell id="v10" value="" style="rounded=0;html=1;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="658" y="182" width="564" height="124" as="geometry"/></mxCell><mxCell id="v11" value="The controller just calls the entity - no checks. Precondition: the designer is already logged in (UC13), so this use case doesn't check the designer again - no InteriorDesignerLoginController (lecturer feedback, same as UC20)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;whiteSpace=wrap;spacing=12;" vertex="1" parent="1"><mxGeometry x="658" y="356" width="564" height="114" as="geometry"/></mxCell><mxCell id="v12" value="«entity»&lt;br&gt;IDP" style="rounded=0;whiteSpace=wrap;html=1;fillColor