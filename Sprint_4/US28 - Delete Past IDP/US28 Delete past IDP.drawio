nt x="1350" y="1230" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s57" value="[deleted == False]" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontStyle=1;fontColor=#1e293b;fontFamily=Helvetica;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="126" y="1234" width="1210" height="22" as="geometry"/></mxCell><mxCell id="s58" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="40" y="786" width="1330" height="766" as="geometry"/></mxCell><mxCell id="s59" value="alt" style="shape=card;size=8;flipH=1;flipV=1;html=1;fillColor=#ffffff;strokeColor=#334155;fontSize=12;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="40" y="786" width="50" height="24" as="geometry"/></mxCell><mxCell id="s60" value="[designer clicks 'Delete past IDP']" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontStyle=1;fontColor=#1e293b;fontFamily=Helvetica;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="106" y="790" width="1250" height="22" as="geometry"/></mxCell><mxCell id="s61" style="endArrow=none;endFill=0;html=1;rounded=0;strokeColor=#334155;strokeWidth=1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="40" y="1402" as="sourcePoint"/><mxPoint x="1370" y="1402" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s62" value="[designer clicks Cancel]" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontStyle=1;fontColor=#1e293b;fontFamily=Helvetica;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="106" y="1406" width="1250" height="22" as="geometry"/></mxCell><mxCell id="v65" value="deleted == False means the past IDP is no longer this designer's Active past IDP (deleted meanwhile, or not theirs), so the page shows the not-found page - there is no second lookup. Precondition: the designer is logged in (UC13). A request with no session is sent to /designer/login by designerLoginRequired in app.py before the page runs, so the use case doesn't check the designer again." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontStyle=0;fontColor=#1e293b;fontFamily=Helvetica;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="22" y="1630" width="1370" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>