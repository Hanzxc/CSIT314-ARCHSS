int x="1550" y="1606" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v76" value="[input is invalid]" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontStyle=1;fontColor=#1e293b;fontFamily=Helvetica;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="106" y="1610" width="1430" height="22" as="geometry"/></mxCell><mxCell id="v77" value="When the update fails, the page asks getPastIDP() again to tell &#x27;not found&#x27; (deleted / not theirs) from other failures. Precondition: the designer is logged in (UC13). A request with no session is sent to /designer/login by designerLoginRequired in app.py before the page runs, so the use case doesn&#x27;t check the designer again." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontStyle=0;fontColor=#1e293b;fontFamily=Helvetica;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="22" y="1836" width="1550" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>