hiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="630" y="125" width="620" height="726" as="geometry"/></mxCell><mxCell id="v5005" value="Entity" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1325" y="88" width="150" height="37" as="geometry"/></mxCell><mxCell id="v5006" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="1325" y="125" width="630" height="726" as="geometry"/></mxCell><mxCell id="v2" value="B-C-E Class Diagram - UC25 Add past IDP (US25)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=29;fontStyle=1;fontColor=#1e293b;fontFamily=Helvetica;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="24" y="15" width="2000" height="43" as="geometry"/></mxCell><mxCell id="v3" value="«boundary»&lt;br&gt;AddPastIDPPage" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;fontStyle=1;fontSize=17;" vertex="1" parent="1"><mxGeometry x="83" y="182" width="444" height="60" as="geometry"/></mxCell><mxCell id="v4" value="-addPastIDPController: AddPastIDPController&lt;br&gt;-idp: IDP&lt;br&gt;-fieldErrors: dict" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="83" y="242" width="444" height="88" as="geometry"/></mxCell><mxCell id="v5" value="+openAddPastIDPForm()&lt;br&gt;+getAvailableCategories(): list&lt;br&gt;+displayPastIDPForm(msg=None)&lt;br&gt;+validateInput(idp): bool&lt;br&gt;+submitPastIDP(title, categoryId, description, location)&lt;br&gt;+displaySuccessMessage(msg)&lt;br&gt;+displayErrorMessage(msg)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="83" y="330" width="444" height="208" as="geometry"/></mxCell><mxCell id="v6" value="" style="rounded=0;html=1;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="83" y="182" width="444" height="356" as="geometry"/></mxCell><mxCell id="v7" value="validateInput() checks every field and that the category is one of the Active ones in the drop-down. The page puts the input in an IDP object (owner = session userId, never a form field)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;whiteSpace=wrap;spacing=12;" vertex="1" parent="1"><mxGeometry x="83" y="578" width="444" height="114" as="geometry"/></mxCell><mxCell id="v8" value="«control»&lt;br&gt;AddPastIDPController" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;fontStyle=1;fontSize=17;" vertex="1" parent="1"><mxGeometry x="658" y="182" width="564" height="60" as="geometry"/></mxCell><mxCell id="v9" value="+addPastIDP(idp): bool" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="658" y="242" width="564" height="40" as="geometry"/></mxCell><mxCell id="v10" value="" style="rounded=0;html=1;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="658" y="182" width="564" height="100" as="geometry"/></mxCell><mxCell id="v11" value="«control»&lt;br&gt;SearchIDPCategoryController (reused from US45)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;fontStyle=1;fontSize=17;" vertex="1" parent="1"><mxGeometry x="658" y="332" width="564" height="60" as="geometry"/></mxCell><mxCell id="v12" value="+searchIDPCategories(keyword): list" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="658" y="392" width="564" height="40" as="geometry"/></mxCell><mxCell id="v13" value="" style="rounded=0;html=1;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="658" y="332" width="564" height="100" as="geometry"/></mxCell><mxCell id="v14" value="The controller just calls create - no checks. Listing the categories is US45&#x27;s job, so the page borrows that control for the drop-down. Precondition: the designer is already logged in (UC13), so this use case doesn&#x27;t check the designer again - no InteriorDesignerLoginController (lecturer feedback, same as UC20)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;whiteSpace=wrap;spacing=12;" vertex="1" parent="1"><mxGeometry x="658" y="482" width="564" height="135" as="geometry"/></mxCell><mxCell id="v15" value="«entity»&lt;br&gt;IDP" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;fontStyle=1;fontSize=17;" vertex="1" parent="1"><mxGeometry x="1353" y="182" width="574" height="60" as="geometry"/></mxCell><mxCell id="v16" value="-idpId: int&lt;br&gt;-designerId: int (owner)&lt;br&gt;-categoryId: int&lt;br&gt;-title: str&lt;br&gt;-description: str&lt;br&gt;-location: str&lt;br&gt;-projectType: str (Current / Past)&lt;br&gt;-status: str (Active / Suspended)&lt;br&gt;-createdDate: str" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="1353" y="242" width="574" height="232" as="geometry"/></mxCell><mxCell id="v17" value="+createPastIDP(idp): bool" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="1353" y="474" width="574" height="40" as="geometry"/></mxCell><mxCell id="v18" value="" style="rounded=0;html=1;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1353" y="182" width="574" height="332" as="geometry"/></mxCell><mxCell id="v19" value="«entity»&lt;br&gt;IDPCategory" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;fontStyle=1;fontSize=17;" vertex="1" parent="1"><mxGeometry x="1353" y="554" width="574" height="60" as="geometry"/></mxCell><mxCell id="v20" value="+searchIDPCategories(keyword): list&lt;br&gt;+isActive(): bool" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="1353" y="614" width="574" height="64" as="geometry"/></mxCell><mxCell id="v21" value="" style="rounded=0;html=1;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1353" y="554" width="574" height="124" as="geometry"/></mxCell><mxCell id="v22" value="createPastIDP() inserts the IDP as Past and Active, but only if its category is still Active (it could have been suspended meanwhile, US44). Past IDPs use the same idp table as current ones." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;whiteSpace=wrap;spacing=12;" vertex="1" parent="1"><mxGeometry x="1353" y="718" width="574" height="93" as="geometry"/></mxCell><mxCell id="e23" value="calls" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.15;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;endArrow=open;endFill=0;strokeColor=#334155;dashed=0;fontSize=12;fontColor=#1e293b;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v6" target="v10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e24" value="uses" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.15;entryDx=0;entryDy=0;endArrow=open;endFill=0;strokeColor=#334155;dashed=1;fontSize=12;fontColor=#1e293b;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v10" target="v18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e25" value="calls" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.44999999999999996;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;endArrow=open;endFill=0;strokeColor=#334155;dashed=0;fontSize=12;fontColor=#1e293b;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v6" target="v13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e26" value="uses" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;endArrow=open;endFill=0;strokeColor=#334155;dashed=1;fontSize=12;fontColor=#1e293b;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v13" target="v21"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="d693396" name="6 Sequence Diagram"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1590" pageHeight="1774"