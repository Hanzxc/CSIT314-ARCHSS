iewPastIDPController: ViewPastIDPController" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="83" y="242" width="444" height="40" as="geometry"/></mxCell><mxCell id="v5" value="+openPastIDPs()&lt;br&gt;+displayPastIDPList(pastIDPs)&lt;br&gt;+displayEmptyMessage(msg)&lt;br&gt;+selectPastIDP(idpId)&lt;br&gt;+displayPastIDPDetails(idp)&lt;br&gt;+displayNotFoundMessage(msg)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="83" y="282" width="444" height="160" as="geometry"/></mxCell><mxCell id="v6" value="" style="rounded=0;html=1;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="83" y="182" width="444" height="260" as="geometry"/></mxCell><mxCell id="v7" value="The designer id is always session[&quot;userId&quot;], so a designer only sees their own past IDPs. The same page class also holds the US28 delete methods (see the US28 diagram)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;whiteSpace=wrap;spacing=12;" vertex="1" parent="1"><mxGeometry x="83" y="482" width="444" height="114" as="geometry"/></mxCell><mxCell id="v8" value="«control»&lt;br&gt;ViewPastIDPController" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;fontStyle=1;fontSize=17;" vertex="1" parent="1"><mxGeometry x="658" y="182" width="564" height="60" as="geometry"/></mxCell><mxCell id="v9" value="+getPastIDPs(designerId): list&lt;br&gt;+getPastIDPDetails(designerId, idpId): IDP" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="658" y="242" width="564" height="64" as="geometry"/></mxCell><mxCell id="v10" value="" style="rounded=0;html=1;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="658" y="182" width="564" height="124" as="geometry"/></mxCell><mxCell id="v11" value="The controller just asks the entity - no checks. Precondition: the designer is already logged in (UC13), so this use case doesn&#x27;t check the designer again - no InteriorDesignerLoginController (lecturer feedback, same as UC20)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;whiteSpace=wrap;spacing=12;" vertex="1" parent="1"><mxGeometry x="658" y="356" width="564" height="114" as="geometry"/></mxCell><mxCell id="v12" value="«entity»&lt;br&gt;IDP" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;fontStyle=1;fontSize=17;" vertex="1" parent="1"><mxGeometry x="1353" y="182" width="574" height="60" as="geometry"/></mxCell><mxCell id="v13" value="-idpId: int&lt;br&gt;-designerId: int (owner)&lt;br&gt;-categoryId: int&lt;br&gt;-title: str&lt;br&gt;-description: str&lt;br&gt;-location: str&lt;br&gt;-projectType: str (Current / Past)&lt;br&gt;-status: str (Active / Suspended)&lt;br&gt;-createdDate: str" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="1353" y="242" width="574" height="232" as="geometry"/></mxCell><mxCell id="v14" value="+findPastIDPsByDesignerId(designerId): list&lt;br&gt;+getPastIDPDetails(designerId, idpId): IDP" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strok