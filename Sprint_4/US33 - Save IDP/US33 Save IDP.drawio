ngTop=4;fontSize=15;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="83" y="242" width="444" height="40" as="geometry" /></mxCell><mxCell id="v5" value="+clickSave(idpId)&lt;br&gt;+displaySavedState(idpId, msg)&lt;br&gt;+displayErrorMessage(idpId, msg)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="83" y="282" width="444" height="90" as="geometry" /></mxCell><mxCell id="v6" value="" style="rounded=0;html=1;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="83" y="182" width="444" height="190" as="geometry" /></mxCell><mxCell id="v7" value="The Save button on the IDP details page. Showing the details is US32 (ViewIDPPage), so both results go back to /customer/idps/&amp;lt;idpId&amp;gt;?saved=1 with a message - US32 doesn't count that reload as a view. customerId is always session[&quot;userId&quot;]." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;whiteSpace=wrap;spacing=12;" vertex="1" parent="1"><mxGeometry x="83" y="412" width="444" height="136" as="geometry" /></mxCell><mxCell id="v8" value="«control»&lt;br&gt;SaveIDPController" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;fontStyle=1;fontSize=17;" vertex="1" parent="1"><mxGeometry x="658" y="182" width="564" height="60" as="geometry" /></mxCell><mxCell id="v9" value="+saveIDP(customerId, idpId): bool" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="658" y="242" width="564" height="40" as="geometry" /></mxCell><mxCell id="v10" value="" style="rounded=0;html=1;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="658" y="182" width="564" height="100" as="geometry" /></mxCell><mxCell id="v11" value="saveIDP() just calls SavedIDP.createSavedRecord() and returns saved - no checks. Precondition: logged in as a Customer (UC30). customerLoginRequired in app.py only sends someone with no session to /customer/login." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;whiteSpace=wrap;spacing=12;" vertex="1" parent="1"><mxGeometry x="658" y="332" width="564" height="114" as="geometry" /></mxCell><mxCell id="v12" value="«entity»&lt;br&gt;SavedIDP" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;fontStyle=1;fontSize=17;" vertex="1" parent="1"><mxGeometry x="1353" y="182" width="574" height="60" as="geometry" /></mxCell><mxCell id="v13" value="-savedId: int&lt;br&gt;-customerId: int&lt;br&gt;-idpId: int&lt;br&gt;-savedDate: str" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="1353" y="242" width="574" height="112" as="geometry" /></mxCell><mxCell id="v14" value="+createSavedRecord(customerId, idpId): bool" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="1353" y="354" width="574" height="40" as="geometry" /></mxCell><mxCell id="v15" value="" style="rounded=0;html=1;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1353" y="182" width="574" height="212" as="geometry" /></mxCell><mxCell id="v16" value="createSavedRecord() refuses duplicates (UNIQUE customerId + idpId) and IDPs customers can't see (deleted IDP or suspended category), so it returns False in those cases - there is no separate check first." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;whiteSpace=wrap;spacing=12;" vertex="1" parent="1"><mxGeometry x="1353" y="434" width="574" height="114" as="geometry" /></mxCell><mxCell id="e17" value="calls" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.15;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;endArrow=open;endFill=0;strokeColor=#334155;dashed=0;fontSize=12;fontColor=#1e293b;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v6" target="v10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e18" value="uses" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.15;entryDx=0;entryDy=0;endArrow=open;endFill=0;strokeColor=#334155;dashed=1;fontSize=12;fontColor=#1e293b;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v10" target="v15"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="d693396" name="6 Sequence Diagram"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1410" pageHeight="954" background="#ffffff"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="e9001" style="endArrow=none;endFill=0;html=1;rounded=0;strokeColor=#334155;strokeWidth=1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="210" as="sourcePoint" /><mxPoint x="110" y="854" as="targetPoint" /></mxGeometry></mxCell><mxCell id="e9002" style="endArrow=none;endFill=0;html=1;rounded=0;strokeColor=#334155;strokeWidth=1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="450" y="210" as="sourcePoint" /><mxPoint x="450" y="854" as="targetPoint" /></m