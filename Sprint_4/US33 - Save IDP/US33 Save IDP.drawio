ounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="630" y="125" width="620" height="466" as="geometry"/></mxCell><mxCell id="v5005" value="Entity" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1325" y="88" width="150" height="37" as="geometry"/></mxCell><mxCell id="v5006" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="1325" y="125" width="630" height="466" as="geometry"/></mxCell><mxCell id="v2" value="B-C-E Class Diagram - UC33 Save IDP (US33)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=29;fontStyle=1;fontColor=#1e293b;fontFamily=Helvetica;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="24" y="15" width="2000" height="43" as="geometry"/></mxCell><mxCell id="v3" value="«boundary»&lt;br&gt;IDPDetailsPage" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;fontStyle=1;fontSize=17;" vertex="1" parent="1"><mxGeometry x="83" y="182" width="444" height="60" as="geometry"/></mxCell><mxCell id="v4" value="-saveIDPController: SaveIDPController" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="83" y="242" width="444" height="40" as="geometry"/></mxCell><mxCell id="v5" value="+clickSave(idpId)&lt;br&gt;+displaySavedState(idpId, msg)&lt;br&gt;+displayAlreadySavedMessage(idpId, msg)&lt;br&gt;+displayErrorMessage(idpId, msg)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="83" y="282" width="444" height="112" as="geometry"/></mxCell><mxCell id="v6" value="" style="rounded=0;html=1;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="83" y="182" width="444" height="212" as="geometry"/></mxCell><mxCell id="v7" value="The Save button on the IDP details page. Showing the details is US32 (ViewIDPPage), so every result goes back to that page with a message. The customer is always session[&quot;userId&quot;]." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;whiteSpace=wrap;spacing=12;" vertex="1" parent="1"><mxGeometry x="83" y="434" width="444" height="114" as="geometry"/></mxCell><mxCell id="v8" value="«control»&lt;br&gt;SaveIDPController" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;fontStyle=1;fontSize=17;" vertex="1" parent="1"><mxGeometry x="658" y="182" width="564" height="60" as="geometry"/></mxCell><mxCell id="v9" value="+checkAlreadySaved(customerId, idpId): bool&lt;br&gt;+saveIDP(customerId, idpId): bool" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="658" y="242" width="564" height="64" as="geometry"/></mxCell><mxCell id="v10" value="" style="rounded=0;html=1;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="658" y="182" width="564" height="124" as="geometry"/></mxCell><mxCell id="v11" value="The controller just calls the entity. Precondition: the customer is already logged in (UC30), so this use case doesn&#x27;t check the customer again - no CustomerLoginController (lecturer feedback, same as UC20)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;whiteSpace=wrap;spacing=12;" vertex="1" parent="1"><mxGeometry x="658" y="356" width="564" height="114" as="geometry"/></mxCell><mxCell id="v12" value="«entity»&lt;br&gt;SavedIDP" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;fontStyle=1;fontSize=17;" vertex="1" parent="1"><mxGeometry x="1353" y="182" width="574" height="60" as="geometry"/></mxCell><mxCell id="v13" value="-savedId: int&lt;br&gt;-customerId: int&lt;br&gt;-idpId: int&lt;br&gt;-savedDate: str" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="1353" y="242" width="574" height="112" as="geometry"/></mxCell><mxCell id="v14" value="+exists(customerId, idpId): bool&lt;br&gt;+createSavedRecord(customerId, idpId): bool" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="1353" y="354" width="574" height="64" as="geometry"/></mxCell><mxCell id="v15" value="" style="rounded=0;html=1;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1353" y="182" width="574" height="236" as="geometry"/></mxCell><mxCell id="v16" value="createSavedRecord() refuses duplicates (UNIQUE customerId + idpId) and IDPs customers can&#x27;t see (deleted IDP or suspended category), so it returns False in those cases." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#334155;align=left;vertical