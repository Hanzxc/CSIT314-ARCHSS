><mxGeometry relative="1" as="geometry"><mxPoint x="443" y="578" as="sourcePoint" /><mxPoint x="110" y="578" as="targetPoint" /></mxGeometry></mxCell><mxCell id="v37" value="7: HTTP 302 -&amp;gt; /customer/idps/&amp;lt;idpId&amp;gt;?saved=1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontStyle=0;fontColor=#1e293b;fontFamily=Helvetica;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="122" y="556" width="560" height="20" as="geometry" /></mxCell><mxCell id="e38" style="endArrow=open;endFill=0;html=1;rounded=0;strokeColor=#334155;strokeWidth=1;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="457" y="674" as="sourcePoint" /><mxPoint x="457" y="696" as="targetPoint" /><Array as="points"><mxPoint x="489" y="674" /><mxPoint x="489" y="696" /></Array></mxGeometry></mxCell><mxCell id="v39" value="8: displayErrorMessage(idpId, MSG_NOT_SAVED)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontStyle=0;fontColor=#1e293b;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="497" y="672" width="560" height="40" as="geometry" /></mxCell><mxCell id="e40" style="endArrow=open;endFill=0;html=1;rounded=0;strokeColor=#334155;strokeWidth=1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="443" y="726" as="sourcePoint" /><mxPoint x="110" y="726" as="targetPoint" /></mxGeometry></mxCell><mxCell id="v41" value="9: HTTP 302 -&amp;gt; /customer/idps/&amp;lt;idpId&amp;gt;?saved=1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontStyle=0;fontColor=#1e293b;fontFamily=Helvetica;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="122" y="704" width="560" height="20" as="geometry" /></mxCell><mxCell id="v42" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="40" y="466" width="1330" height="300" as="geometry" /></mxCell><mxCell id="v43" value="alt" style="shape=card;size=8;flipH=1;flipV=1;html=1;fillColor=#ffffff;strokeColor=#334155;fontSize=12;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="40" y="466" width="50" height="24" as="geometry" /></mxCell><mxCell id="v44" value="[saved == True]" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontStyle=1;fontColor=#1e293b;fontFamily=Helvetica;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="106" y="470" width="1250" height="22" as="geometry" /></mxCell><mxCell id="e45" style="endArrow=none;endFill=0;html=1;rounded=0;strokeColor=#334155;strokeWidth=1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="40" y="614" as="sourcePoint" /><mxPoint x="1370" y="614" as="targetPoint" /></mxGeometry></mxCell><mxCell id="v46" value="[saved == False]" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontStyle=1;fontColor=#1e293b;fontFamily=Helvetica;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="106" y="618" width="1250" height="22" as="geometry" /></mxCell><mxCell id="v52" value="Precondition: logged in as a Customer (UC30). customerLoginRequired in app.py only sends someone with no session to /customer/login. createSavedRecord() returns False when the IDP is already in the customer's saved list or customers can no longer see it (MSG_NOT_SAVED: &quot;This IDP is already in your saved list or is no longer available&quot;). Both results go back to /customer/idps/&amp;lt;idpId&amp;gt;?saved=1, which US32 shows without counting a view." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontStyle=0;fontColor=#1e293b;fontFamily=Helvetica;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="22" y="868" width="1370" height="60" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>