" height="382" as="geometry" /></mxCell><mxCell id="b3" value="«boundary»&lt;br&gt;&lt;b&gt;CreateUserProfilePage&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fontSize=11;fillColor=#E3F2FD;strokeColor=#1565C0;swimlaneFillColor=#FFFFFF;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="100" width="302" height="132" as="geometry" /></mxCell><mxCell id="b4" value="+clickCreateUserProfile()&lt;br&gt;+displayCreateForm(permissionList)&lt;br&gt;+submitUserProfile(profileName, description, permissions)&lt;br&gt;+validateInput(profile): boolean&lt;br&gt;+displaySuccessMessage(msg)&lt;br&gt;+displayErrorMessage(msg)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=nowrap;html=1;fontSize=11;fontColor=#000000;" vertex="1" parent="b3"><mxGeometry x="0" y="40" width="302" height="92" as="geometry" /></mxCell><mxCell id="b5" value="«control»&lt;br&gt;&lt;b&gt;CreateUserProfileController&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fontSize=11;fillColor=#FFF3E0;strokeColor=#E65100;swimlaneFillColor=#FFFFFF;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="482" y="100" width="231" height="76" as="geometry" /></mxCell><mxCell id="b6" value="+getAllPermissions(): List&amp;lt;String&amp;gt;&lt;br&gt;+createUserProfile(profile): boolean" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=nowrap;html=1;fontSize=11;fontColor=#000000;" vertex="1" parent="b5"><mxGeometry x="0" y="40" width="231" height="36" as="geometry" /></mxCell><mxCell id="b7" value="«entity»&lt;br&gt;&lt;b&gt;UserProfile&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fontSize=11;fillColor=#E8F5E9;strokeColor=#2E7D32;swimlaneFillColor=#FFFFFF;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="833" y="100" width="259" height="176" as="geometry" /></mxCell><mxCell id="b8" value="-profileId: int&lt;br&gt;-profileName: String&lt;br&gt;-description: String&lt;br&gt;-permissions: List&amp;lt;String&amp;gt;&lt;br&gt;-status: String" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=nowrap;html=1;fontSize=11;fontColor=#000000;" vertex="1" parent="b7"><mxGeometry x="0" y="40" width="259" height="78" as="geometry" /></mxCell><mxCell id="b9" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=#2E7D32;fontColor=#000000;" vertex="1" parent="b7"><mxGeometry x="0" y="118" width="259" height="8" as="geometry" /></mxCell><mxCell id="b10" value="+getAllPermissions(): List&amp;lt;String&amp;gt;&lt;br&gt;+isProfileNameTaken(profileName): boolean&lt;br&gt;+createUserProfile(profile): boolean" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=nowrap;html=1;fontSize=11;fontColor=#000000;" vertex="1" parent="b7"><mxGeometry x="0" y="126" width="259" height="50" as="geometry" /></mxCell><mxCell id="b11" value="submitUserProfile() trims the spaces and builds&lt;br&gt;profile = UserProfile(profileName, description,&lt;br&gt;permissions). validateInput(profile) checks the&lt;br&gt;name is 3-50 characters and at least one&lt;br&gt;permission is ticked.&lt;br&gt;&lt;br&gt;Precondition: logged in as a User Admin (UC1).&lt;br&gt;loginRequired in app.py only sends someone&lt;br&gt;with no session to /login." style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#FFF9C4;strokeColor=#B8A100;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=4;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="272" width="302" height="140" as="geometry" /></mxCell><mxCell id="b12" value="The controller just calls the entity and&lt;br&gt;returns the result - no checks of its own.&lt;br&gt;getAllPermissions() is US3&amp;#x27;s own form data&lt;br&gt;(the permission tick boxes)." style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#FFF9C4;strokeColor=#B8A100;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=4;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="482" y="216" width="231" height="70" as="geometry" /></mxCell><mxCell id="b13" value="createUserProfile() checks that no other profile&lt;br&gt;has this name (capitals don&amp;#x27;t matter), then saves&lt;br&gt;the new profile as &amp;quot;Active&amp;quot;. Name taken -&amp;gt; False." style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#FFF9C4;strokeColor=#B8A100;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=4;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="833" y="316" width="259" height="56" as="geometry" /></mxCell><mxCell id="b17" value="calls" style="endArrow=open;endFill=0;endSize=10;html=1;rounded=0;fontSize=10;fontColor=#000000;strokeColor=#000000;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b3" target="b5"><mxGeometr