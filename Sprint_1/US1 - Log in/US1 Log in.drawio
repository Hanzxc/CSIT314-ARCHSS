="c42" value="Log out is in the header on every page (see US2)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#212121;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="68" y="608" width="756" height="20" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="5 BCE Class Diagram" id="page-5"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1287" pageHeight="478" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="b14" value="&lt;b&gt;Boundary&lt;/b&gt;" style="shape=folder;tabWidth=80;tabHeight=20;tabPosition=left;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=0;fillColor=none;fontSize=12;strokeColor=#777777;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="300" height="398" as="geometry" /></mxCell><mxCell id="b15" value="&lt;b&gt;Control&lt;/b&gt;" style="shape=folder;tabWidth=80;tabHeight=20;tabPosition=left;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=0;fillColor=none;fontSize=12;strokeColor=#777777;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="420" y="50" width="322" height="398" as="geometry" /></mxCell><mxCell id="b16" value="&lt;b&gt;Entity&lt;/b&gt;" style="shape=folder;tabWidth=80;tabHeight=20;tabPosition=left;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=0;fillColor=none;fontSize=12;strokeColor=#777777;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="822" y="50" width="435" height="398" as="geometry" /></mxCell><mxCell id="b3" value="«boundary»&lt;br&gt;&lt;b&gt;LoginPage&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fontSize=11;fillColor=#E3F2FD;strokeColor=#1565C0;swimlaneFillColor=#FFFFFF;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="100" width="260" height="132" as="geometry" /></mxCell><mxCell id="b4" value="+openLoginPage()&lt;br&gt;+displayLoginForm()&lt;br&gt;+submitLogin(username, password)&lt;br&gt;+validateInput(username, password): boolean&lt;br&gt;+redirectToDashboard(account)&lt;br&gt;+displayErrorMessage(msg)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=nowrap;html=1;fontSize=11;fontColor=#000000;" vertex="1" parent="b3"><mxGeometry x="0" y="40" width="260" height="92" as="geometry" /></mxCell><mxCell id="b5" value="«control»&lt;br&gt;&lt;b&gt;LoginController&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fontSize=11;fillColor=#FFF3E0;strokeColor=#E65100;swimlaneFillColor=#FFFFFF;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="440" y="100" width="282" height="62" as="geometry" /></mxCell><mxCell id="b6" value="+login(username, password): UserAccount" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=nowrap;html=1;fontSize=11;fontColor=#000000;" vertex="1" parent="b5"><mxGeometry x="0" y="40" width="282" height="22" as="geometry" /></mxCell><mxCell id="b7" value="«entity»&lt;br&gt;&lt;b&gt;UserAccount&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fontSize=11;fillColor=#E8F5E9;strokeColor=#2E7D32;swimlaneFillColor=#FFFFFF;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="842" y="100" width="395" height="204" as="geometry" /></mxCell><mxCell id="b8" value="-userId: int&lt;br&gt;-username: String&lt;br&gt;-password: String&lt;br&gt;-fullName: String&lt;br&gt;-email: String&lt;br&gt;-phone: String&lt;br&gt;-profileId: int&lt;br&gt;-status: String&lt;br&gt;-createdDate: Date" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=nowrap;html=1;fontSize=11;fontColor=#000000;" vertex="1" parent="b7"><mxGeometry x="0" y="40" width="395" height="134" as="geometry" /></mxCell><mxCell id="b9" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=#2E7D32;fontColor=#000000;" vertex="1" parent="b7"><mxGeometry x="0" y="174" width="395" height="8" as="geometry" /></mxCell><mxCell id="b10" value="+verifyCredentials(username, password, requiredPermissions): UserAccount" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=nowrap;html=1;fontSize=11;fontColor=#000000;" vertex="1" parent="b7"><mxGeometry x="0" y="182" width="395" height="22" as="geometry" /></mxCell><mxCell id="b11" value="validateInput() checks that both fields are filled in.&lt;br&gt;The page trims the spaces from the username&lt;br&gt;before it calls login().&lt;br&gt;redirectToDashboard() starts a new session&lt;br&gt;(userId, profileId, username) and opens the&lt;br&gt;User Admin dashboard.&lt;br&gt;Precondition: the User Admin has a user&lt;br&gt;account and is not logged in." style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#FFF9C4;strokeColor=#B8A100;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=4;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="272" width="260" height="126" as="geometry" /></mxCell><mxCell id="b12" value="login() makes one call and returns the result:&lt;br&gt;UserAccount().verifyCredentials(username,&lt;br&gt;password, REQUIRED_ADMIN_PERMISSIONS)&lt;br&gt;REQUIRED_ADMIN_PERMISSIONS =&lt;br&gt;{&amp;quot;Manage user accounts&amp;quot;, &amp;quot;Manage user profiles&amp;quot;}&lt;br&gt;/login is shared by all four roles - app.py sends&lt;br&gt;the form here when &quot;Log in as&quot; is User Admin." style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#FFF9C4;strokeColor=#B8A100;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=4;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="440" y="202" width="282" height="112" as="geometry" /></mxCell><mxCell id="b13" value="verifyCredentials() returns the account only if the&lt;br&gt;password hash matches, the account is Active, its&lt;br&gt;user profile is Active and that profile has every&lt;br&gt;permission in requiredPermissions - otherwise None.&lt;br&gt;It reads the account&amp;#x27;s user_profile row itself." style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#FFF9C4;strokeColor=#B8A100;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=4;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="842" y="344" width="395" height="84" as="geometry" /></mxCell><mxCell id="b17" value="calls" style="endArrow=open;endFill=0;endSize=10;html=1;rounded=0;fontSize=10;fontColor=#000000;strokeColor=#000000;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b3" target="b5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="b18" value="uses" style="endArrow=open;endFill=0;dashed=1;html=1;rounded=0;fontSize=10;fontColor=#000000;strokeColor=#000000;labelBackgroundCo