, app.py's login()&lt;br&gt;route hands the form to LoginPage (the other roles: UC13, UC30, UC39)." style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#FFF9C4;strokeColor=#B8A100;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=4;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="42" width="470" height="42" as="geometry" /></mxCell><mxCell id="s10" value="the page trims the spaces from the username" style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#FFF9C4;strokeColor=#B8A100;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=4;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="345" y="380" width="243" height="28" as="geometry" /></mxCell><mxCell id="s13" value="returns the account only if the password is&lt;br&gt;right, the account is Active, its profile is&lt;br&gt;Active and the profile has both User Admin&lt;br&gt;permissions - otherwise None" style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#FFF9C4;strokeColor=#B8A100;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=4;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1105" y="492" width="228" height="70" as="geometry" /></mxCell><mxCell id="s18" value="starts a new session (userId, profileId, username)" style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#FFF9C4;strokeColor=#B8A100;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=4;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="375" y="704" width="264" height="28" as="geometry" /></mxCell><mxCell id="s6" value="2: displayLoginForm()" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=nowrap;fontSize=11;fontColor=#000000;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="371" y="221" width="118" height="18" as="geometry" /></mxCell><mxCell id="s9" value="4: validateInput(username, password)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=nowrap;fontSize=11;fontColor=#000000;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="371" y="299" width="196" height="18" as="geometry" /></mxCell><mxCell id="s17" value="9: redirectToDashboard(account)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=nowrap;fontSize=11;fontColor=#000000;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="371" y="677" width="175" height="18" as="geometry" /></mxCell><mxCell id="s21" value="11: displayErrorMessage(&quot;Invalid login details or account suspended&quot;)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=nowrap;fontSize=11;fontColor=#000000;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="371" y="817" width="352" height="18" as="geometry" /></mxCell><mxCell id="s24" value="13: displayErrorMessage(&quot;Please enter your username and password&quot;)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=nowrap;fontSize=11;fontColor=#000000;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="371" y="945" width="360" height="18" as="geometry" /></mxCell><mxCell id="s34" value="[input is valid]" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=11;fontStyle=1;fontColor=#000000;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="82" y="347" width="88" height="20" as="geometry" /></mxCell><mxCell id="s35" value="[input is invalid]" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=11;fontStyle=1;fontColor=#000000;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="38" y="913" width="98" height="20" as="geometry" /></mxCell><mxCell id="s38" value="[account != None]" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=11;fontStyle=1;fontColor=#000000;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="97" y="645" width="107" height="20" as="geometry" /></mxCell><mxCell id="s39" value="[account == None]" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=11;fontStyle=1;fontColor=#000000;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="53" y="785" width="109" height="20" as="geometry" /></mxCell><mxCell id="s2" value="&lt;b&gt;Sequence Diagram - UC1 Log in (US1)&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=15;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="278" height="24" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>