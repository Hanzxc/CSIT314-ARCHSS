 math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="bk1" value="&lt;b&gt;B-C-E Class Diagram - UC8 Create user account (US8)&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=15;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="389.982" height="24" as="geometry" /></mxCell><mxCell id="bk2" value="&lt;b&gt;Boundary&lt;/b&gt;" style="shape=folder;tabWidth=80;tabHeight=20;tabPosition=left;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=0;fillColor=none;fontSize=12;strokeColor=#777777;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="484" height="702" as="geometry" /></mxCell><mxCell id="bk3" value="&lt;b&gt;Control&lt;/b&gt;" style="shape=folder;tabWidth=80;tabHeight=20;tabPosition=left;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=0;fillColor=none;fontSize=12;strokeColor=#777777;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="604" y="50" width="361.2" height="702" as="geometry" /></mxCell><mxCell id="bk4" value="&lt;b&gt;Entity&lt;/b&gt;" style="shape=folder;tabWidth=80;tabHeight=20;tabPosition=left;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=0;fillColor=none;fontSize=12;strokeColor=#777777;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1045.2" y="50" width="350" height="702" as="geometry" /></mxCell><mxCell id="b1" value="«boundary»&lt;br&gt;&lt;b&gt;CreateUserAccountPage&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fontSize=11;fillColor=#E3F2FD;strokeColor=#1565C0;swimlaneFillColor=#FFFFFF;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="100" width="444" height="138" as="geometry" /></mxCell><mxCell id="b2" value="+clickCreateUserAccount()&lt;br&gt;+displayCreateForm(profiles)&lt;br&gt;+submitCreateAccount(username, password, fullName, email, phone, profileId)&lt;br&gt;+validateInput(account): boolean&lt;br&gt;+displaySuccessMessage(msg)&lt;br&gt;+displayErrorMessage(msg)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=nowrap;html=1;fontSize=11;fontColor=#000000;" vertex="1" parent="b1"><mxGeometry x="0" y="40" width="444" height="98" as="geometry" /></mxCell><mxCell id="b3" value="The page loads the profile drop-down first (US7's controller,&lt;br&gt;empty keyword), then shows the form.&lt;br&gt;On submit it trims the input (not the password) and builds&lt;br&gt;account = UserAccount(username, password, fullName, email,&lt;br&gt;phone, profileId). validateInput(account) checks the required&lt;br&gt;fields (username, password, full name, user profile)." style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#FFF9C4;strokeColor=#B8A100;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=4;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="298" width="444" height="98" as="geometry" /></mxCell><mxCell id="b4" value="«control»&lt;br&gt;&lt;b&gt;CreateUserAccountController&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fontSize=11;fillColor=#FFF3E0;strokeColor=#E65100;swimlaneFillColor=#FFFFFF;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="624" y="100" width="321.2" height="68" as="geometry" /></mxCell><mxCell id="b5" value="+createUserAccount(account): boolean" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=nowrap;html=1;fontSize=11;fontColor=#000000;" vertex="1" parent="b4"><mxGeometry x="0" y="40" width="321.2" height="28" as="geometry" /></mxCell><mxCell id="b6" value="«control» (from US7)&lt;br&gt;&lt;b&gt;SearchUserProfileController&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fontSize=11;fillColor=#FFF3E0;strokeColor=#E65100;swimlaneFillColor=#FFFFFF;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="624" y="228" width="321.2" height="68" as="geometry" /></mxCell><mxCell id="b7" value="+searchUserProfiles(keyword): List&amp;lt;UserProfile&amp;gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=nowrap;html=1;fontSize=11;fontColor=#000000;" vertex="1" parent="b6"><mxGeometry x="0" y="40" width="321.2" height="28" as="geometry" /></mxCell><mxCell id="b8" value="The controller just calls the entity and returns the&lt;br&gt;result - no checks.&lt;br&gt;The drop-down list comes from US7's controller&lt;br&gt;(search with an empty keyword).&lt;br&gt;Precondition: logged in as a User Admin (UC1).&lt;br&gt;loginRequired in app.py only sends someone with&lt;br&gt;no session to /login." style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#FFF9C4;strokeColor=#B8A100;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=4;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="624" y="356" width="321.2" height="112" as="geometry" /></mxCell><mxCell id="b9" value="«entity»&lt;br&gt;&lt;b&gt;UserAccount&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resiz