" height="454" as="geometry" /></mxCell><mxCell id="bk3" value="&lt;b&gt;Control&lt;/b&gt;" style="shape=folder;tabWidth=80;tabHeight=20;tabPosition=left;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=0;fillColor=none;fontSize=12;strokeColor=#777777;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="442" y="50" width="355.6" height="454" as="geometry" /></mxCell><mxCell id="bk4" value="&lt;b&gt;Entity&lt;/b&gt;" style="shape=folder;tabWidth=80;tabHeight=20;tabPosition=left;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=0;fillColor=none;fontSize=12;strokeColor=#777777;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="877.6" y="50" width="350" height="454" as="geometry" /></mxCell><mxCell id="b1" value="«boundary»&lt;br&gt;&lt;b&gt;SuspendUserAccountPage&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fontSize=11;fillColor=#E3F2FD;strokeColor=#1565C0;swimlaneFillColor=#FFFFFF;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="100" width="282" height="152" as="geometry" /></mxCell><mxCell id="b2" value="+clickSuspend(userId)&lt;br&gt;+displayConfirmation(account)&lt;br&gt;+confirmSuspend()&lt;br&gt;+cancelSuspend()&lt;br&gt;+closeConfirmation()&lt;br&gt;+displaySuccessMessage(msg)&lt;br&gt;+displayErrorMessage(msg)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=nowrap;html=1;fontSize=11;fontColor=#000000;" vertex="1" parent="b1"><mxGeometry x="0" y="40" width="282" height="112" as="geometry" /></mxCell><mxCell id="b3" value="clickSuspend() gets the account through US9's&lt;br&gt;controller for the confirmation box.&lt;br&gt;confirmSuspend() checks the User Admin isn't&lt;br&gt;suspending their own account&lt;br&gt;[userId != session userId] before it calls&lt;br&gt;the controller." style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#FFF9C4;strokeColor=#B8A100;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=4;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="312" width="282" height="98" as="geometry" /></mxCell><mxCell id="b4" value="«control»&lt;br&gt;&lt;b&gt;SuspendUserAccountController&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fontSize=11;fillColor=#FFF3E0;strokeColor=#E65100;swimlaneFillColor=#FFFFFF;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="462" y="100" width="315.6" height="68" as="geometry" /></mxCell><mxCell id="b5" value="+suspendUserAccount(userId): boolean" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=nowrap;html=1;fontSize=11;fontColor=#000000;" vertex="1" parent="b4"><mxGeometry x="0" y="40" width="315.6" height="28" as="geometry" /></mxCell><mxCell id="b6" value="«control» (from US9)&lt;br&gt;&lt;b&gt;ViewUserAccountController&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fontSize=11;fillColor=#FFF3E0;strokeColor=#E65100;swimlaneFillColor=#FFFFFF;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="462" y="228" width="315.6" height="68" as="geometry" /></mxCell><mxCell id="b7" value="+viewUserAccount(userId): UserAccount" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=nowrap;html=1;fontSize=11;fontColor=#000000;" vertex="1" parent="b6"><mxGeometry x="0" y="40" width="315.6" height="28" as="geometry" /></mxCell><mxCell id="b8" value="The controller just calls the entity and returns&lt;br&gt;the result - no checks.&lt;br&gt;The account in the box comes from US9's controller.&lt;br&gt;Precondition: logged in as a User Admin (UC1).&lt;br&gt;loginRequired in app.py only sends someone with&lt;br&gt;no session to /login." style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#FFF9C4;strokeColor=#B8A100;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=4;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="462" y="356" width="315.6" height="98" as="geometry" /></mxCell><mxCell id="b9" value="«entity»&lt;br&gt;&lt;b&gt;UserAccount&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fontSize=11;fillColor=#E8F5E9;strokeColor=#2E7D32;swimlaneFillColor=#FFFFFF;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="897.6" y="100" width="310" height="230" as="geometry" /></mxCell><mxCell id="b10" value="-userId: int&lt;br&gt;-username: String&lt;br&gt;-password: String&lt;br&gt;-fullName: String&lt;br&gt;-email: String&lt;br&gt;-phone: String&lt;br&gt;-profileId: int&lt;br&gt;-status: String&lt;br&gt;-createdDate: Date" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=nowrap;html=1;fontSize=11;fontColor=#000000;" vertex="1" parent="b9"><mxGeometry x="0" y="40" width="310" height="140" as="geometry" /></mxCell><mxCell id="b11" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=#2E7D32;fontColor=#000000;" vertex="1" parent="b9"><mxGeometry x="0" y="180" width="310" height="8" as="geometry" /></mxCell><mxCell id="b12" value="+getUserAccount(userId): UserAccount&lt;br&gt;+suspendUserAccount(userId): boolean" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=nowrap;html=1;fontSize=11;fontColor=#000000;" vertex="1" parent="b9"><mxGeometry x="0" y="188" width="310" height="42" as="geometry" /></mxCell><mxCell id="b13" value="suspendUserAccount() only changes an Active&lt;br&gt;account to &quot;Suspended&quot; (already suspended or&lt;br&gt;no such id gives back False). Nothing is deleted.&lt;br&gt;Log in (UC1, UserAccount.verifyCredentials) only&lt;br&gt;lets Active accounts in, so the user can't log in." style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#FFF9C4;strokeColor=#B8A100;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=4;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="897.6" y="390" width="310" height="84" as="geometry" /></mxCell><mxCell id="b14" value="calls" style="endArrow=open;endFill=0;endSize=10;html=1;rounded=0;fontSize=10;fontColor=#000000;strokeColor=#000000;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="b1" target="b4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="b15" value="calls (confirmation box)" style="endArrow=open;endFill=0;endSize=10;html=1;rounded=0;fontSize=10;fontColor=#000000;strokeColor=#000000;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="b1" target="b6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="b16" value="uses" style="endArrow=open;endFill=0;dashed=1;html=1;rounded=0;fontSize=10;fontColor=#000000;strokeColor=#000000;labelBackgroundColor=#FFFFFF;" edge="1" 