gn=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fontSize=11;fillColor=#E8F5E9;strokeColor=#2E7D32;swimlaneFillColor=#FFFFFF;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="769" y="100" width="267" height="162" as="geometry" /></mxCell><mxCell id="b10" value="-profileId: int&lt;br&gt;-profileName: String&lt;br&gt;-description: String&lt;br&gt;-permissions: List&amp;lt;String&amp;gt;&lt;br&gt;-status: String" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=nowrap;html=1;fontSize=11;fontColor=#000000;" vertex="1" parent="b9"><mxGeometry x="0" y="40" width="267" height="78" as="geometry" /></mxCell><mxCell id="b11" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=#2E7D32;fontColor=#000000;" vertex="1" parent="b9"><mxGeometry x="0" y="118" width="267" height="8" as="geometry" /></mxCell><mxCell id="b12" value="+getUserProfile(profileId): UserProfile&lt;br&gt;+suspendUserProfile(profileId): boolean" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=nowrap;html=1;fontSize=11;fontColor=#000000;" vertex="1" parent="b9"><mxGeometry x="0" y="126" width="267" height="36" as="geometry" /></mxCell><mxCell id="b17" value="clickSuspend() loads the profile for the&lt;br&gt;&amp;quot;Are you sure?&amp;quot; box with US4&amp;#x27;s controller.&lt;br&gt;confirmSuspend() checks the admin isn&amp;#x27;t&lt;br&gt;suspending their own group before it calls&lt;br&gt;the controller: [profileId != session profileId].&lt;br&gt;&lt;br&gt;Precondition: logged in as a User Admin (UC1).&lt;br&gt;loginRequired in app.py only sends someone&lt;br&gt;with no session to /login." style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#FFF9C4;strokeColor=#B8A100;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=4;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="286" width="251" height="140" as="geometry" /></mxCell><mxCell id="b18" value="The controller just calls the entity and&lt;br&gt;returns the result - no checks of its own.&lt;br&gt;The confirmation box shows the profile&lt;br&gt;through US4&amp;#x27;s controller (borrowed)." style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#FFF9C4;strokeColor=#B8A100;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=4;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="431" y="324" width="218" height="70" as="geometry" /></mxCell><mxCell id="b19" value="suspendUserProfile() only changes an Active&lt;br&gt;profile (already suspended or no such id -&amp;gt; False).&lt;br&gt;The group's users can't log in any more because&lt;br&gt;US1's UserAccount.verifyCredentials() only&lt;br&gt;accepts an account whose profile is Active." style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#FFF9C4;strokeColor=#B8A100;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=4;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="769" y="362" width="267" height="84" as="geometry" /></mxCell><mxCell id="b23" value="calls" style="endArrow=open;endFill=0;endSize=10;html=1;rounded=0;fontSize=10;fontColor=#000000;strokeColor=#000000;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b3" target="b5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="b24" value="calls (confirmation box)" style="endArrow=open;endFill=0;endSize=10;html=1;rounded=0;fon