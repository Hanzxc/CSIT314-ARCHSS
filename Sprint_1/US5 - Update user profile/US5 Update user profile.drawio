height="424" as="geometry" /></mxCell><mxCell id="b17" value="&lt;b&gt;Control&lt;/b&gt;" style="shape=folder;tabWidth=80;tabHeight=20;tabPosition=left;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=0;fillColor=none;fontSize=12;strokeColor=#777777;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="463" y="50" width="308" height="424" as="geometry" /></mxCell><mxCell id="b18" value="&lt;b&gt;Entity&lt;/b&gt;" style="shape=folder;tabWidth=80;tabHeight=20;tabPosition=left;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=0;fillColor=none;fontSize=12;strokeColor=#777777;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="851" y="50" width="323" height="424" as="geometry" /></mxCell><mxCell id="b3" value="«boundary»&lt;br&gt;&lt;b&gt;UpdateUserProfilePage&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fontSize=11;fillColor=#E3F2FD;strokeColor=#1565C0;swimlaneFillColor=#FFFFFF;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="100" width="283" height="146" as="geometry" /></mxCell><mxCell id="b4" value="+clickUpdate(profileId)&lt;br&gt;+displayUpdateForm(profile, permissionList)&lt;br&gt;+submitUpdate(profileName, description, permissions)&lt;br&gt;+validateInput(profile): boolean&lt;br&gt;+displaySuccessMessage(msg)&lt;br&gt;+displayErrorMessage(msg)&lt;br&gt;+displayNotFound()" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=nowrap;html=1;fontSize=11;fontColor=#000000;" vertex="1" parent="b3"><mxGeometry x="0" y="40" width="283" height="106" as="geometry" /></mxCell><mxCell id="b5" value="«control»&lt;br&gt;&lt;b&gt;UpdateUserProfileController&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fontSize=11;fillColor=#FFF3E0;strokeColor=#E65100;swimlaneFillColor=#FFFFFF;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="483" y="100" width="268" height="76" as="geometry" /></mxCell><mxCell id="b6" value="+getUserProfile(profileId): UserProfile&lt;br&gt;+updateUserProfile(profile): boolean" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=nowrap;html=1;fontSize=11;fontColor=#000000;" vertex="1" parent="b5"><mxGeometry x="0" y="40" width="268" height="36" as="geometry" /></mxCell><mxCell id="b7" value="«control» (from US3)&lt;br&gt;&lt;b&gt;CreateUserProfileController&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fontSize=11;fillColor=#FFF3E0;strokeColor=#E65100;swimlaneFillColor=#FFFFFF;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="483" y="236" width="268" height="62" as="geometry" /></mxCell><mxCell id="b8" value="+getAllPermissions(): List&amp;lt;String&amp;gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=nowrap;html=1;fontSize=11;fontColor=#000000;" vertex="1" parent="b7"><mxGeometry x="0" y="40" width="268" height="22" as="geometry" /></mxCell><mxCell id="b9" value="«entity»&lt;br&gt;&lt;b&gt;UserProfile&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fontSize=11;fillColor=#E8F5E9;strokeColor=#2E7D32;swimlaneFillColor=#FFFFFF;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="871" y="100" width="283" height="190" as="geometry" /></mxCell><mxCell id="b10" value="-profileId: int&lt;br&gt;-profileName: String&lt;br&gt;-description: String&lt;br&gt;-permissions: List&amp;lt;String&amp;gt;&lt;br&gt;-status: String" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=nowrap;html=1;fontSize=11;fontColor=#000000;" vertex="1" parent="b9"><mxGeometry x="0" y="40" width="283" height="78" as="geometry" /></mxCell><mxCell id="b11" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=#2E7D32;fontColor=#000000;" vertex="1" parent="b9"><mxGeometry x="0" y="118" width="283" height="8" as="geometry" /></mxCell><mxCell id="b12" value="+getUserProfile(profileId): UserProfile&lt;br&gt;+getAllPermissions(): List&amp;lt;String&amp;gt;&lt;br&gt;+isProfileNameTaken(profileName, profileId): boolean&lt;br&gt;+updateUserProfile(profile): boolean" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=nowrap;html=1;fontSize=11;fontColor=#000000;" vertex="1" parent="b9"><mxGeometry x="0" y="126" width="283" height="64" as="geometry" /></mxCell><mxCell id="b13" value="submitUpdate() trims the spaces and builds&lt;br&gt;profile = UserProfile(profileId, profileName,&lt;br&gt;description, permissions). validateInput(profile)&lt;br&gt;checks the name is 3-50 characters and at least&lt;br&gt;one permission is ticked.&lt;br&gt;displayNotFound() shows &amp;quot;User profile not found&amp;quot;&lt;br&gt;when there is no profile with this id.&lt;br&gt;&lt;br&gt;Precondition: logged in as a User Admin (UC1).&lt;br&gt;loginRequired in app.py only sends someone&lt;br&gt;with no session to /login." style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#FFF9C4;strokeColor=#B8A100;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=4;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="286" width="283" height="168" as="geometry" /></mxCell><mxCell id="b14" value="The controller just calls the entity and returns&lt;br&gt;the result - no checks of its own. getUserProfile()&lt;br&gt;loads the form (US5&amp;#x27;s own loader). The permission&lt;br&gt;tick boxes are US3&amp;#x27;s form data, so the page&lt;br&gt;borrows US3&amp;#x27;s controller for them." style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#FFF9C4;strokeColor=#B8A100;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=4;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="483" y="338" width="268" height="84" as="geometry" /></mxCell><mxCell id="b15" value="updateUserProfile() only changes a profile that is&lt;br&gt;Active and whose new name isn&amp;#x27;t used by a different&lt;br&gt;profile (capitals don&amp;#x27;t matter). Suspended, missing&lt;br&gt;or name taken -&amp;gt; False. The status is never changed." style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#FFF9C4;strokeColor=#B8A100;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=4;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="871" y="330" width="283" height="70" as="geometry" /></mxCell><mxCell id="b19" value="calls" style="endArrow=open;endFill=0;endSize=10;html=1;rounded=0;fontSize=10;fontColor=#000000;strokeColor=#000000;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b3" target="b5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b20" value="calls (permission tick boxes)" style="endArrow=open;endFill=0;endSize=10;html=1;rounded=0;fontSize=10;fontColor=#000000;strokeColor=#000000;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b3" target="b7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b21" value="uses" style="endArrow=open;endFill=0;dashed=1;html=1;rounded=0;fontSize=10;fontColor=#000000;strokeColor=#000000;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.2;entryDx=0;entryDy=0;" edge="1" parent="1" source="b5" target="b9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b22" value="uses" style="endArrow=open;endFill=0;dashed=1;html=1;rounded=0;fontSize=10;fontColor=#000000;strokeColor=#000000;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="1" source="b7" target="b9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b2" value="&lt;b&gt;B-C-E Class Diagram - UC5 Update user profile (US5)&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=15;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="384" height="24" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="6 Sequence Diagram" id="page-7"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1820" pageHeight="1730" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="s42" value="User Admin" style="shape=umlLifeline;participant=umlActor;perimeter=lifelinePerimeter;whiteSpace=nowrap;html=1;container=0;collapsible=0;recursiveResize=0;verticalAlign=top;spacingTop=40;outlineConnect=