  <diagram name="5 BCE Class Diagram" id="5"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageWidth="2100" pageHeight="896"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" value="B-C-E Class Diagram - UC30 Customer log in (US30)" style="text;html=0;align=left;verticalAlign=top;fontSize=29;fontStyle=1;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="24" y="15" width="2000" height="43" as="geometry" /></mxCell><mxCell id="3" value="" style="rounded=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="55" y="125" width="500" height="731" as="geometry" /></mxCell><mxCell id="4" value="" style="rounded=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="55" y="88" width="152" height="37" as="geometry" /></mxCell><mxCell id="5" value="Boundary" style="text;html=0;align=left;verticalAlign=top;fontSize=15;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="65" y="100" width="136" height="22" as="geometry" /></mxCell><mxCell id="6" value="" style="rounded=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="630" y="125" width="620" height="731" as="geometry" /></mxCell><mxCell id="7" value="" style="rounded=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="630" y="88" width="152" height="37" as="geometry" /></mxCell><mxCell id="8" value="Control" style="text;html=0;align=left;verticalAlign=top;fontSize=15;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="640" y="100" width="136" height="22" as="geometry" /></mxCell><mxCell id="9" value="" style="rounded=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="1325" y="125" width="630" height="731" as="geometry" /></mxCell><mxCell id="10" value="" style="rounded=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="1325" y="88" width="152" height="37" as="geometry" /></mxCell><mxCell id="11" value="Entity" style="text;html=0;align=left;verticalAlign=top;fontSize=15;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="1335" y="100" width="136" height="22" as="geometry" /></mxCell><mxCell id="12" value="" style="rounded=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="83" y="182" width="444" height="274" as="geometry" /></mxCell><mxCell id="13" value="" style="rounded=0;whiteSpace=wrap;fillColor=#e3f2fd;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="83" y="182" width="444" height="70" as="geometry" /></mxCell><mxCell id="14" value="«boundary»&#10;CustomerLoginPage" style="text;html=0;align=left;verticalAlign=top;fontSize=19;fontStyle=1;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="97" y="190" width="416" height="56" as="geometry" /></mxCell><mxCell id="15" value="-customerLoginController: CustomerLoginController" style="text;html=0;align=left;verticalAlign=top;fontSize=16;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="96" y="262" width="416" height="22" as="geometry" /></mxCell><mxCell id="16" value="" style="endArrow=none;html=0;dashed=0;strokeColor=#334155;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="83" y="292" as="sourcePoint" /><mxPoint x="527" y="292" as="targetPoint" /></mxGeometry></mxCell><mxCell id="17" value="+openLoginPage()&#10;+displayLoginForm()&#10;+submitLogin(username, password)&#10;+validateInput(username, password): bool&#10;+redirectToDashboard(account)&#10;+displayErrorMessage(msg)&#10;+openDashboard()" style="text;html=0;align=left;verticalAlign=top;fontSize=16;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="96" y="302" width="416" height="142" as="geometry" /></mxCell><mxCell id="18" value="" style="rounded=0;whiteSpace=wrap;fillColor=#fff9c4;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="83" y="546" width="444" height="230" as="geometry" /></mxCell><mxCell id="19" value="validateInput() checks that both fields are&#10;filled in. The page trims the spaces from the&#10;username (not the password) before it calls&#10;login(). redirectToDashboard() starts a new&#10;session (userId, profileId, username).&#10;openDashboard() just renders the dashboard -&#10;it doesn't check the role again&#10;(customerLoginRequired in app.py only sends&#10;someone with no session to /customer/login)." style="text;html=0;align=left;verticalAlign=top;fontSize=17;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="101" y="559" width="408" height="208" as="geometry" /></mxCell><mxCell id="20" value="" style="rounded=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="658" y="182" width="564" height="115" as="geometry" /></mxCell><mxCell id="21" value="" style="rounded=0;whiteSpace=wrap;fillColor=#fff3e0;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="658" y="182" width="564" height="70" as="geometry" /></mxCell><mxCell id="22" value="«control»&#10;CustomerLoginController" style="text;html=0;align=left;verticalAlign=top;fontSize=19;fontStyle=1;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="672" y="190" width="536" height="56" as="geometry" /></mxCell><mxCell id="23" value="+login(username, password): UserAccount | None" style="text;html=0;align=left;verticalAlign=top;fontSize=16;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="671" y="262" width="536" height="23" as="geometry" /></mxCell><mxCell id="24" value="" style="rounded=0;whiteSpace=wrap;fillColor=#fff9c4;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="658" y="427" width="564" height="230" as="geometry" /></mxCell><mxCell id="25" value="login() makes one call and returns the result:&#10;UserAccount().verifyCredentials(username, password,&#10;REQUIRED_CUSTOMER_PERMISSIONS)&#10;REQUIRED_CUSTOMER_PERMISSIONS = {&quot;Search, view and save&#10;IDPs&quot;}&#10;It doesn't check the input again - the page already did.&#10;Precondition: the customer account exists and is not&#10;logged in. Checking the role here is allowed - logging in&#10;is the use case itself." style="text;html=0;align=left;verticalAlign=top;fontSize=17;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="676" y="440" width="528" height="208" as="geometry" /></mxCell><mxCell id="26" value="" style="rounded=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="1353" y="182" width="574" height="333" as="geometry" /></mxCell><mxCell id="27" value="" style="rounded=0;whiteSpace=wrap;fillColor=#e8f5e9;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="1353" y="182" width="574" height="70" as="geometry" /></mxCell><mxCell id="28" value="«entity»&#10;UserAccount" style="text;html=0;align=left;verticalAlign=top;fontSize=19;fontStyle=1;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="1367" y="190" width="546" height="56" as="geometry" /></mxCell><mxCell id="29" value="-userId: int&#10;-username: str&#10;-password: str (hash)&#10;-fullName: str&#10;-email: str&#10;-phone: str&#10;-profileId: int&#10;-status: str&#10;-createdDate: str" style="text;html=0;align=left;verticalAlign=top;fontSize=16;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="1366" y="262" width="546" height="180" as="geometry" /></mxCell><mxCell id="30" value="" style="endArrow=none;html=0;dashed=0;strokeColor=#334155;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1353" y="450" as="sourcePoint" /><mxPoint x="1927" y="450" as="targetPoint" /></mxGeometry></mxCell><mxCell id="31" value="+verifyCredentials(username, password,&#10;    requiredPermissions): UserAccount | None" style="text;html=0;align=left;verticalAlign=top;fontSize=16;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="1366" y="460" width="546" height="43" as="geometry" /></mxCell><mxCell id="32" value="" style="rounded=0;whiteSpace=wrap;fillColor=#fff9c4;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="1353" y="585" width="574" height="163" as="geometry" /></mxCell><mxCell id="33" value="verifyCredentials() returns the account only if the&#10;password hash matches, the account is Active, its user&#10;profile is Active and that profile has every permission in&#10;requiredPermissions - otherwise None. It reads the&#10;account's user_profile row itself, so UserProfile is not&#10;drawn." style="text;html=0;align=left;verticalAlign=top;fontSize=17;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="1371" y="598" width="538" height="141" as="geometry" /></mxCell><mxCell id="34" value="" style="endArrow=open;html=0;dashed=0;strokeColor=#334155;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="527" y="252" as="sourcePoint" /><mxPoint x="658" y="252" as="targetPoint" /></mxGeometry></mxCell><mxCell id="35" value="calls" style="text;html=0;align=left;verticalAlign=top;fontSize=12;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="531" y="230" width="40" height="20" as="geometry" /></mxCell><mxCell id="36" value="" style="endArrow=open;html=0;dashed=1;strokeColor=#334155;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1222" y="262" as="sourcePoint" /><mxPoint x="1353" y="262" as="targetPoint" /></mxGeometry></mxCell><mxCell id="37" value="uses" style="text;html=0;align=left;verticalAlign=top;fontSize=12;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="1226" y="240" width="40" height="20" as="geometry" /></mxCell></root></mxGraphModel></diagram>
