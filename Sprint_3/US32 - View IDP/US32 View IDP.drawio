  <diagram name="5 BCE Class Diagram" id="5"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageWidth="2100" pageHeight="921"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" value="B-C-E Class Diagram - UC32 View IDP (US32)" style="text;html=0;align=left;verticalAlign=top;fontSize=29;fontStyle=1;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="24" y="15" width="2000" height="43" as="geometry" /></mxCell><mxCell id="3" value="" style="rounded=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="55" y="125" width="500" height="756" as="geometry" /></mxCell><mxCell id="4" value="" style="rounded=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="55" y="88" width="152" height="37" as="geometry" /></mxCell><mxCell id="5" value="Boundary" style="text;html=0;align=left;verticalAlign=top;fontSize=15;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="65" y="100" width="136" height="22" as="geometry" /></mxCell><mxCell id="6" value="" style="rounded=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="630" y="125" width="620" height="756" as="geometry" /></mxCell><mxCell id="7" value="" style="rounded=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="630" y="88" width="152" height="37" as="geometry" /></mxCell><mxCell id="8" value="Control" style="text;html=0;align=left;verticalAlign=top;fontSize=15;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="640" y="100" width="136" height="22" as="geometry" /></mxCell><mxCell id="9" value="" style="rounded=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="1325" y="125" width="630" height="756" as="geometry" /></mxCell><mxCell id="10" value="" style="rounded=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="1325" y="88" width="152" height="37" as="geometry" /></mxCell><mxCell id="11" value="Entity" style="text;html=0;align=left;verticalAlign=top;fontSize=15;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="1335" y="100" width="136" height="22" as="geometry" /></mxCell><mxCell id="12" value="" style="rounded=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="83" y="182" width="444" height="214" as="geometry" /></mxCell><mxCell id="13" value="" style="rounded=0;whiteSpace=wrap;fillColor=#e3f2fd;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="83" y="182" width="444" height="70" as="geometry" /></mxCell><mxCell id="14" value="«boundary»&#10;ViewIDPPage" style="text;html=0;align=left;verticalAlign=top;fontSize=19;fontStyle=1;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="97" y="190" width="416" height="56" as="geometry" /></mxCell><mxCell id="15" value="-viewIDPController: ViewIDPController&#10;-keyword: str" style="text;html=0;align=left;verticalAlign=top;fontSize=16;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="96" y="262" width="416" height="42" as="geometry" /></mxCell><mxCell id="16" value="" style="endArrow=none;html=0;dashed=0;strokeColor=#334155;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="83" y="312" as="sourcePoint" /><mxPoint x="527" y="312" as="targetPoint" /></mxGeometry></mxCell><mxCell id="17" value="+selectIDP(idpId, keyword, saved=False)&#10;+displayIDP(idp, companyProfile)&#10;+displayNotFoundMessage()" style="text;html=0;align=left;verticalAlign=top;fontSize=16;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="96" y="322" width="416" height="62" as="geometry" /></mxCell><mxCell id="18" value="" style="rounded=0;whiteSpace=wrap;fillColor=#fff9c4;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="83" y="526" width="444" height="275" as="geometry" /></mxCell><mxCell id="19" value="selectIDP() trims the keyword (kept for Back&#10;to search) and sets countView = not saved.&#10;saved is True only when US33's Save sends the&#10;customer back to this page (?saved=1), so&#10;that reload isn't counted as a view. If the&#10;IDP is found, the page gets the designer's&#10;company profile through US15's controller.&#10;displayIDP() shows &quot;Designer information is&#10;not currently available.&quot; when companyProfile&#10;is None. The Save IDP button (US33) is always&#10;shown." style="text;html=0;align=left;verticalAlign=top;fontSize=17;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="101" y="539" width="408" height="253" as="geometry" /></mxCell><mxCell id="20" value="" style="rounded=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="658" y="182" width="564" height="115" as="geometry" /></mxCell><mxCell id="21" value="" style="rounded=0;whiteSpace=wrap;fillColor=#fff3e0;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="658" y="182" width="564" height="70" as="geometry" /></mxCell><mxCell id="22" value="«control»&#10;ViewIDPController" style="text;html=0;align=left;verticalAlign=top;fontSize=19;fontStyle=1;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="672" y="190" width="536" height="56" as="geometry" /></mxCell><mxCell id="23" value="+viewIDP(idpId, countView): IDP | None" style="text;html=0;align=left;verticalAlign=top;fontSize=16;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="671" y="262" width="536" height="23" as="geometry" /></mxCell><mxCell id="24" value="" style="rounded=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="658" y="367" width="564" height="115" as="geometry" /></mxCell><mxCell id="25" value="" style="rounded=0;whiteSpace=wrap;fillColor=#fff3e0;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="658" y="367" width="564" height="70" as="geometry" /></mxCell><mxCell id="26" value="«control» (from US15)&#10;ViewCompanyProfileController" style="text;html=0;align=left;verticalAlign=top;fontSize=19;fontStyle=1;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="672" y="375" width="536" height="56" as="geometry" /></mxCell><mxCell id="27" value="+viewCompanyProfile(designerId): CompanyProfile | None" style="text;html=0;align=left;verticalAlign=top;fontSize=16;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="671" y="447" width="536" height="23" as="geometry" /></mxCell><mxCell id="28" value="" style="rounded=0;whiteSpace=wrap;fillColor=#fff9c4;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="658" y="552" width="564" height="185" as="geometry" /></mxCell><mxCell id="29" value="The controller just calls the entity and returns the IDP&#10;(or None) - one call, no checks, no dict. Showing a&#10;designer's company profile is US15's job, so the page&#10;borrows that controller. Precondition: logged in as a&#10;Customer (UC30). customerLoginRequired in app.py only&#10;sends someone with no session to /customer/login. This use&#10;case doesn't check the customer again." style="text;html=0;align=left;verticalAlign=top;fontSize=17;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="676" y="565" width="528" height="163" as="geometry" /></mxCell><mxCell id="30" value="" style="rounded=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="1353" y="182" width="574" height="333" as="geometry" /></mxCell><mxCell id="31" value="" style="rounded=0;whiteSpace=wrap;fillColor=#e8f5e9;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="1353" y="182" width="574" height="70" as="geometry" /></mxCell><mxCell id="32" value="«entity»&#10;IDP" style="text;html=0;align=left;verticalAlign=top;fontSize=19;fontStyle=1;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="1367" y="190" width="546" height="56" as="geometry" /></mxCell><mxCell id="33" value="-idpId: int&#10;-designerId: int (owner)&#10;-categoryId: int&#10;-title: str&#10;-description: str&#10;-location: str&#10;-projectType: str (Current / Past)&#10;-status: str&#10;-createdDate: str&#10;-categoryName: str (joined, read only)" style="text;html=0;align=left;verticalAlign=top;fontSize=16;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="1366" y="262" width="546" height="200" as="geometry" /></mxCell><mxCell id="34" value="" style="endArrow=none;html=0;dashed=0;strokeColor=#334155;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1353" y="470" as="sourcePoint" /><mxPoint x="1927" y="470" as="targetPoint" /></mxGeometry></mxCell><mxCell id="35" value="+viewIDP(idpId, countView): IDP | None" style="text;html=0;align=left;verticalAlign=top;fontSize=16;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="1366" y="480" width="546" height="23" as="geometry" /></mxCell><mxCell id="36" value="" style="rounded=0;whiteSpace=wrap;fillColor=#fff9c4;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="1353" y="585" width="574" height="140" as="geometry" /></mxCell><mxCell id="37" value="viewIDP() returns the IDP only if it is Active and its&#10;category is Active (Current or Past, any designer) -&#10;otherwise None. When the IDP is found and countView is True&#10;it also inserts one idp_view row, which the view statistics&#10;count (US37, US46 - US48)." style="text;html=0;align=left;verticalAlign=top;fontSize=17;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="1371" y="598" width="538" height="118" as="geometry" /></mxCell><mxCell id="38" value="" style="endArrow=open;html=0;dashed=0;strokeColor=#334155;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="527" y="252" as="sourcePoint" /><mxPoint x="658" y="252" as="targetPoint" /></mxGeometry></mxCell><mxCell id="39" value="calls" style="text;html=0;align=left;verticalAlign=top;fontSize=12;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="531" y="230" width="40" height="20" as="geometry" /></mxCell><mxCell id="40" value="" style="endArrow=open;html=0;dashed=0;rounded=0;strokeColor=#334155;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="527" y="366" as="sourcePoint" /><mxPoint x="658" y="402" as="targetPoint" /><Array as="points"><mxPoint x="551" y="366" /><mxPoint x="551" y="402" /></Array></mxGeometry></mxCell><mxCell id="41" value="calls" style="text;html=0;align=left;verticalAlign=top;fontSize=12;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="557" y="344" width="40" height="20" as="geometry" /></mxCell><mxCell id="42" value="" style="endArrow=open;html=0;dashed=1;strokeColor=#334155;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1222" y="262" as="sourcePoint" /><mxPoint x="1353" y="262" as="targetPoint" /></mxGeometry></mxCell><mxCell id="43" value="uses" style="text;html=0;align=left;verticalAlign=top;fontSize=12;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="1226" y="240" width="40" height="20" as="geometry" /></mxCell></root></mxGraphModel></diagram>
