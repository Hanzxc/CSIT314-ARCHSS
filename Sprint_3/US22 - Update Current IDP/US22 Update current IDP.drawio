  <diagram name="5 BCE Class Diagram" id="5">
    <mxGraphModel page="1" pageWidth="2161" pageHeight="912" grid="1" gridSize="10">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" value="B-C-E Class Diagram - UC22 Update current IDP (US22)" style="text;html=0;align=left;verticalAlign=top;fontSize=29;fontStyle=1;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="24" y="15" width="2000" height="43" as="geometry" /></mxCell><mxCell id="3" value="" style="rounded=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="55" y="125" width="561" height="747" as="geometry" /></mxCell><mxCell id="4" value="" style="rounded=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="55" y="88" width="152" height="37" as="geometry" /></mxCell><mxCell id="5" value="Boundary" style="text;html=0;align=left;verticalAlign=top;fontSize=15;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="65" y="100" width="136" height="22" as="geometry" /></mxCell><mxCell id="6" value="" style="rounded=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="691" y="125" width="620" height="747" as="geometry" /></mxCell><mxCell id="7" value="" style="rounded=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="691" y="88" width="152" height="37" as="geometry" /></mxCell><mxCell id="8" value="Control" style="text;html=0;align=left;verticalAlign=top;fontSize=15;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="701" y="100" width="136" height="22" as="geometry" /></mxCell><mxCell id="9" value="" style="rounded=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="1386" y="125" width="630" height="747" as="geometry" /></mxCell><mxCell id="10" value="" style="rounded=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="1386" y="88" width="152" height="37" as="geometry" /></mxCell><mxCell id="11" value="Entity" style="text;html=0;align=left;verticalAlign=top;fontSize=15;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="1396" y="100" width="136" height="22" as="geometry" /></mxCell><mxCell id="12" value="" style="rounded=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="83" y="182" width="505" height="382" as="geometry" /></mxCell><mxCell id="13" value="" style="rounded=0;whiteSpace=wrap;fillColor=#e3f2fd;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="83" y="182" width="505" height="70" as="geometry" /></mxCell><mxCell id="14" value="«boundary»&#10;UpdateCurrentIDPPage" style="text;html=0;align=left;verticalAlign=top;fontSize=19;fontStyle=1;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="97" y="190" width="477" height="56" as="geometry" /></mxCell><mxCell id="15" value="-updateCurrentIDPController: UpdateCurrentIDPController&#10;-idpId: int&#10;-idp: IDP&#10;-fieldErrors: dict" style="text;html=0;align=left;verticalAlign=top;fontSize=16;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="96" y="262" width="477" height="92" as="geometry" /></mxCell><mxCell id="16" value="" style="endArrow=none;html=0;dashed=0;strokeColor=#334155;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="83" y="362" as="sourcePoint" /><mxPoint x="588" y="362" as="targetPoint" /></mxGeometry></mxCell><mxCell id="17" value="+clickUpdate(idpId)&#10;+displayUpdateForm(msg=None)&#10;+getAvailableCategories(): list&#10;+validateInput(idp): bool&#10;+submitUpdate(idpId, title, categoryId, description, location)&#10;+displaySuccessMessage(msg)&#10;+displayErrorMessage(msg)&#10;+displayNotFoundMessage()" style="text;html=0;align=left;verticalAlign=top;fontSize=16;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="96" y="372" width="477" height="180" as="geometry" /></mxCell><mxCell id="18" value="" style="rounded=0;whiteSpace=wrap;fillColor=#fff9c4;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="83" y="634" width="505" height="178" as="geometry" /></mxCell><mxCell id="19" value="submitUpdate() trims the input and builds&#10;idp = IDP(idpId, session userId, categoryId, title,&#10;description, location). validateInput(idp) checks&#10;every field rule (the same as US20) and that the&#10;category is one of the Active ones from&#10;getAvailableCategories()." style="text;html=0;align=left;verticalAlign=top;fontSize=17;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="101" y="652" width="469" height="142" as="geometry" /></mxCell><mxCell id="20" value="" style="rounded=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="719" y="182" width="564" height="140" as="geometry" /></mxCell><mxCell id="21" value="" style="rounded=0;whiteSpace=wrap;fillColor=#fff3e0;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="719" y="182" width="564" height="70" as="geometry" /></mxCell><mxCell id="22" value="«control»&#10;UpdateCurrentIDPController" style="text;html=0;align=left;verticalAlign=top;fontSize=19;fontStyle=1;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="733" y="190" width="536" height="56" as="geometry" /></mxCell><mxCell id="23" value="+getCurrentIDP(designerId, idpId): IDP | None&#10;+updateCurrentIDP(idp): bool" style="text;html=0;align=left;verticalAlign=top;fontSize=16;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="732" y="262" width="536" height="48" as="geometry" /></mxCell><mxCell id="24" value="" style="rounded=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="719" y="392" width="564" height="118" as="geometry" /></mxCell><mxCell id="25" value="" style="rounded=0;whiteSpace=wrap;fillColor=#fff3e0;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="719" y="392" width="564" height="70" as="geometry" /></mxCell><mxCell id="26" value="«control» (from US45)&#10;SearchIDPCategoryController" style="text;html=0;align=left;verticalAlign=top;fontSize=19;fontStyle=1;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="733" y="400" width="536" height="56" as="geometry" /></mxCell><mxCell id="27" value="+searchIDPCategories(keyword): list" style="text;html=0;align=left;verticalAlign=top;fontSize=16;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="732" y="472" width="536" height="26" as="geometry" /></mxCell><mxCell id="28" value="" style="rounded=0;whiteSpace=wrap;fillColor=#fff9c4;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="719" y="580" width="564" height="201" as="geometry" /></mxCell><mxCell id="29" value="The controller just calls the entity and returns the&#10;result - no checks. getCurrentIDP() is US22's own&#10;loader for the form. Listing the categories is US45's&#10;job, so the page borrows that control (empty keyword).&#10;Precondition: logged in as an interior designer&#10;(UC13). designerLoginRequired in app.py only&#10;sends someone with no session to /designer/login." style="text;html=0;align=left;verticalAlign=top;fontSize=17;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="737" y="598" width="528" height="165" as="geometry" /></mxCell><mxCell id="30" value="" style="rounded=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="1414" y="182" width="574" height="382" as="geometry" /></mxCell><mxCell id="31" value="" style="rounded=0;whiteSpace=wrap;fillColor=#e8f5e9;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="1414" y="182" width="574" height="70" as="geometry" /></mxCell><mxCell id="32" value="«entity»&#10;IDP" style="text;html=0;align=left;verticalAlign=top;fontSize=19;fontStyle=1;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="1428" y="190" width="546" height="56" as="geometry" /></mxCell><mxCell id="33" value="-idpId: int&#10;-designerId: int (owner)&#10;-categoryId: int&#10;-title: str&#10;-description: str&#10;-location: str&#10;-projectType: str (Current / Past)&#10;-status: str&#10;-createdDate: str&#10;-categoryName: str (joined, display only)" style="text;html=0;align=left;verticalAlign=top;fontSize=16;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="1427" y="262" width="546" height="224" as="geometry" /></mxCell><mxCell id="34" value="" style="endArrow=none;html=0;dashed=0;strokeColor=#334155;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1414" y="494" as="sourcePoint" /><mxPoint x="1988" y="494" as="targetPoint" /></mxGeometry></mxCell><mxCell id="35" value="+getCurrentIDP(designerId, idpId): IDP | None&#10;+updateCurrentIDP(idp): bool" style="text;html=0;align=left;verticalAlign=top;fontSize=16;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="1427" y="504" width="546" height="48" as="geometry" /></mxCell><mxCell id="36" value="" style="rounded=0;whiteSpace=wrap;fillColor=#fff9c4;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="1414" y="634" width="574" height="132" as="geometry" /></mxCell><mxCell id="37" value="updateCurrentIDP() only changes title, categoryId,&#10;description and location of the owner's Active Current&#10;IDP, and only if its old and its new category are both&#10;Active. No row changed -&gt; False." style="text;html=0;align=left;verticalAlign=top;fontSize=17;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="1432" y="652" width="538" height="96" as="geometry" /></mxCell><mxCell id="38" value="" style="endArrow=open;html=0;dashed=0;strokeColor=#334155;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="588" y="252" as="sourcePoint" /><mxPoint x="719" y="252" as="targetPoint" /></mxGeometry></mxCell><mxCell id="39" value="calls" style="text;html=0;align=left;verticalAlign=top;fontSize=12;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="592" y="230" width="40.28" height="20" as="geometry" /></mxCell><mxCell id="40" value="" style="endArrow=open;html=0;dashed=0;strokeColor=#334155;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="588" y="522" as="sourcePoint" /><mxPoint x="719" y="427" as="targetPoint" /><Array as="points"><mxPoint x="612" y="522" /><mxPoint x="612" y="427" /></Array></mxGeometry></mxCell><mxCell id="41" value="calls" style="text;html=0;align=left;verticalAlign=top;fontSize=12;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="618" y="405" width="40.28" height="20" as="geometry" /></mxCell><mxCell id="42" value="" style="endArrow=open;html=0;dashed=1;strokeColor=#334155;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1283" y="262" as="sourcePoint" /><mxPoint x="1414" y="262" as="targetPoint" /></mxGeometry></mxCell><mxCell id="43" value="uses" style="text;html=0;align=left;verticalAlign=top;fontSize=12;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="1289" y="242" width="39.44" height="20" as="geometry" /></mxCell></root>
    </mxGraphModel>
