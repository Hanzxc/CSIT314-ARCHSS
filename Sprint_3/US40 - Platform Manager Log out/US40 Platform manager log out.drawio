" value="«boundary»&#10;PlatformManagerLogoutPage" style="text;html=0;align=left;verticalAlign=top;fontSize=19;fontStyle=1;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="97" y="190" width="416" height="56" as="geometry" /></mxCell><mxCell id="15" value="-platformManagerLogoutController:&#10; PlatformManagerLogoutController" style="text;html=0;align=left;verticalAlign=top;fontSize=16;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="96" y="262" width="416" height="48" as="geometry" /></mxCell><mxCell id="16" value="" style="endArrow=none;html=0;dashed=0;strokeColor=#334155;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="83" y="318" as="sourcePoint" /><mxPoint x="527" y="318" as="targetPoint" /></mxGeometry></mxCell><mxCell id="17" value="+clickLogout()&#10;+displayLoginPage(msg)" style="text;html=0;align=left;verticalAlign=top;fontSize=16;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="96" y="328" width="416" height="48" as="geometry" /></mxCell><mxCell id="18" value="" style="rounded=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="658" y="182" width="564" height="118" as="geometry" /></mxCell><mxCell id="19" value="" style="rounded=0;whiteSpace=wrap;fillColor=#fff3e0;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="658" y="182" width="564" height="70" as="geometry" /></mxCell><mxCell id="20" value="«control»&#10;PlatformManagerLogoutController" style="text;html=0;align=left;verticalAlign=top;fontSize=19;fontStyle=1;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="672" y="190" width="536" height="56" as="geometry" /></mxCell><mxCell id="21" value="+logout(): bool" style="text;html=0;align=left;verticalAlign=top;fontSize=16;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="671" y="262" width="536" height="26" as="geometry" /></mxCell><mxCell id="22" value="" style="rounded=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="658" y="370" width="564" height="118" as="geometry" /></mxCell><mxCell id="23" value="" style="rounded=0;whiteSpace=wrap;fillColor=#fff3e0;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="658" y="370" width="564" height="70" as="geometry" /></mxCell><mxCell id="24" value="«control» (reused from US2)&#10;LogoutController" style="text;html=0;align=left;verticalAlign=top;fontSize=19;fontStyle=1;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="672" y="378" width="536" height="56" as="geometry" /></mxCell><mxCell id="25" value="+logout(): bool" style="text;html=0;align=left;verticalAlign=top;fontSize=16;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="671" y="450" width="536" height="26" as="geometry" /></mxCell><mxCell id="26" value="" style="rounded=0;whiteSpace=wrap;fillColor=#fff9c4;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="658" y="558" width="564" height="109" as="geometry" /></mxCell><mxCell id="27" value="The US40 control just returns US2's logout() - True if a session&#10;was ended, False if it had already ended. The Boundary flashes&#10;one message and redirects to manager login." style="text;html=0;align=left;verticalAlign=top;fontSize=17;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="676" y="576" width="528" height="73" as="geometry" /></mxCell><mxCell id="28" value="" style="rounded=0;whiteSpace=wrap;fillColor=#fff9c4;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="1353" y="182" width="574" height="109" as="geometry" /></mxCell><mxCell id="29" value="No business entity is required. Logout does not read, update or delete&#10;account rows. The Entity column is intentionally empty. Flask session&#10;is framework infrastructure, not an entity." style="text;html=0;align=left;verticalAlign=top;fontSize=17;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="1371" y="200" width="538" height="73" as="geometry" /></mxCell><mxCell id="30" value="One shared header button (platformManagerBase.html and&#10;the dashboard). The admin and designer logouts are&#10;unchanged." style="text;html=0;align=left;verticalAlign=top;fontSize=16;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="81" y="747" width="440" height="70" as="geometry" /></mxCell><mxCell id="31" value="" style="endArrow=open;html=0;dashed=0;strokeColor=#334155;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="527" y="252" as="sourcePoint" /><mxPoint x="658" y="252" as="targetPoint" /></mxGeometry></mxCell><mxCell id="32" value="calls" style="text;html=0;align=left;verticalAlign=top;fontSize=12;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="531" y="230" width="33" height="20" as="geometry" /></mxCell><mxCell id="33" value="" style="endArrow=open;html=0;dashed=1;strokeColor=#334155;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="940" y="300" as="sourcePoint" /><mxPoint x="940" y="370" as="targetPoint" /></mxGeometry></mxCell><mxCell id="34" value="uses" style="text;html=0;align=left;verticalAlign=top;fontSize=12;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="946" y="302" width="34" height="20" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="6 Sequence Diagram"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageWidth="1340" pageHeight="1022"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" value="Sequence Diagram - UC40 Platform manager log out (US40)" style="text;html=0;align=left;verticalAlign=top;fontSize=26;fontStyle=1;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="22" y="17" width="1650" height="39" as="geometry" /></mxCell><mxCell id="4" value="" style="endArrow=none;html=0;dashed=1;strokeColor=#334155;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1170" y="225" as="sourcePoint" /><mxPoint x="1170" y="942" as="