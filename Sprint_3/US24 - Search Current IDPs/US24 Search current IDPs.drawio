" y="655" width="163.14" height="23" as="geometry" /></mxCell><mxCell id="43" value="7: matching current IDPs, keyword kept" style="text;html=0;align=left;verticalAlign=top;fontSize=13;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="106" y="697" width="292" height="22" as="geometry" /></mxCell><mxCell id="44" value="8: displayNoResultsMessage()" style="text;html=0;align=left;verticalAlign=top;fontSize=14;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="450" y="816" width="209.9" height="23" as="geometry" /></mxCell><mxCell id="45" value="9: MSG_NO_RESULTS, or MSG_NO_IDPS&#10;when the keyword is empty" style="text;html=0;align=left;verticalAlign=top;fontSize=13;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="106" y="858" width="292" height="40" as="geometry" /></mxCell><mxCell id="46" value="the page trims the keyword" style="text;html=0;align=left;verticalAlign=top;fontSize=12;fontStyle=0;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="410" y="269" width="173.48" height="20" as="geometry" /></mxCell><mxCell id="47" value="the owner's Active Current IDPs in Active categories&#10;whose title, description, location or category name&#10;contains the keyword (any case); empty keyword -&gt;&#10;all of them; newest first" style="text;html=0;align=left;verticalAlign=top;fontSize=12;fontStyle=0;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="766" y="395" width="324.92" height="68" as="geometry" /></mxCell><mxCell id="48" value="" style="rounded=0;whiteSpace=wrap;fillColor=none;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="60" y="593" width="1130" height="345" as="geometry" /></mxCell><mxCell id="49" value="" style="endArrow=none;html=0;dashed=0;strokeColor=#334155;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="622" as="sourcePoint" /><mxPoint x="124" y="593" as="targetPoint" /><Array as="points"><mxPoint x="112" y="622" /><mxPoint x="124" y="611" /></