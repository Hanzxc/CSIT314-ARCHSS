      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" value="B-C-E Class Diagram - UC24 Search current IDPs (US24)" style="text;html=0;align=left;verticalAlign=top;fontSize=29;fontStyle=1;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="24" y="15" width="2000" height="43" as="geometry" /></mxCell><mxCell id="3" value="" style="rounded=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="55" y="125" width="557" height="679" as="geometry" /></mxCell><mxCell id="4" value="" style="rounded=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="55" y="88" width="152" height="37" as="geometry" /></mxCell><mxCell id="5" value="Boundary" style="text;html=0;align=left;verticalAlign=top;fontSize=15;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="65" y="100" width="136" height="22" as="geometry" /></mxCell><mxCell id="6" value="" style="rounded=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="687" y="125" width="620" height="679" as="geometry" /></mxCell><mxCell id="7" value="" style="rounded=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="687" y="88" width="152" height="37" as="geometry" /></mxCell><mxCell id="8" value="Control" style="text;html=0;align=left;verticalAlign=top;fontSize=15;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="697" y="100" width="136" height="22" as="geometry" /></mxCell><mxCell id="9" value="" style="rounded=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="1382" y="125" width="630" height="679" as="geometry" /></mxCell><mxCell id="10" value="" style="rounded=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="1382" y="88" width="152" height="37" as="geometry" /></mxCell><mxCell id="11" value="Entity" style="text;html=0;align=left;verticalAlign=top;fontSize=15;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="1392" y="100" width="136" height="22" as="geometry" /></mxCell><mxCell id="12" value="" style="rounded=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="83" y="182" width="501" height="228" as="geometry" /></mxCell><mxCell id="13" value="" style="rounded=0;whiteSpace=wrap;fillColor=#e3f2fd;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="83" y="182" width="501" height="70" as="geometry" /></mxCell><mxCell id="14" value="«boundary»&#10;SearchCurrentIDPPage" style="text;html=0;align=left;verticalAlign=top;fontSize=19;fontStyle=1;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="97" y="190" width="473" height="56" as="geometry" /></mxCell><mxCell id="15" value="-searchCurrentIDPController: SearchCurrentIDPController&#10;-keyword: str" style="text;html=0;align=left;verticalAlign=top;fontSize=16;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="96" y="262" width="473" height="48" as="geometry" /></mxCell><mxCell id="16" value="" style="endArrow=none;html=0;dashed=0;strokeColor=#334155;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="83" y="318" as="sourcePoint" /><mxPoint x="584" y="318" as="targetPoint" /></mxGeometry></mxCell><mxCell id="17" value="+searchCurrentIDPs(keyword)&#10;+displayResults(idps)&#10;+displayNoResultsMessage()" style="text;html=0;align=left;verticalAlign=top;fontSize=16;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="96" y="328" width="473" height="70" as="geometry" /></mxCell><mxCell id="18" value="" style="rounded=0;whiteSpace=wrap;fillColor=#fff9c4;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="83" y="480" width="501" height="155" as="geometry" /></mxCell><mxCell id="19" value="searchCurrentIDPs() trims the keyword, keeps it for&#10;the page and calls the search straight away&#10;(designerId = session userId). No results -&gt;&#10;MSG_NO_RESULTS, or MSG_NO_IDPS for an empty&#10;keyword." style="text;html=0;align=left;verticalAlign=top;fontSize=17;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="101" y="498" width="465" height="119" as="geometry" /></mxCell><mxCell id="20" value="" style="rounded=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="715" y="182" width="564" height="118" as="geometry" /></mxCell><mxCell id="21" value="" style="rounded=0;whiteSpace=wrap;fillColor=#fff3e0;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="715" y="182" width="564" height="70" as="geometry" /></mxCell><mxCell id="22" value="«control»&#10;SearchCurrentIDPController" style="text;html=0;align=left;verticalAlign=top;fontSize=19;fontStyle=1;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="729" y="190" width="536" height="56" as="geometry" /></mxCell><mxCell id="23" value="+searchCurrentIDPs(designerId, keyword): list" style="text;html=0;align=left;verticalAlign=top;fontSize=16;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="728" y="262" width="536" height="26" as="geometry" /></mxCell><mxCell id="24" value="" style="rounded=0;whiteSpace=wrap;fillColor=#fff9c4;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="715" y="370" width="564" height="155" as="geometry" /></mxCell><mxCell id="25" value="The controller just calls the entity and returns the&#10;result - no checks.&#10;Precondition: logged in as an interior designer&#10;(UC13). designerLoginRequired in app.py only&#10;sends someone with no session to /designer/login." style="text;html=0;align=left;verticalAlign=top;fontSize=17;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="733" y="388" width="528" height="119" as="geometry" /></mxCell><mxCell id="26" value="" style="rounded=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="1410" y="182" width="574" height="360" as="geometry" /></mxCell><mxCell id="27" value="" style="rounded=0;whiteSpace=wrap;fillColor=#e8f5e9;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="1410" y="182" width="574" height="70" as="geometry" /></mxCell><mxCell id="28" value="«entity»&#10;IDP" style="text;html=0;align=left;verticalAlign=top;fontSize=19;fontStyle=1;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="1424" y="190" width="546" height="56" as="geometry" /></mxCell><mxCell id="29" value="-idpId: int&#10;-designerId: int (owner)&#10;-categoryId: int&#10;-title: str&#10;-description: str&#10;-location: str&#10;-projectType: str (Current / Past)&#10;-status: str&#10;-createdDate: str&#10;-categoryName: str (joined, display only)" style="text;html=0;align=left;verticalAlign=top;fontSize=16;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="1423" y="262" width="546" height="224" as="geometry" /></mxCell><mxCell id="30" value="" style="endArrow=none;html=0;dashed=0;strokeColor=#334155;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1410" y="494" as="sourcePoint" /><mxPoint x="1984" y="494" as="targetPoint" /></mxGeometry></mxCell><mxCell id="31" value="+searchCurrentIDPs(designerId, keyword): list" style="text;html=0;align=left;verticalAlign=top;fontSize=16;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="1423" y="504" width="546" height="26" as="geometry" /></mxCell><mxCell id="32" value="" style="rounded=0;whiteSpace=wrap;fillColor=#fff9c4;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="1410" y="612" width="574" height="132" as="geometry" /></mxCell><mxCell id="33" value="Literal, case-insensitive match on title, description,&#10;location and category name. Only the owner's Active&#10;Current IDPs in Active categories, newest first. An&#10;empty keyword returns all of them. No trimming here." style="text;html=0;align=left;verticalAlign=top;fontSize=17;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="1428" y="630" width="538" height="96" as="geometry" /></mxCell><mxCell id="34" value="" style="endArrow=open;html=0;dashed=0;strokeColor=#334155;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="584" y="252" as="sourcePoint" /><mxPoint x="715" y="252" as="targetPoint" /></mxGeometry></mxCell><mxCell id="35" value="calls" style="text;html=0;align=left;verticalAlign=top;fontSize=12;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="588" y="230" width="40.28" height="20" as="geometry" /></mxCell><mxCell id="36" value="" style="endArrow=open;html=0;dashed=1;strokeColor=#334155;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1279" y="262" as="sourcePoint" /><mxPoint x="1410" y="262" as="targetPoint" /></mxGeometry></mxCell><mxCell id="37" value="uses" style="text;html=0;align=left;verticalAlign=top;fontSize=12;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="1285" y="242" width="39.44" height="20" as="geometry" /></mxCell></root>
