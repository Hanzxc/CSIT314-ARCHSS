metry></mxCell><mxCell id="34" value="5: HTTP 302 → /customer/login" style="text;html=0;align=left;verticalAlign=top;fontSize=13;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="106" y="511" width="292" height="22" as="geometry" /></mxCell><mxCell id="35" value="" style="endArrow=open;html=0;dashed=0;rounded=0;strokeColor=#334155;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="406" y="628" as="sourcePoint" /><mxPoint x="406" y="652" as="targetPoint" /><Array as="points"><mxPoint x="442" y="628" /><mxPoint x="442" y="652" /></Array></mxGeometry></mxCell><mxCell id="36" value="6: displayLoginPage(MSG_SESSION_ENDED)" style="text;html=0;align=left;verticalAlign=top;fontSize=14;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="450" y="630" width="306" height="23" as="geometry" /></mxCell><mxCell id="37" value="" style="endArrow=open;html=0;dashed=1;strokeColor=#334155;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="400" y="696" as="sourcePoint" /><mxPoint x="100" y="696" as="targetPoint" /></mxGeometry></mxCell><mxCell id="38" value="7: HTTP 302 → /customer/login" style="text;html=0;align=left;verticalAlign=top;fontSize=13;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="106" y="672" width="292" height="22" as="geometry" /></mxCell><mxCell id="39" value="" style="rounded=0;whiteSpace=wrap;fillColor=none;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="60" y="407" width="940" height="327" as="geometry" /></mxCell><mxCell id="40" value="" style="endArrow=none;html=0;dashed=0;rounded=0;strokeColor=#334155;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="436" as="sourcePoint" /><mxPoint x="124" y="407" as="targetPoint" /><Array as="points"><mxPoint x="112" y="436" /><mxPoint x="124" y="425" /></Array></mxGeometry></mxCell><mxCell id="41" value="alt" style="text;html=0;align=left;verticalAlign=top;fontSize=14;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="68" y="413" width="23" height="23" as="geometry" /></mxCell><mxCell id="42" value="[loggedOut == True]" style="text;html=0;align=left;verticalAlign=top;fontSize=14;fontStyle=1;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="136" y="413" width="168" height="23" as="geometry" /></mxCell><mxCell id="43" value="" style="endArrow=none;html=0;dashed=1;strokeColor=#334155;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="573" as="sourcePoint" /><mxPoint x="1000" y="573" as="targetPoint" /></mxGeometry></mxCell><mxCell id="44" value="[loggedOut == False]" style="text;html=0;align=left;verticalAlign=top;fontSize=14;fontStyle=1;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="138" y="581" width="176" height="23" as="geometry" /></mxCell><mxCell id="45" value="MSG_LOGGED_OUT = &quot;You have logged out successfully&quot; (flashed as success), MSG_SESSION_ENDED = &quot;Your session has already ended&quot;&#10;(flashed as info). The customer login page shows the message once. Precondition: none - log out works with or without a session." style="text;html=0;align=left;verticalAlign=top;fontSize=14;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="30" y="836" width="960" height="42" as="geometry" /></mxCell></root></mxGraphModel></diagram>
