  <diagram name="6 Sequence Diagram" id="6"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageWidth="1380" pageHeight="908"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" value="Sequence Diagram - UC36 Customer log out (US36)" style="text;html=0;align=left;verticalAlign=top;fontSize=26;fontStyle=1;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="22" y="17" width="1650" height="39" as="geometry" /></mxCell><mxCell id="3" value="POST /customer/logout has no decorator: with no session the customer just gets &quot;Your session has already ended&quot;." style="text;html=0;align=left;verticalAlign=top;fontSize=14;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="22" y="62" width="886" height="23" as="geometry" /></mxCell><mxCell id="4" value="" style="endArrow=none;html=0;dashed=1;strokeColor=#334155;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="860" y="225" as="sourcePoint" /><mxPoint x="860" y="816" as="targetPoint" /></mxGeometry></mxCell><mxCell id="5" value="" style="endArrow=none;html=0;dashed=1;strokeColor=#334155;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="400" y="225" as="sourcePoint" /><mxPoint x="400" y="816" as="targetPoint" /></mxGeometry></mxCell><mxCell id="6" value="" style="endArrow=none;html=0;dashed=1;strokeColor=#334155;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="100" y="225" as="sourcePoint" /><mxPoint x="100" y="816" as="targetPoint" /></mxGeometry></mxCell><mxCell id="7" value="" style="rounded=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="853" y="313" width="14" height="68" as="geometry" /></mxCell><mxCell id="8" value="" style="rounded=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="393" y="255" width="14" height="441" as="geometry" /></mxCell><mxCell id="9" value="" style="ellipse;fillColor=#ffffff;stroke