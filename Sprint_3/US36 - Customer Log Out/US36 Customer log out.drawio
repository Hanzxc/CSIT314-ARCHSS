int" /></mxGeometry></mxCell><mxCell id="18" value=":CustomerLogoutPage" style="text;html=0;align=left;verticalAlign=top;fontSize=14;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="324" y="200" width="152" height="23" as="geometry" /></mxCell><mxCell id="19" value="" style="ellipse;fillColor=#fff3e0;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="831" y="105" width="58" height="58" as="geometry" /></mxCell><mxCell id="20" value="" style="endArrow=none;html=0;dashed=0;strokeColor=#334155;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="862" y="105" as="sourcePoint" /><mxPoint x="874" y="97" as="targetPoint" /></mxGeometry></mxCell><mxCell id="21" value="" style="endArrow=none;html=0;dashed=0;strokeColor=#334155;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="862" y="105" as="sourcePoint" /><mxPoint x="872" y="112" as="targetPoint" /></mxGeometry></mxCell><mxCell id="22" value=":CustomerLogoutController" style="text;html=0;align=left;verticalAlign=top;fontSize=14;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="760.5" y="200" width="199" height="23" as="geometry" /></mxCell><mxCell id="23" value="" style="endArrow=open;html=0;dashed=0;strokeColor=#334155;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="100" y="265" as="sourcePoint" /><mxPoint x="400" y="265" as="targetPoint" /></mxGeometry></mxCell><mxCell id="24" value="1: clickLogout()" style="text;html=0;align=left;verticalAlign=top;fontSize=13;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="106" y="241" width="292" height="22" as="geometry" /></mxCell><mxCell id="25" value="" style="endArrow=open;html=0;dashed=0;strokeColor=#334155;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="400" y="323" as="sourcePoint" /><mxPoint x="860" y="323" as="targetPoint" /></mxGeometry></mxCell><mxCell id="26" value="2: logout()" style="text;html=0;align=left;vertic