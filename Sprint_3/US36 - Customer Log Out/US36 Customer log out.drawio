  <diagram name="5 BCE Class Diagram" id="5"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageWidth="2100" pageHeight="842"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" value="B-C-E Class Diagram - UC36 Customer log out (US36)" style="text;html=0;align=left;verticalAlign=top;fontSize=29;fontStyle=1;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="24" y="15" width="2000" height="43" as="geometry" /></mxCell><mxCell id="3" value="" style="rounded=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="55" y="125" width="500" height="677" as="geometry" /></mxCell><mxCell id="4" value="" style="rounded=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="55" y="88" width="152" height="37" as="geometry" /></mxCell><mxCell id="5" value="Boundary" style="text;html=0;align=left;verticalAlign=top;fontSize=15;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="65" y="100" width="136" height="22" as="geometry" /></mxCell><mxCell id="6" value="" style="rounded=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="630" y="125" width="620" height="677" as="geometry" /></mxCell><mxCell id="7" value="" style="rounded=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="630" y="88" width="152" height="37" as="geometry" /></mxCell><mxCell id="8" value="Control" style="text;html=0;align=left;verticalAlign=top;fontSize=15;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="640" y="100" width="136" height="22" as="geometry" /></mxCell><mxCell id="9" value="" style="rounded=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="1325" y="125" width="630" height="677" as="geometry" /></mxCell><mxCell id="10" value="" style="rounded=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="1325" y="88" width="152" height="37" as="geometry" /></mxCell><mxCell id="11" value="Entity" style="text;html=0;align=left;verticalAlign=top;fontSize=15;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="1335" y="100" width="136" height="22" as="geometry" /></mxCell><mxCell id="12" value="" style="rounded=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="83" y="182" width="444" height="175" as="geometry" /></mxCell><mxCell id="13" value="" style="rounded=0;whiteSpace=wrap;fillColor=#e3f2fd;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="83" y="182" width="444" height="70" as="geometry" /></mxCell><mxCell id="14" value="«boundary»&#10;CustomerLogoutPage" style="text;html=0;align=left;verticalAlign=top;fontSize=19;fontStyle=1;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="97" y="190" width="416" height="56" as="geometry" /></mxCell><mxCell id="15" value="-customerLogoutController: CustomerLogoutController" style="text;html=0;align=left;verticalAlign=top;fontSize=16;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="96" y="262" width="416" height="22" as="geometry" /></mxCell><mxCell id="16" value="" style="endArrow=none;html=0;dashed=0;strokeColor=#334155;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="83" y="292" as="sourcePoint" /><mxPoint x="527" y="292" as="targetPoint" /></mxGeometry></mxCell><mxCell id="17" value="+clickLogout()&#10;+displayLoginPage(msg)" style="text;html=0;align=left;verticalAlign=top;fontSize=16;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="96" y="302" width="416" height="43" as="geometry" /></mxCell><mxCell id="18" value="" style="rounded=0;whiteSpace=wrap;fillColor=#fff9c4;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="83" y="487" width="444" height="208" as="geometry" /></mxCell><mxCell id="19" value="The Log out button is in the header of every&#10;customer page (POST /customer/logout).&#10;clickLogout() picks the message from the&#10;controller's result: MSG_LOGGED_OUT (&quot;You&#10;have logged out successfully&quot;) or&#10;MSG_SESSION_ENDED (&quot;Your session has already&#10;ended&quot;), and sends the customer to&#10;/customer/login." style="text;html=0;align=left;verticalAlign=top;fontSize=17;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="101" y="500" width="408" height="186" as="geometry" /></mxCell><mxCell id="20" value="" style="rounded=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="658" y="182" width="564" height="115" as="geometry" /></mxCell><mxCell id="21" value="" style="rounded=0;whiteSpace=wrap;fillColor=#fff3e0;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="658" y="182" width="564" height="70" as="geometry" /></mxCell><mxCell id="22" value="«control»&#10;CustomerLogoutController" style="text;html=0;align=left;verticalAlign=top;fontSize=19;fontStyle=1;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="672" y="190" width="536" height="56" as="geometry" /></mxCell><mxCell id="23" value="+logout(): bool" style="text;html=0;align=left;verticalAlign=top;fontSize=16;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="671" y="262" width="536" height="23" as="geometry" /></mxCell><mxCell id="24" value="" style="rounded=0;whiteSpace=wrap;fillColor=#fff9c4;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="658" y="427" width="564" height="208" as="geometry" /></mxCell><mxCell id="25" value="logout() does the whole job itself:&#10;loggedOut = &quot;userId&quot; in session&#10;session.clear()&#10;return loggedOut&#10;It does not call US2's LogoutController and clears the&#10;session only once. Precondition: none is enforced - the&#10;route has no decorator, so with no session the customer&#10;just sees &quot;Your session has already ended&quot;." style="text;html=0;align=left;verticalAlign=top;fontSize=17;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="676" y="440" width="528" height="186" as="geometry" /></mxCell><mxCell id="26" value="" style="rounded=0;whiteSpace=wrap;fillColor=#fff9c4;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="1353" y="182" width="574" height="95" as="geometry" /></mxCell><mxCell id="27" value="No entity class is needed for log out. Logging out does not&#10;read or change any saved data - the controller only ends&#10;the session that was started at log in (UC30)." style="text;html=0;align=left;verticalAlign=top;fontSize=17;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="1371" y="195" width="538" height="73" as="geometry" /></mxCell><mxCell id="28" value="" style="endArrow=open;html=0;dashed=0;strokeColor=#334155;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="527" y="252" as="sourcePoint" /><mxPoint x="658" y="252" as="targetPoint" /></mxGeometry></mxCell><mxCell id="29" value="calls" style="text;html=0;align=left;verticalAlign=top;fontSize=12;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="531" y="230" width="40" height="20" as="geometry" /></mxCell></root></mxGraphModel></diagram>
