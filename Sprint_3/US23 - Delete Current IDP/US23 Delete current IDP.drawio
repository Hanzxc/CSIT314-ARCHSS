  <diagram name="5 BCE Class Diagram" id="5">
    <mxGraphModel page="1" pageWidth="2149" pageHeight="866" grid="1" gridSize="10">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" value="B-C-E Class Diagram - UC23 Delete current IDP (US23)" style="text;html=0;align=left;verticalAlign=top;fontSize=29;fontStyle=1;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="24" y="15" width="2000" height="43" as="geometry" /></mxCell><mxCell id="3" value="" style="rounded=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="55" y="125" width="549" height="701" as="geometry" /></mxCell><mxCell id="4" value="" style="rounded=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="55" y="88" width="152" height="37" as="geometry" /></mxCell><mxCell id="5" value="Boundary" style="text;html=0;align=left;verticalAlign=top;fontSize=15;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="65" y="100" width="136" height="22" as="geometry" /></mxCell><mxCell id="6" value="" style="rounded=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="679" y="125" width="620" height="701" as="geometry" /></mxCell><mxCell id="7" value="" style="rounded=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="679" y="88" width="152" height="37" as="geometry" /></mxCell><mxCell id="8" value="Control" style="text;html=0;align=left;verticalAlign=top;fontSize=15;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="689" y="100" width="136" height="22" as="geometry" /></mxCell><mxCell id="9" value="" style="rounded=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="1374" y="125" width="630" height="701" as="geometry" /></mxCell><mxCell id="10" value="" style="rounded=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="1374" y="88" width="152" height="37" as="geometry" /></mxCell><mxCell id="11" value="Entity" style="text;html=0;align=left;verticalAlign=top;fontSize=15;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="1384" y="100" width="136" height="22" as="geometry" /></mxCell><mxCell id="12" value="" style="rounded=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="83" y="182" width="493" height="294" as="geometry" /></mxCell><mxCell id="13" value="" style="rounded=0;whiteSpace=wrap;fillColor=#e3f2fd;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="83" y="182" width="493" height="70" as="geometry" /></mxCell><mxCell id="14" value="«boundary»&#10;DeleteCurrentIDPPage" style="text;html=0;align=left;verticalAlign=top;fontSize=19;fontStyle=1;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="97" y="190" width="465" height="56" as="geometry" /></mxCell><mxCell id="15" value="-deleteCurrentIDPController: DeleteCurrentIDPController" style="text;html=0;align=left;verticalAlign=top;fontSize=16;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="96" y="262" width="465" height="26" as="geometry" /></mxCell><mxCell id="16" value="" style="endArrow=none;html=0;dashed=0;strokeColor=#334155;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="83" y="296" as="sourcePoint" /><mxPoint x="576" y="296" as="targetPoint" /></mxGeometry></mxCell><mxCell id="17" value="+clickDelete(idpId)&#10;+displayConfirmation(idp)&#10;+submitDelete(idpId, choice)&#10;+confirmDelete(idpId)&#10;+cancelDelete(idpId)&#10;+displaySuccessMessage(msg)&#10;+displayNotFoundMessage()" style="text;html=0;align=left;verticalAlign=top;fontSize=16;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="96" y="306" width="465" height="158" as="geometry" /></mxCell><mxCell id="18" value="" style="rounded=0;whiteSpace=wrap;fillColor=#fff9c4;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="83" y="546" width="493" height="132" as="geometry" /></mxCell><mxCell id="19" value="submitDelete() sends choice &quot;delete&quot; to confirmDelete()&#10;and &quot;cancel&quot; to cancelDelete() (back to the preview,&#10;nothing changes). designerId = session userId.&#10;No token, nothing is kept in the session." style="text;html=0;align=left;verticalAlign=top;fontSize=17;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="101" y="564" width="457" height="96" as="geometry" /></mxCell><mxCell id="20" value="" style="rounded=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="707" y="182" width="564" height="140" as="geometry" /></mxCell><mxCell id="21" value="" style="rounded=0;whiteSpace=wrap;fillColor=#fff3e0;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="707" y="182" width="564" height="70" as="geometry" /></mxCell><mxCell id="22" value="«control»&#10;DeleteCurrentIDPController" style="text;html=0;align=left;verticalAlign=top;fontSize=19;fontStyle=1;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="721" y="190" width="536" height="56" as="geometry" /></mxCell><mxCell id="23" value="+getCurrentIDP(designerId, idpId): IDP | None&#10;+deleteCurrentIDP(designerId, idpId): bool" style="text;html=0;align=left;verticalAlign=top;fontSize=16;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="720" y="262" width="536" height="48" as="geometry" /></mxCell><mxCell id="24" value="" style="rounded=0;whiteSpace=wrap;fillColor=#fff9c4;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="707" y="392" width="564" height="178" as="geometry" /></mxCell><mxCell id="25" value="The controller just calls the entity and returns the&#10;result - no checks. getCurrentIDP() is US23's own&#10;loader for the confirmation box.&#10;Precondition: logged in as an interior designer&#10;(UC13). designerLoginRequired in app.py only&#10;sends someone with no session to /designer/login." style="text;html=0;align=left;verticalAlign=top;fontSize=17;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="725" y="410" width="528" height="142" as="geometry" /></mxCell><mxCell id="26" value="" style="rounded=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="1402" y="182" width="574" height="382" as="geometry" /></mxCell><mxCell id="27" value="" style="rounded=0;whiteSpace=wrap;fillColor=#e8f5e9;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="1402" y="182" width="574" height="70" as="geometry" /></mxCell><mxCell id="28" value="«entity»&#10;IDP" style="text;html=0;align=left;verticalAlign=top;fontSize=19;fontStyle=1;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="1416" y="190" width="546" height="56" as="geometry" /></mxCell><mxCell id="29" value="-idpId: int&#10;-designerId: int (owner)&#10;-categoryId: int&#10;-title: str&#10;-description: str&#10;-location: str&#10;-projectType: str (Current / Past)&#10;-status: str&#10;-createdDate: str&#10;-categoryName: str (joined, display only)" style="text;html=0;align=left;verticalAlign=top;fontSize=16;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="1415" y="262" width="546" height="224" as="geometry" /></mxCell><mxCell id="30" value="" style="endArrow=none;html=0;dashed=0;strokeColor=#334155;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1402" y="494" as="sourcePoint" /><mxPoint x="1976" y="494" as="targetPoint" /></mxGeometry></mxCell><mxCell id="31" value="+getCurrentIDP(designerId, idpId): IDP | None&#10;+suspendCurrentIDP(designerId, idpId): bool" style="text;html=0;align=left;verticalAlign=top;fontSize=16;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="1415" y="504" width="546" height="48" as="geometry" /></mxCell><mxCell id="32" value="" style="rounded=0;whiteSpace=wrap;fillColor=#fff9c4;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="1402" y="634" width="574" height="132" as="geometry" /></mxCell><mxCell id="33" value="suspendCurrentIDP() sets status = 'Suspended' only for&#10;the owner's Active Current IDP whose category is&#10;Active. The row and its details are kept.&#10;No row changed -&gt; False." style="text;html=0;align=left;verticalAlign=top;fontSize=17;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="1420" y="652" width="538" height="96" as="geometry" /></mxCell><mxCell id="34" value="" style="endArrow=open;html=0;dashed=0;strokeColor=#334155;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="576" y="252" as="sourcePoint" /><mxPoint x="707" y="252" as="targetPoint" /></mxGeometry></mxCell><mxCell id="35" value="calls" style="text;html=0;align=left;verticalAlign=top;fontSize=12;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="580" y="230" width="40.28" height="20" as="geometry" /></mxCell><mxCell id="36" value="" style="endArrow=open;html=0;dashed=1;strokeColor=#334155;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1271" y="262" as="sourcePoint" /><mxPoint x="1402" y="262" as="targetPoint" /></mxGeometry></mxCell><mxCell id="37" value="uses" style="text;html=0;align=left;verticalAlign=top;fontSize=12;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="1277" y="242" width="39.44" height="20" as="geometry" /></mxCell></root>
    </mxGraphModel>
