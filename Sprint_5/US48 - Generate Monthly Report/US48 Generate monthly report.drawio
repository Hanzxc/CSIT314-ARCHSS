<mxfile host="drawio" type="device"><diagram id="2-14560" name="2 Use Case Diagram"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1050" pageHeight="600" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="Use Case Diagram - US48 Generate monthly report" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=27;fontStyle=1;fontColor=#1e293b;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="24" y="17" width="1000" height="40" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="350" y="110" width="650" height="340" as="geometry"/></mxCell><mxCell id="c5" value="Interior Design Platform" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=20;fontStyle=1;fontColor=#1e293b;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="380" y="130" width="500" height="30" as="geometry"/></mxCell><mxCell id="c6" value="Platform Manager" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#ffffff;strokeColor=#334155;fontSize=17;fontStyle=1;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="135" y="195" width="50" height="100" as="geometry"/></mxCell><mxCell id="c7" value="Generate monthly report" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#334155;fontSize=17;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="520" y="235" width="340" height="90" as="geometry"/></mxCell><mxCell id="c8" style="endArrow=none;endFill=0;html=1;rounded=0;strokeColor=#334155;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="200" y="280" as="sourcePoint"/><mxPoint x="520" y="280" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c9" value="Precondition: the platform manager is logged in (UC39). The report ranks every IDP category by how many times its IDPs were viewed (UC32) and saved (UC33) in the month of the chosen day. US46 - US48 are the daily, weekly and monthly reports." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontStyle=0;fontColor=#1e293b;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="24" y="470" width="1000" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="5-11367" name="5 BCE Class Diagram"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="2100" pageHeight="740" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1839" value="Entity" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1325" y="88" width="150" height="37" as="geometry"/></mxCell><mxCell id="c1840" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="1325" y="125" width="630" height="575" as="geometry"/></mxCell><mxCell id="c1144" value="Control" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="630" y="88" width="150" height="37" as="geometry"/></mxCell><mxCell id="c1145" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="630" y="125" width="620" height="575" as="geometry"/></mxCell><mxCell id="c569" value="Boundary" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="55" y="88" width="150" height="37" as="geometry"/></mxCell><mxCell id="c570" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="55" y="125" width="500" height="575" as="geometry"/></mxCell><mxCell id="c3" value="B-C-E Class Diagram - UC48 Generate monthly report (US48)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=29;fontStyle=1;fontColor=#1e293b;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="24" y="15" width="2000" height="43" as="geometry"/></mxCell><mxCell id="c4" value="«boundary»&lt;br&gt;GenerateMonthlyReportPage" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="83" y="182" width="444" height="52" as="geometry"/></mxCell><mxCell id="c5" value="-generateMonthlyReportController: GenerateMonthlyReportController&lt;br&gt;-selectedDate: str" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="83" y="234" width="444" height="88" as="geometry"/></mxCell><mxCell id="c6" value="+clickGenerateMonthlyReport()&lt;br&gt;+displayReportForm(report=None, errorMessage=None, infoMessage=None)&lt;br&gt;+validateDate(selectedDate): str | None&lt;br&gt;+submitDate(selectedDate)&lt;br&gt;+displayReport(report)&lt;br&gt;+displayErrorMessage(msg)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="83" y="322" width="444" height="184" as="geometry"/></mxCell><mxCell id="c7" value="validateDate() returns MSG_INVALID_DATE if the text isn&#x27;t a real YYYY-MM-DD date, MSG_FUTURE_DATE if it&#x27;s after today, else None. The date box starts on today." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;whiteSpace=wrap;spacing=12;" vertex="1" parent="1"><mxGeometry x="83" y="546" width="444" height="114" as="geometry"/></mxCell><mxCell id="c8" value="«control»&lt;br&gt;GenerateMonthlyReportController" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="658" y="182" width="564" height="52" as="geometry"/></mxCell><mxCell id="c9" value="+generateMonthlyReport(selectedDate): dict" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="658" y="234" width="564" height="40" as="geometry"/></mxCell><mxCell id="c10" value="Works out the period: startDate = 1st, endDate = last day of that month. Returns {startDate, endDate, categories}. Precondition: the manager is already logged in (UC39), so there&#x27;s no PlatformManagerLoginController here (lecturer feedback, same as UC41 - UC45)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;whiteSpace=wrap;spacing=12;" vertex="1" parent="1"><mxGeometry x="658" y="324" width="564" height="135" as="geometry"/></mxCell><mxCell id="c11" value="«entity»&lt;br&gt;IDPAnalytics" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1353" y="182" width="574" height="52" as="geometry"/></mxCell><mxCell id="c12" value="+getCategoryReport(startDate, endDate): list" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="1353" y="234" width="574" height="40" as="geometry"/></mxCell><mxCell id="c13" value="One row per category (Active or Suspended): categoryName, status, totalIDPs, views, saves between startDate and endDate (both included), ranked by views then saves. Times are stored in UTC and compared as local dates. Views come from idp_view (UC32), saves from saved_idp (UC33)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;whiteSpace=wrap;spacing=12;" vertex="1" parent="1"><mxGeometry x="1353" y="314" width="574" height="135" as="geometry"/></mxCell><mxCell id="c14" style="endArrow=open;endFill=0;html=1;rounded=0;strokeColor=#334155;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="527" y="262" as="sourcePoint"/><mxPoint x="658" y="262" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c15" value="calls" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontStyle=0;fontColor=#1e293b;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="535" y="240" width="60" height="20" as="geometry"/></mxCell><mxCell id="c16" style="endArrow=open;endFill=0;html=1;rounded=0;strokeColor=#334155;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1222" y="267" as="sourcePoint"/><mxPoint x="1353" y="262" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c17" value="uses" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontStyle=0;fontColor=#1e293b;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1230" y="244" width="90" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="6-78456" name="6 Sequence Diagram"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1390" pageHeight="1352" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="Sequence Diagram - UC48 Generate monthly report (US48)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=26;fontStyle=1;fontColor=#1e293b;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="22" y="17" width="1350" height="39" as="geometry"/></mxCell><mxCell id="c4" value="GET /manager/reports/monthly opens the page (steps 1-3); GET /manager/reports/monthly?date=... generates the report (step 4 on)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontStyle=0;fontColor=#1e293b;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="22" y="58" width="1350" height="22" as="geometry"/></mxCell><mxCell id="c5" value="" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#ffffff;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="95.0" y="100" width="30" height="60" as="geometry"/></mxCell><mxCell id="c6" value="Platform Manager" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=12;fontStyle=0;fontColor=#1e293b;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="-50" y="168" width="320" height="20" as="geometry"/></mxCell><mxCell id="c7" value="" style="shape=umlBoundary;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#334155;verticalLabelPosition=bottom;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="418.0" y="100" width="64" height="52" as="geometry"/></mxCell><mxCell id="c8" value=":GenerateMonthlyReportPage" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=12;fontStyle=0;fontColor=#1e293b;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="290" y="160" width="320" height="20" as="geometry"/></mxCell><mxCell id="c9" value="" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#334155;verticalLabelPosition=bottom;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="765.0" y="100" width="50" height="58" as="geometry"/></mxCell><mxCell id="c10" value=":GenerateMonthlyReportController" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=12;fontStyle=0;fontColor=#1e293b;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="630" y="166" width="320" height="20" as="geometry"/></mxCell><mxCell id="c11" value="" style="ellipse;shape=umlEntity;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#334155;verticalLabelPosition=bottom;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1104.0" y="100" width="52" height="52" as="geometry"/></mxCell><mxCell id="c12" value=":IDPAnalytics" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=12;fontStyle=0;fontColor=#1e293b;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="970" y="160" width="320" height="20" as="geometry"/></mxCell><mxCell id="c13" style="endArrow=open;endFill=0;html=1;rounded=0;strokeColor=#334155;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="230" as="sourcePoint"/><mxPoint x="443" y="230" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c14" value="1: clickGenerateMonthlyReport()" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontStyle=0;fontColor=#1e293b;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="122" y="208" width="320" height="20" as="geometry"/></mxCell><mxCell id="c15" style="endArrow=open;endFill=0;html=1;rounded=0;strokeColor=#334155;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="457" y="280" as="sourcePoint"/><mxPoint x="457" y="302" as="targetPoint"/><Array as="points"><mxPoint x="489" y="280"/><mxPoint x="489" y="302"/></Array></mxGeometry></mxCell><mxCell id="c16" value="2: displayReportForm()" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontStyle=0;fontColor=#1e293b;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="497" y="278" width="330" height="40" as="geometry"/></mxCell><mxCell id="c17" style="endArrow=open;endFill=0;html=1;rounded=0;strokeColor=#334155;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="443" y="332" as="sourcePoint"/><mxPoint x="110" y="332" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c18" value="3: date box (today), no report yet" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontStyle=0;fontColor=#1e293b;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="122" y="310" width="320" height="20" as="geometry"/></mxCell><mxCell id="c19" style="endArrow=open;endFill=0;html=1;rounded=0;strokeColor=#334155;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="382" as="sourcePoint"/><mxPoint x="443" y="382" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c20" value="4: submitDate(selectedDate)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontStyle=0;fontColor=#1e293b;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="122" y="360" width="320" height="20" as="geometry"/></mxCell><mxCell id="c21" style="endArrow=open;endFill=0;html=1;rounded=0;strokeColor=#334155;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="457" y="432" as="sourcePoint"/><mxPoint x="457" y="454" as="targetPoint"/><Array as="points"><mxPoint x="489" y="432"/><mxPoint x="489" y="454"/></Array></mxGeometry></mxCell><mxCell id="c22" value="5: validateDate(selectedDate)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontStyle=0;fontColor=#1e293b;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="497" y="430" width="330" height="40" as="geometry"/></mxCell><mxCell id="c23" style="endArrow=open;endFill=0;html=1;rounded=0;strokeColor=#334155;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="457" y="530" as="sourcePoint"/><mxPoint x="783" y="530" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c24" value="6: generateMonthlyReport(date)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontStyle=0;fontColor=#1e293b;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="462" y="508" width="320" height="20" as="geometry"/></mxCell><mxCell id="c25" style="endArrow=open;endFill=0;html=1;rounded=0;strokeColor=#334155;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="797" y="580" as="sourcePoint"/><mxPoint x="797" y="602" as="targetPoint"/><Array as="points"><mxPoint x="829" y="580"/><mxPoint x="829" y="602"/></Array></mxGeometry></mxCell><mxCell id="c26" value="7: startDate = 1st, endDate = last day of that month" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontStyle=0;fontColor=#1e293b;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="837" y="578" width="330" height="40" as="geometry"/></mxCell><mxCell id="c27" style="endArrow=open;endFill=0;html=1;rounded=0;strokeColor=#334155;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="797" y="632" as="sourcePoint"/><mxPoint x="1123" y="632" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c28" value="8: getCategoryReport(startDate, endDate)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontStyle=0;fontColor=#1e293b;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="802" y="610" width="320" height="20" as="geometry"/></mxCell><mxCell id="c29" style="endArrow=open;endFill=