th="20" height="26" as="geometry"/></mxCell><mxCell id="wd29" value="Generate report" style="rounded=0;whiteSpace=wrap;fillColor=#4a76cc;strokeColor=#4a76cc;fontSize=15;fontStyle=1;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="642" y="410" width="160" height="40" as="geometry"/></mxCell><mxCell id="wd30" value="" style="rounded=0;whiteSpace=wrap;fillColor=#fde8e8;strokeColor=#b42318;" vertex="1" parent="1"><mxGeometry x="300" y="470" width="940" height="44" as="geometry"/></mxCell><mxCell id="wd31" value="Please choose a valid date" style="text;html=0;align=left;verticalAlign=top;fontSize=16;fontStyle=0;fontColor=#b42318;" vertex="1" parent="1"><mxGeometry x="314" y="479" width="244" height="26" as="geometry"/></mxCell><mxCell id="wd32" value="" style="ellipse;fillColor=#ff6b3d;strokeColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1248" y="476" width="32" height="32" as="geometry"/></mxCell><mxCell id="wd33" value="1" style="text;html=0;align=left;verticalAlign=top;fontSize=15;fontStyle=1;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1258" y="481" width="16" height="24" as="geometry"/></mxCell><mxCell id="wd34" value="" style="ellipse;fillColor=#ff6b3d;strokeColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="590" y="370" width="32" height="32" as="geometry"/></mxCell><mxCell id="wd35" value="2" style="text;html=0;align=left;verticalAlign=top;fontSize=15;fontStyle=1;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="600" y="375" width="16" height="24" as="geometry"/></mxCell><mxCell id="wd36" value="" style="rounded=0;whiteSpace=wrap;fillColor=#fffde7;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="16" y="900" width="1268" height="150" as="geometry"/></mxCell><mxCell id="wd37" value="Notes" style="text;html=0;align=left;verticalAlign=top;fontSize=19;fontStyle=1;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="40" y="916" width="62" height="30" as="geometry"/></mxCell><mxCell id="wd38" value="" style="ellipse;fillColor=#ff6b3d;strokeColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="41" y="950" width="32" height="32" as="geometry"/></mxCell><mxCell id="wd39" value="1" style="text;html=0;align=left;verticalAlign=top;fontSize=15;fontStyle=1;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="51" y="955" width="16" height="24" as="geometry"/></mxCell><mxCell id="wd40" value="MSG_INVALID_DATE &quot;Please choose a valid date&quot; when the date isn't a real YYYY-MM-DD date (e.g. 2026-02-30 or 20261105). HTTP 400, no report." style="text;html=0;align=left;verticalAlign=top;fontSize=16;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="86" y="956" width="1184" height="26" as="geometry"/></mxCell><mxCell id="wd41" value="" style="ellipse;fillColor=#ff6b3d;strokeColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="41" y="990" width="32" height="32" as="geometry"/></mxCell><mxCell id="wd42" value="2" style="text;html=0;align=left;verticalAlign=top;fontSize=15;fontStyle=1;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="51" y="995" width="16" height="24" as="geometry"/></mxCell><mxCell id="wd43" value="The form is shown again. A date after today gives MSG_FUTURE_DATE &quot;The date can't be in the future&quot; in the same red box instead." style="text;html=0;align=left;verticalAlign=top;fontSize=16;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="86" y="996" width="1158" height="26" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="5-11367" name="5 BCE Class Diagram"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="2100" pageHeight="898" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1839" value="Entity" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1325" y="88" width="150" height="37" as="geometry"/></mxCell><mxCell id="c1840" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="1325" y="125" width="630" height="733" as="geometry"/></mxCell><mxCell id="c1144" value="Control" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="630" y="88" width="150" height="37" as="geometry"/></mxCell><mxCell id="c1145" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="630" y="125" width="620" height="733" as="geometry"/></mxCell><mxCell id="c569" value="Boundary" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="55" y="88" width="150" height="37" as="geometry"/></mxCell><mxCell id="c570" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="55" y="125" width="500" height="733" as="geometry"/></mxCell><mxCell id="c3" value="B-C-E Class Diagram - UC47 Generate weekly report (US47)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=29;fontStyle=1;fontColor=#1e293b;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="24" y="15" width="2000" height="43" as="geometry"/></mxCell><mxCell id="c4" value="«boundary»&lt;br&gt;GenerateWeeklyReportPage" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="83" y="182" width="444" height="52" as="geometry"/></mxCell><mxCell id="c5" value="-generateWeeklyReportController: GenerateWeeklyReportController&lt;br&gt;-selectedDate: str" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="83" y="234" width="444" height="76" as="geometry"/></mxCell><mxCell id="c6" value="+clickGenerateWeeklyReport()&lt;br&gt;+displayReportForm()&lt;br&gt;+submitDate(selectedDate)&lt;br&gt;+validateDate(selectedDate): str | None&lt;br&gt;+displayReport(report, msg=None)&lt;br&gt;+displayErrorMessage(msg)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="83" y="310" width="444" height="130" as="geometry"/></mxCell><mxCell id="c7" value="submitDate(selectedDate) trims the spaces, then validateDate(selectedDate) returns error: MSG_INVALID_DATE &quot;Please choose a valid date&quot; if it isn't a real YYYY-MM-DD date (checked with datetime.strptime(selectedDate, &quot;%Y-%m-%d&quot;), so 20261105 is rejected), MSG_FUTURE_DATE &quot;The date can't be in the future&quot; if it's after today, else None. error != None -&amp;gt; displayErrorMessage(error) (HTTP 400) and the controller is never called. MSG_NO_ACTIVITY &quot;No IDPs were viewed or saved in this period&quot; is shown with the report when every category has 0 views and 0 saves. The date box (&quot;Any day in the week&quot;) starts on today." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;whiteSpace=wrap;spacing=12;" vertex="1" parent="1"><mxGeometry x="83" y="480" width="444" height="270" as="geometry"/></mxCell><mxCell id="c8" value="«control»&lt;br&gt;GenerateWeeklyReportController" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="658" y="182" width="564" height="52" as="geometry"/></mxCell><mxCell id="c9" value="+generateWeeklyReport(selectedDate): IDPAnalytics" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="658" y="234" width="564" height="40" as="geometry"/></mxCell><mxCell id="c10" value="The controller just calls the entity and returns the report unchanged - one call, no checks and no period maths. Precondition: logged in as a Platform Manager (UC39). managerLoginRequired in app.py only sends someone with no session to /manager/login." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;whiteSpace=wrap;spacing=12;" vertex="1" parent="1"><mxGeometry x="658" y="314" width="564" height="120" as="geometry"/></mxCell><mxCell id="c11" value="«entity»&lt;br&gt;IDPAnalytics" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1353" y="182" width="574" height="52" as="geometry"/></mxCell><mxCell id="c12" value="-idpId: int&lt;br&gt;-title: str&lt;br&gt;-projectType: str (Current / Past)&lt;br&gt;-categoryId: int&lt;br&gt;-categoryName: str&lt;br&gt;-status: str (Active / Suspended)&lt;br&gt;-views: int&lt;br&gt;-saves: int&lt;br&gt;-totalIDPs: int&lt;br&gt;-startDate: date&lt;br&gt;-endDate: date&lt;br&gt;-categories: list[IDPAnalytics]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="1353" y="234" width="574" height="236" as="geometry"/></mxCell><mxCell id="c12m" value="+getWeeklyReport(selectedDate): IDPAnalytics&lt;br&gt;+getCategoryReport(startDate, endDate): list[IDPAnalytics]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="1353" y="470" width="574" height="58" as="geometry"/></mxCell><mxCell id="c13" value="getWeeklyReport(selectedDate) works out the period itself: Monday to Sunday of the week selectedDate is in (a week can cross a month or year end). It calls its own getCategoryReport(startDate, endDate) and returns report, an IDPAnalytics with startDate, endDate and categories. getCategoryReport() returns one IDPAnalytics per category (Active or Suspended) with categoryId, categoryName, status, totalIDPs (its Active IDPs), views and saves between startDate and endDate (local dates, both ends included), ranked by views, then saves, then name. Views come from idp_view (UC32 View IDP), saves from saved_idp (UC33 Save IDP). idpId, title and projectType are only used by the US37 / US38 statistics rows." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;whiteSpace=wrap;spacing=12;" vertex="1" parent="1"><mxGeometry x="1353" y="568" width="574" height="250" as="geometry"/></mxCell><mxCell id="c14" style="endArrow=open;endFill=0;html=1;rounded=0;strokeColor=#334155;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="527" y="262" as="sourcePoint"/><mxPoint x="658" y="262" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c15" value="calls" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontStyle=0;fontColor=#1e293b;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="535" y="236" width="60" height="20" as="geometry"/></mxCell><mxCell id="c16" style="endArrow=open;endFill=0;html=1;rounded=0;strokeColor=#334155;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1222" y="262" as="sourcePoint"/><mxPoint x="1353" y="262" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c17" value="uses" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontStyle=0;fontColor=#1e293b;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1230" y="236" width="90" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="6-78456" name="6 Sequence Diagram"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1510" pageHeight="1468" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="s1" style="endArrow=none;endFill=0;html=1;rounded=0;strokeColor=#334155;strokeWidth=1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="192" as="sourcePoint"/><mxPoint x="110" y="1368" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s2" style="endArrow=none;endFill=0;html=1;rounded=0;strokeColor=#334155;strokeWidth=1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="450" y="192" as="sourcePoint"/><mxPoint x="450" y="1368" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s3" style="endArrow=none;endFill=0;html=1;rounded=0;strokeColor=#334155;strokeWidth=1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="790" y="192" as="sourcePoint"/><mxPoint x="790" y="1368" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s4" style="endArrow=none;endFill=0;html=1;rounded=0;strokeColor=#334155;strokeWidth=1;dashed=1;