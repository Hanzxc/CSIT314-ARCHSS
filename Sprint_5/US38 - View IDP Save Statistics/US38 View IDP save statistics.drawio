: the designer is logged in (UC13). Saves are made by customers in UC33 Save IDP. US37 shows views instead of saves." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontStyle=0;fontColor=#1e293b;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="24" y="470" width="1000" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="5-11367" name="5 BCE Class Diagram"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="2100" pageHeight="620" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1839" value="Entity" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1325" y="88" width="150" height="37" as="geometry"/></mxCell><mxCell id="c1840" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="1325" y="125" width="630" height="455" as="geometry"/></mxCell><mxCell id="c1144" value="Control" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="630" y="88" width="150" height="37" as="geometry"/></mxCell><mxCell id="c1145" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="630" y="125" width="620" height="455" as="geometry"/></mxCell><mxCell id="c569" value="Boundary" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="55" y="88" width="150" height="37" as="geometry"/></mxCell><mxCell id="c570" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="55" y="125" width="500" height="455" as="geometry"/></mxCell><mxCell id="c3" value="B-C-E Class Diagram - UC38 View IDP save statistics (US38)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=29;fontStyle=1;fontColor=#1e293b;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="24" y="15" width="2000" height="43" as="geometry"/></mxCell><mxCell id="c4" value="«boundary»&lt;br&gt;ViewIDPSaveStatisticsPage" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="83" y="182" width="444" height="52" as="geometry"/></mxCell><mxCell id="c5" value="-viewIDPSaveStatisticsController: ViewIDPSaveStatisticsController" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="83" y="234" width="444" height="64" as="geometry"/></mxCell><mxCell id="c6" value="+clickViewIDPSaves()&lt;br&gt;+displayStatistics(statistics)&lt;br&gt;+displayNoIDPsMessage(msg)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="83" y="298" width="444" height="88" as="geometry"/></mxCell><mxCell id="c7" value="The designer id is always session[&quot;userId&quot;], never a request field, so a designer only ever sees their own IDPs. No IDPs -&gt; MSG_NO_IDPS instead of the table." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;whiteSpace=wrap;spacing=12;" vertex="1" parent="1"><mxGeometry x="83" y="426" width="444" height="114" as="geometry"/></mxCell><mxCell id="c8" value="«control»&lt;br&gt;ViewIDPSaveStatisticsController" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="658" y="182" width="564" height="52" as="geometry"/></mxCell><mxCell id="c9" value="+getSaveStatistics(designerId): list" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="658" y="234" width="564" height="40" as="geometry"/></mxCell><mxCell id="c10" value="The controller just asks the entity - no checks. Precondition: the designer is already logged in (UC13), so this use case doesn&#x27;t check the designer again - no InteriorDesignerLoginController (lecturer feedback, same as UC20)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;whiteSpace=wrap;spacing=12;" vertex="1" parent="1"><mxGeometry x="658" y="324" width="564" height="114" as="geometry"/></mxCell><mxCell id="c11" value="«entity»&lt;br&gt;IDPAnalytics" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=15;fontColor=#1e293b;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1353" y="182" width="574" height="52" as="geometry"/></mxCell><mxCell id="c12" value="+getSaveStatistics(designerId): list" style="rounded=0;whiteSpace=wrap;