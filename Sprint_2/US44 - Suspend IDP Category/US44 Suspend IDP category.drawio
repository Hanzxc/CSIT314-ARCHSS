tSize=13;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="120" y="1353" width="336" height="22" as="geometry" /></mxCell><mxCell id="92" value="17: displayErrorMessage(MSG_CANNOT_SUSPEND)" style="text;html=0;align=left;verticalAlign=top;fontSize=14;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="510" y="1479" width="361.8" height="23" as="geometry" /></mxCell><mxCell id="93" value="18: HTTP 302 → /manager/categories/&lt;categoryId&gt;" style="text;html=0;align=left;verticalAlign=top;fontSize=13;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="120" y="1515" width="336" height="22" as="geometry" /></mxCell><mxCell id="94" value="19: cancelSuspend()" style="text;html=0;align=left;verticalAlign=top;fontSize=13;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="120" y="1641" width="336" height="22" as="geometry" /></mxCell><mxCell id="95" value="20: closeConfirmation()" style="text;html=0;align=left;verticalAlign=top;fontSize=14;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="510" y="1721" width="174.48" height="23" as="geometry" /></mxCell><mxCell id="96" value="21: HTTP 302 → /manager/categories/&lt;categoryId&gt;" style="text;html=0;align=left;verticalAlign=top;fontSize=13;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="120" y="1757" width="336" height="22" as="geometry" /></mxCell><mxCell id="97" value="only an Active category is changed to&#10;Suspended - already suspended or no such&#10;id gives back False" style="text;html=0;align=left;verticalAlign=top;fontSize=12;fontStyle=0;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="1496" y="1077" width="254.16" height="52" as="geometry" /></mxCell><mxCell id="98" value="MSG_SUSPENDED = &quot;IDP category suspended successfully&quot;, MSG_CANNOT_SUSPEND = &quot;This IDP category cannot be suspended&quot;. The details page (US42) shows the flashed message after each redirect.&#10;The category for the box comes from US42's controller (borrowed). The page doesn't call isActive() first - the entity only suspends an Active row.&#10;Precondition: logged in as a Platform Manager (UC39). managerLoginRequired in app.py only sends someone with no session to /manager/login." style="text;html=0;align=left;verticalAlign=top;fontSize=14;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="30" y="1897" width="1740.16" height="64" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>