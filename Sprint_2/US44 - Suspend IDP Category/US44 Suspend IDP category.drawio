;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="1367" y="190" width="546" height="56" as="geometry" /></mxCell><mxCell id="33" value="-categoryId: int&#10;-categoryName: str (unique, 3-50 chars)&#10;-description: str (max 500)&#10;-status: str (Active / Suspended)&#10;-createdDate: str" style="text;html=0;align=left;verticalAlign=top;fontSize=16;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="1366" y="262" width="546" height="114" as="geometry" /></mxCell><mxCell id="34" value="" style="endArrow=none;html=0;dashed=0;strokeColor=#334155;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1353" y="384" as="sourcePoint" /><mxPoint x="1927" y="384" as="targetPoint" /></mxGeometry></mxCell><mxCell id="35" value="+getIDPCategory(categoryId): IDPCategory | None&#10;+suspendIDPCategory(categoryId): bool" style="text;html=0;align=left;verticalAlign=top;fontSize=16;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="1366" y="394" width="546" height="48" as="geometry" /></mxCell><mxCell id="36" value="" style="rounded=0;whiteSpace=wrap;fillColor=#fff9c4;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="1353" y="524" width="574" height="110" as="geometry" /></mxCell><mxCell id="37" value="suspendIDPCategory() only changes an Active row to&#10;Suspended, so a missing or already suspended category&#10;returns False. The IDPs in it are kept." style="text;html=0;align=left;verticalAlign=top;fontSize=17;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="1371" y="542" width="538" height="76" as="geometry" /></mxCell><mxCell id="38" value="" style="endArrow=open;html=0;dashed=0;strokeColor=#334155;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="527" y="252" as="sourcePoint" /><mxPoint x="658" y="252" as="targetPoint" /></mxGeometry></mxCell><mxCell id="39" value="calls" style="text;html=0;align=left;verticalAlign=top;fontSize=12;fontStyle=0;fontColor=#1e293b;" verte