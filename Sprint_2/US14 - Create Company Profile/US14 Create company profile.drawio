very field (required,&lt;br&gt;max length, email format). The page trims&lt;br&gt;the input and puts it in a CompanyProfile&lt;br&gt;object (owner = session userId)." style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#FFF9C4;strokeColor=#B8A100;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=4;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="375" width="412.9" height="75.2" as="geometry" /></mxCell><mxCell id="b8" value="&lt;b&gt;Control&lt;/b&gt;" style="shape=folder;tabWidth=80;tabHeight=20;tabPosition=left;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=0;fillColor=none;fontSize=12;strokeColor=#777777;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="572.9" y="50" width="389.6" height="466.2" as="geometry" /></mxCell><mxCell id="b9" value="«control»&lt;br&gt;&lt;b&gt;CreateCompanyProfileController&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fontSize=11;fillColor=#FFF3E0;strokeColor=#E65100;swimlaneFillColor=#FFFFFF;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="592.9" y="100" width="349.6" height="72" as="geometry" /></mxCell><mxCell id="b10" value="+hasCompanyProfile(designerId): bool&lt;br&gt;+createCompanyProfile(companyProfile): bool" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=nowrap;html=1;fontSize=11;fontColor=#000000;" vertex="1" parent="b9"><mxGeometry x="0" y="40" width="349.6" height="32" as="geometry" /></mxCell><mxCell id="b11" value="The controller just calls create - no checks.&lt;br&gt;&lt;br&gt;Precondition: the designer is already logged in&lt;br&gt;(UC13), so this use case doesn&#x27;t check the&lt;br&gt;designer again - no InteriorDesignerLoginController." style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#FFF9C4;strokeColor=#B8A100;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=4;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="592.9" y="242" width="349.6" height="90.5" as="geometry" /></mxCell><mxCell id="b12" value="&lt;b&gt;Entity&lt;/b&gt;" style="shape=folder;tabWidth=80;tabHeight=20;tabPosition=left;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=0;fillColor=none;fontSize=12;strokeColor=#777777;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1042.5" y="50" width="389.9" height="466.2" as="geometry" /></mxCell><mxCell id="b13" value="«entity»&lt;br&gt;&lt;b&gt;CompanyProfile&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fontSize=11;fillColor=#E8F5E9;strokeColor=#2E7D32;swimlaneFillColor=#FFFFFF;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1062.5" y="100" width="349.9" height="251" as="geometry" /></mxCell><mxCell id="b14" value="-companyId: int&lt;br&gt;-designerId: int (unique owner)&lt;br&gt;-companyName: String&lt;br&gt;-description: String&lt;br&gt;-services: String&lt;br&gt;-email: String&lt;br&gt;-phone: String&lt;br&gt;-address: String&lt;br&gt;-createdDate: String&lt;br&gt;-status: String&lt;br&gt;-revision: int" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=nowrap;html=1;fontSize=11;fontColor=#000000;" vertex="1" parent="b13"><mxGeometry x="0" y="40" width="349.9" height="171" as="geometry" /></mxCell><mxCell id="b15" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosi