agram - UC41 Create IDP category (US41)" style="text;html=0;align=left;verticalAlign=top;fontSize=26;fontStyle=1;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="22" y="17" width="1650" height="39" as="geometry" /></mxCell><mxCell id="3" value="GET then POST /manager/categories/create. The page trims the input and puts it in an IDPCategory object." style="text;html=0;align=left;verticalAlign=top;fontSize=14;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="22" y="62" width="777.6" height="23" as="geometry" /></mxCell><mxCell id="4" value="" style="endArrow=none;html=0;dashed=1;strokeColor=#334155;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="225" as="sourcePoint" /><mxPoint x="110" y="1643" as="targetPoint" /></mxGeometry></mxCell><mxCell id="5" value="" style="endArrow=none;html=0;dashed=1;strokeColor=#334155;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="440" y="225" as="sourcePoint" /><mxPoint x="440" y="1643" as="targetPoint" /></mxGeometry></mxCell><mxCell id="6" value="" style="endArrow=none;html=0;dashed=1;strokeColor=#334155;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="840" y="225" as="sourcePoint" /><mxPoint x="840" y="1643" as="targetPoint" /></mxGeometry></mxCell><mxCell id="7" value="" style="endArrow=none;html=0;dashed=1;strokeColor=#334155;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1220" y="225" as="sourcePoint" /><mxPoint x="1220" y="1643" as="targetPoint" /></mxGeometry></mxCell><mxCell id="8" value="" style="ellipse;fillColor=#ffffff;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="98" y="108" width="24" height="24" as="geometry" /></mxCell><mxCell id="9" value="" style="endArrow=none;html=0;dashed=0;strokeColor=#334155;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="132" as="sourcePoint" /><mxPoint x="110" y="165" as="targetPoint" /></mxGeometry></mxCell><mxCell 