l><mxCell id="17" value="+clickCreateIDPCategory()&#10;+displayCreateForm(msg=None)&#10;+validateInput(idpCategory): bool&#10;+submitIDPCategory(categoryName, description)&#10;+displaySuccessMessage(msg)&#10;+displayErrorMessage(msg)" style="text;html=0;align=left;verticalAlign=top;fontSize=16;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="96" y="372" width="416" height="136" as="geometry" /></mxCell><mxCell id="18" value="" style="rounded=0;whiteSpace=wrap;fillColor=#fff9c4;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="83" y="590" width="444" height="128" as="geometry" /></mxCell><mxCell id="19" value="submitIDPCategory() trims the spaces and builds&#10;idpCategory = IDPCategory(categoryName,&#10;description). validateInput(idpCategory) checks&#10;the field rules (getFieldErrors())." style="text;html=0;align=left;verticalAlign=top;fontSize=17;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="101" y="608" width="408" height="98" as="geometry" /></mxCell><mxCell id="20" value="" style="rounded=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="658" y="182" width="564" height="118" as="geometry" /></mxCell><mxCell id="21" value="" style="rounded=0;whiteSpace=wrap;fillColor=#fff3e0;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="658" y="182" width="564" height="70" as="geometry" /></mxCell><mxCell id="22" value="«control»&#10;CreateIDPCategoryController" style="text;html=0;align=left;verticalAlign=top;fontSize=19;fontStyle=1;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="672" y="190" width="536" height="56" as="geometry" /></mxCell><mxCell id="23" value="+createIDPCategory(idpCategory): bool" style="text;html=0;align=left;verticalAlign=top;fontSize=16;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="671" y="262" width="536" height="26" as="geometry" /></mxCell><mxCell id="24" value="" style="rounded=0;whiteSpace=wrap;fillColor=#fff9c4;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="658" y="370" width="564" height="134" as="geometry" /></mxCell><mxCell id="25" value="The controller just calls the entity and returns the&#10;result - no checks. Precondition: logged in as a&#10;Platform Manager (UC39). managerLoginRequired in app.py&#10;only sends someone with no session to /manager/login." style="text;html=0;align=left;verticalAlign=top;fontSize=17;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="676" y="388" width="528" height="100" as="geometry" /></mxCell><mxCell id="26" value="" style="rounded=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="1353" y="182" width="574" height="296" as="geometry" /></mxCell><mxCell id="27" value="" style="rounded=0;whiteSpace=wrap;fillColor=#e8f5e9;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="1353" y="182" width="574" height="70" as="geometry" /></mxCell><mxCell id="28" value="«entity»&#10;IDPCategory" style="text;html=0;align=left;verticalAlign=top;fontSize=19;fontStyle=1;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="1367" y="190" width="546" height="56" as="geometry" /></mxCell><mxCell id="29" value="-categoryId: int&#10;-categoryName: str (unique, 3-50 chars)&#10;-description: str (max 500)&#10;-status: str (Active / Suspended)&#10;-createdDate: str" style="text;html=0;align=left;verticalAlign=top;fontSize=16;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="1366" y="262" width="546" height="114" as="geometry" /></mxCell><mxCell id="30" value="" style="endArrow=none;html=0;dashed=0;strokeColor=#334155;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1353" y="384" as="sourcePoint" /><mxPoint x="1927" y="384" as="targetPoint" /></mxGeometry></mxCell><mxCell id="31" value="+IDPCategory(categoryId=None, categoryName=&quot;&quot;, description=&quot;&quot;)&#10;+isCategoryNameTaken(categoryName, categoryId=None): bool&#10;