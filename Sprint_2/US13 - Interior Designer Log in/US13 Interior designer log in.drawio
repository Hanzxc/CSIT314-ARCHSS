    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1403" pageHeight="741" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="b1" value="&lt;b&gt;B-C-E Class Diagram - UC13 Interior designer log in (US13)&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=15;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="433" height="24" as="geometry" /></mxCell><mxCell id="b2" value="&lt;b&gt;Boundary&lt;/b&gt;" style="shape=folder;tabWidth=80;tabHeight=20;tabPosition=left;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=0;fillColor=none;fontSize=12;strokeColor=#777777;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="375" height="671" as="geometry" /></mxCell><mxCell id="b3" value="«boundary»&lt;br&gt;&lt;b&gt;InteriorDesignerLoginPage&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fontSize=11;fillColor=#E3F2FD;strokeColor=#1565C0;swimlaneFillColor=#FFFFFF;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="100" width="335" height="183" as="geometry" /></mxCell><mxCell id="b4" value="-interiorDesignerLoginController: InteriorDesignerLoginController" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=nowrap;html=1;fontSize=11;fontColor=#000000;" vertex="1" parent="b3"><mxGeometry x="0" y="40" width="335" height="28" as="geometry" /></mxCell><mxCell id="b5" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=#1565C0;fontColor=#000000;" vertex="1" parent="b3"><mxGeometry x="0" y="68" width="335" height="8" as="geometry" /></mxCell><mxCell id="b6" value="+openLoginPage()&lt;br&gt;+displayLoginForm()&lt;br&gt;+submitLogin(username, password)&lt;br&gt;+validateInput(username, password): bool&lt;br&gt;+redirectToDashboard(account)&lt;br&gt;+displayErrorMessage(msg)&lt;br&gt;+openDashboard()" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=nowrap;html=1;fontSize=11;fontColor=#000000;" vertex="1" parent="b3"><mxGeometry x="0" y="76" width="335" height="107" as="geometry" /></mxCell><mxCell id="b7" value="validateInput() checks that both fields are filled in.&lt;br&gt;The page trims the spaces from the username&lt;br&gt;before it calls login().&lt;br&gt;redirectToDashboard() starts a new session&lt;br&gt;(userId, profileId, username).&lt;br&gt;openDashboard() just renders the dashboard - it&lt;br&gt;doesn't check the role again (designerLoginRequired&lt;br&gt;in app.py only sends someone with no session to&lt;br&gt;/designer/login). It borrows US15's and US17-R's&lt;br&gt;controllers to show View, Restore or Create&lt;br&gt;company profile." style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#FFF9C4;strokeColor=#B8A100;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=4;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="343" width="335" height="172" as="geometry" /></mxCell><mxCell id="b8" value="&lt;b&gt;Control&lt;/b&gt;" style="shape=folder;tabWidth=80;tabHeight=20;tabPosition=left;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=0;fillColor=none;fontSize=12;strokeColor=#777777;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="495" y="50" width="394" height="671" as="geometry" /></mxCell><mxCell id="b9" value="«control»&lt;br&gt;&lt;b&gt;InteriorDesignerLoginController&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fontSize=11;fillColor=#FFF3E0;strokeColor=#E65100;swimlaneFillColor=#FFFFFF;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="515" y="100" width="354" height="68" as="geometry" /></mxCell><mxCell id="b10" value="+login(username, password): UserAccount | None" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=nowrap;html=1;fontSize=11;fontColor=#000000;" vertex="1" parent="b9"><mxGeometry x="0" y="40" width="354" height="28" as="geometry" /></mxCell><mxCell id="b11" value="«control» (from US15)&lt;br&gt;&lt;b&gt;ViewCompanyProfileController&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fontSize=11;fillColor=#FFF3E0;strokeColor=#E65100;swimlaneFillColor=#FFFFFF;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="515" y="228" width="354" height="68" as="geometry" /></mxCell><mxCell id="b12" value="+viewCompanyProfile(designerId): CompanyProfile | None" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=nowrap;html=1;fontSize=11;fontColor=#000000;" vertex="1" parent="b11"><mxGeometry x="0" y="40" width="354" height="28" as="geometry" /></mxCell><mxCell id="b13" value="«control» (from US17-R)&lt;br&gt;&lt;b&gt;RestoreCompanyProfileController&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fontSize=11;fillColor=#FFF3E0;strokeColor=#E65100;swimlaneFillColor=#FFFFFF;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="515" y="356" width="354" height="68" as="geometry" /></mxCell><mxCell id="b14" value="+getSuspendedCompanyProfile(designerId): CompanyProfile | None" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=nowrap;html=1;fontSize=11;fontColor=#000000;" vertex="1" parent="b13"><mxGeometry x="0" y="40" width="354" height="28" as="geometry" /></mxCell><mxCell id="b15" value="login() makes one call and returns the result:&lt;br&gt;UserAccount().verifyCredentials(username,&lt;br&gt;password, REQUIRED_DESIGNER_PERMISSIONS)&lt;br&gt;REQUIRED_DESIGNER_PERMISSIONS =&lt;br&gt;{&quot;Manage company profile&quot;, &quot;Manage own IDPs&quot;}&lt;br&gt;Precondition: the account exists and is not&lt;br&gt;logged in. Checking the role here is allowed -&lt;br&gt;logging in is the use case itself." style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#FFF9C4;strokeColor=#B8A100;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=4;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="515" y="484" width="354" height="130" as="geometry" /></mxCell><mxCell id="b16" value="&lt;b&gt;Entity&lt;/b&gt;" style="shape=folder;tabWidth=80;tabHeight=20;tabPosition=left;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=0;fillColor=none;fontSize=12;strokeColor=#777777;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="969" y="50" width="394" height="671" as="geometry" /></mxCell><mxCell id="b17" value="«entity»&lt;br&gt;&lt;b&gt;UserAccount&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fontSize=11;fillColor=#E8F5E9;strokeColor=#2E7D32;swimlaneFillColor=#FFFFFF;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="989" y="100" width="354" height="223" as="geometry" /></mxCell><mxCell id="b18" value="-userId: int&lt;br&gt;-username: String&lt;br&gt;-password: String (hash)&lt;br&gt;-fullName: String&lt;br&gt;-email: String&lt;br&gt;-phone: String&lt;br&gt;-profileId: int&lt;br&gt;-status: String&lt;br&gt;-createdDate: Date" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=nowrap;html=1;fontSize=11;fontColor=#000000;" vertex="1" parent="b17"><mxGeometry x="0" y="40" width="354" height="134" as="geometry" /></mxCell><mxCell id="b19" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=#2E7D32;fontColor=#000000;" vertex="1" parent="b17"><mxGeometry x="0" y="174" width="354" height="8" as="geometry" /></mxCell><mxCell id="b20" value="+verifyCredentials(username, password,&lt;br&gt;      requiredPermissions): UserAccount | None" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=nowrap;html=1;fontSize=11;fontColor=#000000;" vertex="1" parent="b17"><mxGeometry x="0" y="182" width="354" height="41" as="geometry" /></mxCell><mxCell id="b21" value="«entity»&lt;br&gt;&lt;b&gt;CompanyProfile&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fontSize=11;fillColor=#E8F5E9;strokeColor=#2E7D32;swimlaneFillColor=#FFFFFF;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="989" y="383" width="354" height="170" as="geometry" /></mxCell><mxCell id="b22" value="-companyId: int&lt;br&gt;-designerId: int&lt;br&gt;-companyName: String&lt;br&gt;-status: String&lt;br&gt;-revision: int" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=nowrap;html=1;fontSize=11;fontColor=#000000;" vertex="1" parent="b21"><mxGeometry x="0" y="40" width="354" height="81" as="geometry" /></mxCell><mxCell id="b23" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=#2E7D32;fontColor=#000000;" vertex="1" parent="b21"><mxGeometry x="0" y="121" width="354" height="8" as="geometry" /></mxCell><mxCell id="b24" value="+getCompanyProfile(designerId): CompanyProfile | None&lt;br&gt;+getSuspendedCompanyProfile(designerId): CompanyProfile | None" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=nowrap;html=1;fontSize=11;fontColor=#000000;" vertex="1" parent="b21"><mxGeometry x="0" y="129" width="354" height="41" as="geometry" /></mxCell><mxCell id="b25" value="verifyCredentials() returns the account only if the&lt;br&gt;password hash matches, the account is Active, its&lt;br&gt;user profile is Active and that profile has every&lt;br&gt;permission in requiredPermissions - otherwise None.&lt;br&gt;It reads the account's user_profile row itself." style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#FFF9C4;strokeColor=#B8A100;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=4;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="989" y="613" width="354" height="88" as="geometry" /></mxCell><mxCell id="b26" value="calls" style="endArrow=open;endFill=0;endSize=10;html=1;rounded=0;fontSize=10;fontColor=#000000;strokeColor=#000000;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="b3" target="b9"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="b27" value="uses" style="endArrow=open;endFill=0;dashed=1;html=1;rounded=0;fontSize=10;fontColor=#000000;strokeColor=#000000;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="b9" target="b17"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="b28" value="calls (dashboard)" style="endArrow=open;endFill=0;endSize=10;html=1;rounded=0;fontSize=10;fontColor=#000000;strokeColor=#000000;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="b3" target="b11"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="b29" value="calls (dashboard)" style="endArrow=open;endFill=0;endSize=10;html=1;rounded=0;fontSize=10;fontColor=#000000;strokeColor=#000000;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="b3" target="b13"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="b30" value="uses" style="endArrow=open;endFill=0;dashed=1;html=1;rounded=0;fontSize=10;fontColor=#000000;strokeColor=#000000;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="b11" target="b21"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="b31" value="uses" style="endArrow=open;endFill=0;dashed=1;html=1;rounded=0;fontSize=10;fontColor=#000000;strokeColor=#000000;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="b13" target="b21"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel>
