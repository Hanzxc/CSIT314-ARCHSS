rent="1"><mxGeometry x="510" y="1959" width="324.84" height="23" as="geometry" /></mxCell><mxCell id="98" value="23: form with field errors" style="text;html=0;align=left;verticalAlign=top;fontSize=13;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="120" y="1995" width="336" height="22" as="geometry" /></mxCell><mxCell id="99" value="Cancel is a plain link back to the details page -&#10;nothing is sent or changed (alternative flow 3a)" style="text;html=0;align=left;verticalAlign=top;fontSize=12;fontStyle=0;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="514" y="625" width="289.92" height="36" as="geometry" /></mxCell><mxCell id="100" value="the page trims the spaces first" style="text;html=0;align=left;verticalAlign=top;fontSize=12;fontStyle=0;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="514" y="1023" width="198.24" height="20" as="geometry" /></mxCell><mxCell id="101" value="saves the name and description -&#10;the status is not changed" style="text;html=0;align=left;verticalAlign=top;fontSize=12;fontStyle=0;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="1264" y="1361" width="204.72" height="36" as="geometry" /></mxCell><mxCell id="102" value="MSG_UPDATED = &quot;IDP category updated successfully&quot;, MSG_FIX_FIELDS = &quot;Please fix the highlighted fields&quot;, MSG_CANNOT_UPDATE = &quot;This IDP category could not be updated - the name is already used or the category is suspended&quot;.&#10;The entity only updates an Active row whose new name isn't used by a different category, so a suspended or missing category also gives updated == False (the status is never changed).&#10;Precondition: logged in as a Platform Manager (UC39). managerLoginRequired in app.py only sends someone with no session to /manager/login." style="text;html=0;align=left;verticalAlign=top;fontSize=14;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="30" y="2135" width="1828.72" height="64" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>