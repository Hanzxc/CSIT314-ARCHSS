"134" as="sourcePoint" /><mxPoint x="410" y="134" as="targetPoint" /></mxGeometry></mxCell><mxCell id="16" value=":PlatformManagerLogoutPage" style="text;html=0;align=center;verticalAlign=top;fontSize=14;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="327.8" y="200" width="224.4" height="23" as="geometry" /></mxCell><mxCell id="17" value="" style="ellipse;fillColor=#fff3e0;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="811" y="105" width="58" height="58" as="geometry" /></mxCell><mxCell id="18" value="" style="endArrow=none;html=0;dashed=0;strokeColor=#334155;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="842" y="105" as="sourcePoint" /><mxPoint x="854" y="97" as="targetPoint" /></mxGeometry></mxCell><mxCell id="19" value="" style="endArrow=none;html=0;dashed=0;strokeColor=#334155;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="842" y="105" as="sourcePoint" /><mxPoint x="852" y="112" as="targetPoint" /></mxGeometry></mxCell><mxCell id="20" value=":PlatformManagerLogoutController" style="text;html=0;align=center;verticalAlign=top;fontSize=14;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="708.2" y="200" width="263.6" height="23" as="geometry" /></mxCell><mxCell id="21" value="" style="rounded=0;whiteSpace=wrap;fillColor=none;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="36" y="425" width="984" height="326" as="geometry" /></mxCell><mxCell id="22" value="" style="endArrow=none;html=0;dashed=0;strokeColor=#334155;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="36" y="454" as="sourcePoint" /><mxPoint x="100" y="425" as="targetPoint" /><Array as="points"><mxPoint x="88" y="454" /><mxPoint x="100" y="443" /></Array></mxGeometry></mxCell><mxCell id="23" value="alt" style="text;html=0;align=left;verticalAlign=top;fontSize=14;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="44" y="431" width="30" height="23" as="geometry" /></mxCell><mxCell id="24" value="" style="endArrow=none;html=0;dashed=1;strokeColor=#334155;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="36" y="589" as="sourcePoint" /><mxPoint x="1020" y="589" as="targetPoint" /></mxGeometry></mxCell><mxCell id="25" value="[loggedOut == True]" style="text;html=0;align=left;verticalAlign=top;fontSize=14;fontStyle=1;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="120" y="431" width="154.96" height="23" as="geometry" /></mxCell><mxCell id="26" value="[loggedOut == False]" style="text;html=0;align=left;verticalAlign=top;fontSize=14;fontStyle=1;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="120" y="597" width="159.44" height="23" as="geometry" /></mxCell><mxCell id="27" value="" style="rounded=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="833" y="313" width="14" height="78" as="geometry" /></mxCell><mxCell id="28" value="" style="rounded=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="433" y="255" width="14" height="460" as="geometry" /></mxCell><mxCell id="29" value="" style="endArrow=open;html=0;dashed=0;strokeColor=#334155;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="265" as="sourcePoint" /><mxPoint x="440" y="265" as="targetPoint" /></mxGeometry></mxCell><mxCell id="30" value="" style="endArrow=open;html=0;dashed=0;strokeColor=#334155;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="440" y="323" as="sourcePoint" /><mxPoint x="840" y="323" as="targetPoint" /></mxGeometry></mxCell><mxCell id="31" value="" style="endArrow=open;html=0;dashed=1;strokeColor=#334155;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="840" y="391" as="sourcePoint" /><mxPoint x="440" y="391" as="targetPoint" /></mxGeometry></mxCell><mxCell id="32" value="" style="endArrow=open;html=0;dashed=0;strokeColor=#334155;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="446" y="491" as="sourcePoint" /><mxPoint x="446" y="515" as="targetPoint" /><Array as="points"><mxPoint x="482" y="491" /><mxPoint x="482" y="515" /></Array></mxGeometry></mxCell><mxCell id="33" value="" style="endArrow=open;html=0;dashed=1;strokeColor=#334155;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="440" y="553" as="sourcePoint" /><mxPoint x="110" y="553" as="targetPoint" /></mxGeometry></mxCell><mxCell id="34" value="" style="endArrow=open;html=0;dashed=0;strokeColor=#334155;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="446" y="653" as="sourcePoint" /><mxPoint x="446" y="677" as="targetPoint" /><Array as="points"><mxPoint x="482" y="653" /><mxPoint x="482" y="677" /></Array></mxGeometry></mxCell><mxCell id="35" value="" style="endArrow=open;html=0;dashed=1;strokeColor=#334155;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="440" y="715" as="sourcePoint" /><mxPoint x="110" y="715" as="targetPoint" /></mxGeometry></mxCell><mxCell id="36" value="1: clickLogout()" style="text;html=0;align=left;verticalAlign=top;fontSize=13;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="120" y="241" width="316" height="22" as="geometry" /></mxCell><mxCell id="37" value="2: logout()" style="text;html=0;align=left;verticalAlign=top;fontSize=13;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="450" y="299" width="386" height="22" as="geometry" /></mxCell><mxCell id="38" value="3: loggedOut" style="text;html=0;align=left;verticalAlign=top;fontSize=13;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="450" y="367" width="386" height="22" as="geometry" /></mxCell><mxCell id="39" value="4: displayLoginPage(MSG_LOGGED_OUT)" style="text;html=0;align=left;verticalAlign=top;fontSize=14;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="490" y="493" width="288.72" height="23" as="geometry" /></mxCell><mxCell id="40" value="5: HTTP 302 → /manager/login" style="text;html=0;align=left;verticalAlign=top;fontSize=13;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="120" y="529" width="316" height="22" as="geometry" /></mxCell><mxCell id="41" value="6: displayLoginPage(MSG_SESSION_ENDED)" style="text;html=0;align=left;verticalAlign=top;fontSize=14;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="490" y="655" width="316.44" height="23" as="geometry" /></mxCell><mxCell id="42" value="7: HTTP 302 → /manager/login" style="text;html=0;align=left;verticalAlign=top;fontSize=13;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="120" y="691" width="316" height="22" as="geometry" /></mxCell><mxCell id="43" value="loggedOut = &quot;userId&quot; in session&#10;session.clear() - ends the session, so it can't be used again" style="text;html=0;align=left;verticalAlign=top;fontSize=12;fontStyle=0;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="856" y="327" width="354.48" height="36" as="geometry" /></mxCell><mxCell id="44" value="MSG_LOGGED_OUT = &quot;You have logged out successfully&quot; (wireframe 4b), MSG_SESSION_ENDED = &quot;Your session has already ended&quot; (wireframe 4c).&#10;displayLoginPage(msg) flashes the message and redirects; the manager login page (US39) shows it once. The controller does its own work - it doesn't call the US2 LogoutController.&#10;Precondition: none is enforced - /manager/logout has no decorator in app.py, so a log out with no session just shows MSG_SESSION_ENDED." style="text;html=0;align=left;verticalAlign=top;fontSize=14;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="30" y="831" width="1000" height="64" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>