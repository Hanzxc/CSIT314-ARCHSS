rap;fillColor=#ffffff;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="1325" y="88" width="152" height="37" as="geometry" /></mxCell><mxCell id="5" value="Entity" style="text;html=0;align=left;verticalAlign=top;fontSize=15;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="1335" y="100" width="136" height="22" as="geometry" /></mxCell><mxCell id="6" value="" style="rounded=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="630" y="125" width="620" height="718" as="geometry" /></mxCell><mxCell id="7" value="" style="rounded=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="630" y="88" width="152" height="37" as="geometry" /></mxCell><mxCell id="8" value="Control" style="text;html=0;align=left;verticalAlign=top;fontSize=15;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="640" y="100" width="136" height="22" as="geometry" /></mxCell><mxCell id="9" value="" style="rounded=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="55" y="125" width="500" height="718" as="geometry" /></mxCell><mxCell id="10" value="" style="rounded=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="55" y="88" width="152" height="37" as="geometry" /></mxCell><mxCell id="11" value="Boundary" style="text;html=0;align=left;verticalAlign=top;fontSize=15;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="65" y="100" width="136" height="22" as="geometry" /></mxCell><mxCell id="12" value="" style="rounded=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="83" y="182" width="444" height="206" as="geometry" /></mxCell><mxCell id="13" value="" style="rounded=0;whiteSpace=wrap;fillColor=#e3f2fd;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="83" y="182" width="444" height="70" as="geometry" /></mxCell><mxCell id="14" value="«boundary»&#10;PlatformManagerLogoutPage" style="text;html=0;align=left;verticalAlign=top;fontSize=19;fontStyle=1;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="97" y="190" width="416" height="56" as="geometry" /></mxCell><mxCell id="15" value="-platformManagerLogoutController:&#10; PlatformManagerLogoutController" style="text;html=0;align=left;verticalAlign=top;fontSize=16;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="96" y="262" width="416" height="48" as="geometry" /></mxCell><mxCell id="16" value="" style="endArrow=none;html=0;dashed=0;strokeColor=#334155;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="83" y="318" as="sourcePoint" /><mxPoint x="527" y="318" as="targetPoint" /></mxGeometry></mxCell><mxCell id="17" value="+clickLogout()&#10;+displayLoginPage(msg)" style="text;html=0;align=left;verticalAlign=top;fontSize=16;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="96" y="328" width="416" height="48" as="geometry" /></mxCell><mxCell id="18" value="" style="rounded=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="658" y="182" width="564" height="118" as="geometry" /></mxCell><mxCell id="19" value="" style="rounded=0;whiteSpace=wrap;fillColor=#fff3e0;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="658" y="182" width="564" height="70" as="geometry" /></mxCell><mxCell id="20" value="«control»&#10;PlatformManagerLogoutController" style="text;html=0;align=left;verticalAlign=top;fontSize=19;fontStyle=1;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="672" y="190" width="536" height="56" as="geometry" /></mxCell><mxCell id="21" value="+logout(): bool" style="text;html=0;align=left;verticalAlign=top;fontSize=16;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="671" y="262" width="536" height="26" as="geometry" /></mxCell><mxCell id="26" value="" style="rounded=0;whiteSpace=wrap;fillColor=#fff9c4;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="658" y="340" width="564" height="150" as="geometry" /></mxCell><mxCell id="27" value="logout() notes whether someone was logged in&#10;(loggedOut = &quot;userId&quot; in session), clears the&#10;session (session.clear()) and returns loggedOut -&#10;True if a session was ended, False if it had already&#10;ended. It does its own work - no other controller." style="text;html=0;align=left;verticalAlign=top;fontSize=17;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="676" y="358" width="528" height="120" as="geometry" /></mxCell><mxCell id="28" value="" style="rounded=0;whiteSpace=wrap;fillColor=#fff9c4;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="1353" y="182" width="574" height="124" as="geometry" /></mxCell><mxCell id="29" value="No entity class is needed for log out. Logging out&#10;does not read or change any saved data - the&#10;controller only ends the session that was started&#10;at log in (UC39)." style="text;html=0;align=left;verticalAlign=top;fontSize=17;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="1371" y="200" width="538" height="100" as="geometry" /></mxCell><mxCell id="31" value="" style="endArrow=open;html=0;dashed=0;strokeColor=#334155;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="527" y="252" as="sourcePoint" /><mxPoint x="658" y="252" as="targetPoint" /></mxGeometry></mxCell><mxCell id="32" value="calls" style="text;html=0;align=left;verticalAlign=top;fontSize=12;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="531" y="230" width="33" height="20" as="geometry" /></mxCell><mxCell id="33" value="" style="rounded=0;whiteSpace=wrap;fillColor=#fff9c4;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="83" y="440" width="444" height="184" as="geometry" /></mxCell><mxCell id="34" value="clickLogout() calls logout() and picks the message:&#10;loggedOut == True -&gt; MSG_LOGGED_OUT,&#10;loggedOut == False -&gt; MSG_SESSION_ENDED.&#10;displayLoginPage(msg) flashes it and redirects to&#10;/manager/login. Precondition: none is enforced -&#10;/manager/logout has no decorator, so a log out with&#10;no session just shows MSG_SESSION_ENDED." style="text;html=0;align=left;verticalAlign=top;fontSize=16;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="101" y="456" width="412" height="160" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="6 Sequence Diagram"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageWidth="1060" pageHeight="931"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" value="Sequence Diagram - UC40 Platform manager log out (US40)" style="text;html=0;align=left;verticalAlign=top;fontSize=26;fontStyle=1;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="22" y="17" width="1650" height="39" as="geometry" /></mxCell><mxCell id="3" value="POST /manager/logout → clickLogout(). No entity is needed - log out only ends the session." style="text;html=0;align=left;verticalAlign=top;fontSize=14;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="22" y="62" width="646.56" height="23" as="geometry" /></mxCell><mxCell id="4" value="" style="endArrow=none;html=0;dashed=1;strokeColor=#334155;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="225" as="sourcePoint" /><mxPoint x="110" y="811" as="targetPoint" /></mxGeometry></mxCell><mxCell id="5" value="" style="endArrow=none;html=0;dashed=1;strokeColor=#334155;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="440" y="225" as="sourcePoint" /><mxPoint x="440" y="811" as="targetPoint" /></mxGeometry></mxCell><mxCell id="6" value="" style="endArrow=none;html=0;dashed=1;strokeColor=#334155;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="840" y="225" as="sourcePoint" /><mxPoint x="840" y="811" as="targetPoint" /></mxGeometry></mxCell><mxCell id="7" v