  <diagram name="5 BCE Class Diagram" id="8"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1023" pageHeight="625" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="b1" value="&lt;b&gt;B-C-E Class Diagram - UC17 Delete company profile (US17)&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=15;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="531.56" height="24" as="geometry" /></mxCell><mxCell id="b2" value="&lt;b&gt;Boundary&lt;/b&gt;" style="shape=folder;tabWidth=80;tabHeight=20;tabPosition=left;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=0;fillColor=none;fontSize=12;strokeColor=#777777;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="377.3" height="535.9" as="geometry" /></mxCell><mxCell id="b3" value="«boundary»&lt;br&gt;&lt;b&gt;DeleteCompanyProfilePage&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fontSize=11;fillColor=#E3F2FD;strokeColor=#1565C0;swimlaneFillColor=#FFFFFF;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="100" width="337.3" height="179" as="geometry" /></mxCell><mxCell id="b4" value="+clickDelete()&lt;br&gt;+displayConfirmation(profile)&lt;br&gt;+submitDelete(choice, companyId, confirmationToken)&lt;br&gt;+confirmDelete(companyId, confirmationToken)&lt;br&gt;+cancelDelete()&lt;br&gt;+closeConfirmation()&lt;br&gt;+displaySuccessMessage(msg)&lt;br&gt;+displayErrorMessage(msg)&lt;br&gt;+displayNotFoundMessage()" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0