  <diagram name="5 BCE Class Diagram" id="8"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1424" pageHeight="859" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="b1" value="&lt;b&gt;B-C-E Class Diagram - UC17 Delete company profile and UC17-R Restore company profile (US17)&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=15;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="699" height="24" as="geometry" /></mxCell><mxCell id="b2" value="&lt;b&gt;Boundary&lt;/b&gt;" style="shape=folder;tabWidth=80;tabHeight=20;tabPosition=left;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=0;fillColor=none;fontSize=12;strokeColor=#777777;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="396" height="789" as="geometry" /></mxCell><mxCell id="b3" value="«boundary»&lt;br&gt;&lt;b&gt;DeleteCompanyProfilePage&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fontSize=11;fillColor=#E3F2FD;strokeColor=#1565C0;swimlaneFillColor=#FFFFFF;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="100" width="356" height="210" as="geometry" /></mxCell><mxCell id="b4" value="-deleteCompanyProfileController: DeleteCompanyProfileController" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=nowrap;html=1;fontSize=11;fontColor=#000000;" vertex="1" parent="b3"><mxGeometry x="0" y="40" width="356" height="28" as="geometry" /></mxCell><mxCell id="b5" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=#1565C0;fontColor=#000000;" vertex="1" parent="b3"><mxGeometry x="0" y="68" width="356" height="8" as="geometry" /></mxCell><mxCell id="b6" value="+clickDelete()&lt;br&gt;+displayConfirmation(profile)&lt;br&gt;+submitDelete(choice, companyId, revision)&lt;br&gt;+confirmDelete(companyId, revision)&lt;br&gt;+cancelDelete()&lt;br&gt;+closeConfirmation()&lt;br&gt;+displaySuccessMessage(msg)&lt;br&gt;+displayErrorMessage(msg)&lt;br&gt;+displayNotFoundMessage()" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=nowrap;html=1;fontSize=11;fontColor=#000000;" vertex="1" parent="b3"><mxGeometry x="0" y="76" width="356" height="134" as="geometry" /></mxCell><mxCell id="b7" value="«boundary» (from US13)&lt;br&gt;&lt;b&gt;InteriorDesignerLoginPage&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fontSize=11;fillColor=#E3F2FD;strokeColor=#1565C0;swimlaneFillColor=#FFFFFF;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="370" width="356" height="68" as="geometry" /></mxCell><mxCell id="b8" value="+openDashboard()" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=nowrap;html=1;fontSize=11;fontColor=#000000;" vertex="1" parent="b7"><mxGeometry x="0" y="40" width="356" height="28" as="geometry" /></mxCell><mxCell id="b9" value="«boundary»&lt;br&gt;&lt;b&gt;RestoreCompanyProfilePage&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fontSize=11;fillColor=#E3F2FD;strokeColor=#1565C0;swimlaneFillColor=#FFFFFF;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="498" width="356" height="131" as="geometry" /></mxCell><mxCell id="b10" value="-restoreCompanyProfileController: RestoreCompanyProfileController" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=nowrap;html=1;fontSize=11;fontColor=#000000;" vertex="1" parent="b9"><mxGeometry x="0" y="40" width="356" height="28" as="geometry" /></mxCell><mxCell id="b11" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=#1565C0;fontColor=#000000;" vertex="1" parent="b9"><mxGeometry x="0" y="68" width="356" height="8" as="geometry" /></mxCell><mxCell id="b12" value="+submitRestore(companyId, revision)&lt;br&gt;+displaySuccessMessage(msg)&lt;br&gt;+displayErrorMessage(msg)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=nowrap;html=1;fontSize=11;fontColor=#000000;" vertex="1" parent="b9"><mxGeometry x="0" y="76" width="356" height="55" as="geometry" /></mxCell><mxCell id="b13" value="The confirmation box and the dashboard's Restore&lt;br&gt;button hold hidden companyId + revision.&lt;br&gt;submitDelete(): choice &quot;delete&quot; -&amp;gt; confirmDelete(),&lt;br&gt;&quot;cancel&quot; -&amp;gt; cancelDelete(), anything else -&amp;gt; HTTP 400.&lt;br&gt;No confirmation token, nothing is kept in the session&lt;br&gt;and the pages don't compare owner or companyId -&lt;br&gt;the entity's revision check is enough.&lt;br&gt;designerId always comes from the session." style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#FFF9C4;strokeColor=#B8A100;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=4;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="689" width="356" height="130" as="geometry" /></mxCell><mxCell id="b14" value="&lt;b&gt;Control&lt;/b&gt;" style="shape=folder;tabWidth=80;tabHeight=20;tabPosition=left;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=0;fillColor=none;fontSize=12;strokeColor=#777777;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="516" y="50" width="394" height="789" as="geometry" /></mxCell><mxCell id="b15" value="«control»&lt;br&gt;&lt;b&gt;DeleteCompanyProfileController&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fontSize=11;fillColor=#FFF3E0;strokeColor=#E65100;swimlaneFillColor=#FFFFFF;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="536" y="100" width="354" height="95" as="geometry" /></mxCell><mxCell id="b16" value="+getCompanyProfile(designerId): CompanyProfile | None&lt;br&gt;+deleteCompanyProfile(designerId, companyId,&lt;br&gt;      expectedRevision): bool" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=nowrap;html=1;fontSize=11;fontColor=#000000;" vertex="1" parent="b15"><mxGeometry x="0" y="40" width="354" height="55" as="geometry" /></mxCell><mxCell id="b17" value="«control»&lt;br&gt;&lt;b&gt;RestoreCompanyProfileController&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fontSize=11;fillColor=#FFF3E0;strokeColor=#E65100;swimlaneFillColor=#FFFFFF;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="536" y="435" width="354" height="95" as="geometry" /></mxCell><mxCell id="b18" value="+getSuspendedCompanyProfile(designerId): CompanyProfile | None&lt;br&gt;+restoreCompanyProfile(designerId, companyId,&lt;br&gt;      expectedRevision): bool" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=nowrap;html=1;fontSize=11;fontColor=#000000;" vertex="1" parent="b17"><mxGeometry x="0" y="40" width="354" height="55" as="geometry" /></mxCell><mxCell id="b19" value="The controllers just call the entity and return the&lt;br&gt;result - no checks. getCompanyProfile() is US17's own&lt;br&gt;loader for the confirmation box. US13's dashboard&lt;br&gt;calls getSuspendedCompanyProfile() to show the&lt;br&gt;Restore button (first step of UC17-R).&lt;br&gt;Precondition: logged in as an interior designer&lt;br&gt;(UC13). designerLoginRequired in app.py only&lt;br&gt;sends someone with no session to /designer/login." style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#FFF9C4;strokeColor=#B8A100;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=4;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="536" y="590" width="354" height="130" as="geometry" /></mxCell><mxCell id="b20" value="&lt;b&gt;Entity&lt;/b&gt;" style="shape=folder;tabWidth=80;tabHeight=20;tabPosition=left;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=0;fillColor=none;fontSize=12;strokeColor=#777777;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="990" y="50" width="394" height="789" as="geometry" /></mxCell><mxCell id="b21" value="«entity»&lt;br&gt;&lt;b&gt;CompanyProfile&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fontSize=11;fillColor=#E8F5E9;strokeColor=#2E7D32;swimlaneFillColor=#FFFFFF;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1010" y="100" width="354" height="302" as="geometry" /></mxCell><mxCell id="b22" value="-companyId: int&lt;br&gt;-designerId: int (unique owner)&lt;br&gt;-companyName: String&lt;br&gt;-description: String&lt;br&gt;-services: String&lt;br&gt;-email: String&lt;br&gt;-phone: String&lt;br&gt;-address: String&lt;br&gt;-createdDate: String&lt;br&gt;-status: String&lt;br&gt;-revision: int" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=nowrap;html=1;fontSize=11;fontColor=#000000;" vertex="1" parent="b21"><mxGeometry x="0" y="40" width="354" height="160" as="geometry" /></mxCell><mxCell id="b23" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=#2E7D32;fontColor=#000000;" vertex="1" parent="b21"><mxGeometry x="0" y="200" width="354" height="8" as="geometry" /></mxCell><mxCell id="b24" value="+getCompanyProfile(designerId): CompanyProfile | None&lt;br&gt;+suspendCompanyProfile(designerId, companyId,&lt;br&gt;      expectedRevision): bool&lt;br&gt;+getSuspendedCompanyProfile(designerId): CompanyProfile | None&lt;br&gt;+restoreCompanyProfile(designerId, companyId,&lt;br&gt;      expectedRevision): bool" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=nowrap;html=1;fontSize=11;fontColor=#000000;" vertex="1" parent="b21"><mxGeometry x="0" y="208" width="354" height="94" as="geometry" /></mxCell><mxCell id="b25" value="suspendCompanyProfile() only changes the owner's&lt;br&gt;Active row whose revision still matches: status =&lt;br&gt;'Suspended' - the row and its details are kept.&lt;br&gt;restoreCompanyProfile() only changes the owner's&lt;br&gt;Suspended row whose revision matches: status =&lt;br&gt;'Active' and revision + 1, so an old Delete form&lt;br&gt;can't suspend the restored profile." style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#FFF9C4;strokeColor=#B8A100;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=4;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1010" y="462" width="354" height="116" as="geometry" /></mxCell><mxCell id="b26" value="calls" style="endArrow=open;endFill=0;endSize=10;html=1;rounded=0;fontSize=10;fontColor=#000000;strokeColor=#000000;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="b3" target="b15"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="b27" value="calls" style="endArrow=open;endFill=0;endSize=10;html=1;rounded=0;fontSize=10;fontColor=#000000;strokeColor=#000000;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="b9" target="b17"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="b28" value="calls (Restore button)" style="endArrow=open;endFill=0;endSize=10;html=1;rounded=0;fontSize=10;fontColor=#000000;strokeColor=#000000;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="b7" target="b17"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="b29" value="uses" style="endArrow=open;endFill=0;dashed=1;html=1;rounded=0;fontSize=10;fontColor=#000000;strokeColor=#000000;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="b15" target="b21"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="b30" value="uses" style="endArrow=open;endFill=0;dashed=1;html=1;rounded=0;fontSize=10;fontColor=#000000;strokeColor=#000000;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="b17" target="b21"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram>
