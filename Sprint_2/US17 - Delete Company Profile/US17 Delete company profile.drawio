47" as="geometry" /></mxCell><mxCell id="b13" value="The controllers just call the entity - no checks.&lt;br&gt;&lt;br&gt;Precondition: the designer is already logged in&lt;br&gt;(UC13), so this use case doesn&#x27;t check the&lt;br&gt;designer again - no InteriorDesignerLoginController." style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#FFF9C4;strokeColor=#B8A100;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=4;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="517.3" y="414" width="406.6" height="90.5" as="geometry" /></mxCell><mxCell id="b14" value="&lt;b&gt;Entity&lt;/b&gt;" style="shape=folder;tabWidth=80;tabHeight=20;tabPosition=left;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=0;fillColor=none;fontSize=12;strokeColor=#777777;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1023.9" y="50" width="446.6" height="535.9" as="geometry" /></mxCell><mxCell id="b15" value="«entity»&lt;br&gt;&lt;b&gt;CompanyProfile&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fontSize=11;fillColor=#E8F5E9;strokeColor=#2E7D32;swimlaneFillColor=#FFFFFF;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1043.9" y="100" width="406.6" height="312" as="geometry" /></mxCell><mxCell id="b16" value="-companyId: int&lt;br&gt;-designerId: int (unique owner)&lt;br&gt;-companyName: String&lt;br&gt;-description: String&lt;br&gt;-services: String&lt;br&gt;-email: String&lt;br&gt;-phone: String&lt;br&gt;-address: String&lt;br&gt;-createdDate: String&lt;br&gt;-status: String&lt;br&gt;-revision: int" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=nowrap;html=1;fontSize=11;fontColor=#000000;" vertex="1" parent="b15"><mxGeometry x="0" y="40" width="406.6" height="171" as="geometry" /></mxCell><mxCell id="b17" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=#2E7D32;fontColor=#000000;" vertex="1" parent="b15"><mxGeometry x="0" y="211" width="406.6" height="8" as="geometry" /></mxCell><mxCell id="b18" value="+getCompanyProfile(designerId): CompanyProfile | None&lt;br&gt;+suspendCompanyProfile(designerId, companyId,&lt;br&gt;        expectedRevision=None): bool&lt;br&gt;+getSuspendedCompanyProfile(designerId): CompanyProfile | None&lt;br&gt;+restoreCompanyProfile(designerId, companyId,&lt;br&gt;        expectedRevision): bool" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=nowrap;html=1;fontSize=11;fontColor=#000000;" vertex="1" parent="b15"><mxGeometry x="0" y="219" width="406.6" height="93" as="geometry" /></mxCell><mxCell id="b19" value="Delete keeps the row and sets status =&lt;br&gt;&#x27;Suspended&#x27;. Restore sets it back to &#x27;Active&#x27;&lt;br&gt;and adds 1 to revision." style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#FFF9C4;strokeColor=#B8A100;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=4;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1043.9" y="482" width="406.6" height="59.9" as="geometry" /></mxCell><mxCell id="b20" value="calls" style="endArrow=open;endFill=0;endSize=10;html=1;rounded=0;fontSize=10;fontColor=#000000;strokeColor=#000000;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="b3" target="b9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b21" value="calls" style="endArrow=open;endFill=0;endSize=10;html=1;rounded=0;fontSize=10;fontColor=#000000;strokeC