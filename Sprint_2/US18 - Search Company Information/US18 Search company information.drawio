metry x="579" y="100" width="275" height="81" as="geometry" /></mxCell><mxCell id="b10" value="+searchCompanyInformation(designerId, keyword):&lt;br&gt;      CompanyProfile | None" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=nowrap;html=1;fontSize=11;fontColor=#000000;" vertex="1" parent="b9"><mxGeometry x="0" y="40" width="275" height="41" as="geometry" /></mxCell><mxCell id="b11" value="The controller just calls the entity and returns&lt;br&gt;the result - no checks of its own.&lt;br&gt;Precondition: logged in as an interior designer&lt;br&gt;(UC13). designerLoginRequired in app.py only&lt;br&gt;sends someone with no session to /designer/login." style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#FFF9C4;strokeColor=#B8A100;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=4;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="579" y="241" width="275" height="88" as="geometry" /></mxCell><mxCell id="b12" value="&lt;b&gt;Entity&lt;/b&gt;" style="shape=folder;tabWidth=80;tabHeight=20;tabPosition=left;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=0;fillColor=none;fontSize=12;strokeColor=#777777;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="954" y="50" width="321" height="508" as="geometry" /></mxCell><mxCell id="b13" value="«entity»&lt;br&gt;&lt;b&gt;CompanyProfile&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fontSize=11;fillColor=#E8F5E9;strokeColor=#2E7D32;swimlaneFillColor=#FFFFFF;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="974" y="100" width="281" height="262" as="geometry" /></mxCell><mxCell id="b14" value="-companyId: int&lt;br&gt;-designerId: int (unique owner)&lt;br&gt;-companyName: String&lt;br&gt;-description: String&lt;br&gt;-services: String&lt;br&gt;-email: String&lt;br&gt;-phone: String&lt;br&gt;-address: String&lt;br&gt;-createdDate: String&lt;br&gt;-status: String&lt;br&gt;-revision: int&lt;br&gt;-matchedFields: list[String]" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=nowrap;html=1;fontSize=11;fontColor=#000000;" vertex="1" parent="b13"><mxGeometry x="0" y="40" width="281" height="173" as="geometry" /></mxCell><mxCell id="b15" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=#2E7D32;fontColor=#000000;" vertex="1" parent="b13"><mxGeometry x="0" y="213" width="281" height="8" as="geometry" /></mxCell><mxCell id="b16" value="+searchCompanyInformation(designerId, keyword):&lt;br&gt;      CompanyProfile | None" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=nowrap;html=1;fontSize=11;fontColor=#000000;" vertex="1" parent="b13"><mxGeometry x="0" y="221" width="281" height="41" as="geometry" /></mxCell><mxCell id="b17" value="searchCompanyInformation() loads the designer's&lt;br&gt;Active profile: none -&amp;gt; None. Otherwise it returns&lt;br&gt;that CompanyProfile with matchedFields = the names&lt;br&gt;of the six business fields whose name or value&lt;br&gt;contains the keyword (capitals don't matter; empty&lt;br&gt;keyword -&amp;gt; all six). Empty list = no match.&lt;br&gt;Searching never changes any data." style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#FFF9C4;strokeColor=#B8A100;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=4;fontSi