as="geometry" /></mxCell><mxCell id="s24" value="the page trims the spaces from the username" style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#FFF9C4;strokeColor=#B8A100;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=4;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="415" y="384" width="245" height="32" as="geometry" /></mxCell><mxCell id="s25" value="5: login(username, password)" style="html=1;verticalAlign=bottom;fontSize=11;rounded=0;endArrow=block;endFill=1;endSize=8;fontColor=#000000;strokeColor=#000000;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="390" y="446" as="sourcePoint" /><mxPoint x="715" y="446" as="targetPoint" /></mxGeometry></mxCell><mxCell id="s26" value="6: verifyCredentials(username, password,&lt;br&gt;REQUIRED_MANAGER_PERMISSIONS)" style="html=1;verticalAlign=bottom;fontSize=11;rounded=0;endArrow=block;endFill=1;endSize=8;fontColor=#000000;strokeColor=#000000;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="725" y="494" as="sourcePoint" /><mxPoint x="1075" y="494" as="targetPoint" /></mxGeometry></mxCell><mxCell id="s27" value="returns the account only if the password is right,&lt;br&gt;the account is Active, its profile is Active and the&lt;br&gt;profile has both manager permissions - otherwise None" style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#FFF9C4;strokeColor=#B8A100;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=4;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1110" y="506" width="292" height="60" as="geometry" /></mxCell><mxCell id="s28" value="7: account" style="html=1;verticalAlign=bottom;fontSize=11;rounded=0;endArrow=open;dashed=1;endSize=8;fontColor=#000000;strokeColor=#000000;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1075" y="596" as="sourcePoint" /><mxPoin