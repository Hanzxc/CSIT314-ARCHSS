    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1452" pageHeight="1332" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="s1" value="&lt;b&gt;Sequence Diagram - UC39 Platform manager log in (US39)&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=15;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="426" height="24" as="geometry" /></mxCell><mxCell id="s2" value="Platform managers log in on /manager/login. The shared /login page is for User Admins only (UC1)." style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#FFF9C4;strokeColor=#B8A100;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=4;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="42" width="502" height="32" as="geometry" /></mxCell><mxCell id="s3" value="Platform Manager" style="shape=umlLifeline;participant=umlActor;perimeter=lifelinePerimeter;whiteSpace=nowrap;html=1;container=0;collapsible=0;recursiveResize=0;verticalAlign=top;spacingTop=40;outlineConnect=0;size=40;fontSize=11;labelBackgroundColor=#FFFFFF;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="85" y="82" width="30" height="1230" as="geometry" /></mxCell><mxCell id="s4" value=":PlatformManagerLoginPage" style="shape=umlLifeline;participant=umlBoundary;perimeter=lifelinePerimeter;whiteSpace=nowrap;html=1;container=0;collapsible=0;recursiveResize=0;verticalAlign=top;spacingTop=40;outlineConnect=0;size=40;fontSize=11;labelBackgroundColor=#FFFFFF;fillColor=#E3F2FD;strokeColor=#1565C0;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="360" y="82" width="50" height="1230" as="geometry" /></mxCell><mxCell id="s5" value=":PlatformManagerLoginController" style="shape=umlLifeline;participant=umlControl;peri