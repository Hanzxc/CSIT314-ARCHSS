bool" style="text;html=0;align=left;verticalAlign=top;fontSize=17;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="704" y="683" width="562" height="24" as="geometry" /></mxCell><mxCell id="26" value="" style="endArrow=open;html=0;dashed=0;strokeColor=#334155;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="550" y="260" as="sourcePoint" /><mxPoint x="690" y="260" as="targetPoint" /></mxGeometry></mxCell><mxCell id="27" value="calls" style="text;html=0;align=left;verticalAlign=top;fontSize=13;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="558" y="238" width="240" height="20" as="geometry" /></mxCell><mxCell id="28" value="" style="endArrow=open;html=0;dashed=1;strokeColor=#334155;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="985" y="315" as="sourcePoint" /><mxPoint x="985" y="600" as="targetPoint" /></mxGeometry></mxCell><mxCell id="29" value="uses" style="text;html=0;align=left;verticalAlign=top;fontSize=13;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="993" y="293" width="100" height="20" as="geometry" /></mxCell><mxCell id="30" value="" style="rounded=0;whiteSpace=wrap;fillColor=#fff9c4;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="1420" y="190" width="600" height="230" as="geometry" /></mxCell><mxCell id="31" value="No business entity is required.&#10;Logout does not read, update or delete company/account rows.&#10;The Entity column is intentionally empty.&#10;Flask session is framework infrastructure, not an entity." style="text;html=0;align=left;verticalAlign=top;fontSize=18;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="1440" y="212" width="560" height="100" as="geometry" /></mxCell><mxCell id="32" value="" style="rounded=0;whiteSpace=wrap;fillColor=#fff9c4;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="690" y="850" width="590" height="155" as="geometry" /></mxCell><mxCell id="33" value="The US19 control reuses US2 logout(), then clears&#10;any remaining session data, including stale confirmations.&#10;The Boundary flashes one message and redirects to login." style="text;html=0;align=left;verticalAlign=top;fontSize=18;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="710" y="867" width="550" height="75" as="geometry" /></mxCell><mxCell id="34" value="One shared header button is available on all designer pages.&#10;The existing admin logout route and classes are unchanged." style="text;html=0;align=left;verticalAlign=top;fontSize=17;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="85" y="998" width="650" height="48" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="6 Sequence Diagram"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageWidth="1680" pageHeight="1740"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" value="Sequence Diagram - UC19 Interior designer log out (US19)" style="text;html=0;align=left;verticalAlign=top;fontSize=26;fontStyle=1;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="22" y="16" width="900" height="33" as="geometry" /></mxCell><mxCell id="3" value="POST /designer/logout → clickLogout(). No business entity is involved; the current browser session is cleared." style="text;html=0;align=left;verticalAlign=top;fontSize=14;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="22" y="63" width="900" height="21" as="geometry" /></mxCell><mxCell id="4" value="" style="rounded=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="60" y="550" width="1550" height="380" as="geometry" /></mxCell><mxCell id="5" value="" style="rounded=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry x="60" y="550" width="65" height="30" as="geometry" /></mxCell><mxCell id="6" value="alt" style="text;html=0;align=left;verticalAlign=top;fontSize=15;fontStyle=0;fontColor=