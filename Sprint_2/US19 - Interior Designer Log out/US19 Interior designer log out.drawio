eFillColor=#FFFFFF;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="100" width="349" height="117" as="geometry" /></mxCell><mxCell id="b4" value="-interiorDesignerLogoutController: InteriorDesignerLogoutController" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=nowrap;html=1;fontSize=11;fontColor=#000000;" vertex="1" parent="b3"><mxGeometry x="0" y="40" width="349" height="28" as="geometry" /></mxCell><mxCell id="b5" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=#1565C0;fontColor=#000000;" vertex="1" parent="b3"><mxGeometry x="0" y="68" width="349" height="8" as="geometry" /></mxCell><mxCell id="b6" value="+clickLogout()&lt;br&gt;+displayLoginPage(msg)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=nowrap;html=1;fontSize=11;fontColor=#000000;" vertex="1" parent="b3"><mxGeometry x="0" y="76" width="349" height="41" as="geometry" /></mxCell><mxCell id="b7" value="The Log out button is in the header of every&lt;br&gt;designer page (POST /designer/logout).&lt;br&gt;clickLogout() picks the message from the&lt;br&gt;controller's result and sends the designer&lt;br&gt;to /designer/login." style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#FFF9C4;strokeColor=#B8A100;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=4;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="277" width="349" height="88" as="geometry" /></mxCell><mxCell id="b8" value="&lt;b&gt;Control&lt;/b&gt;" style="shape=folder;tabWidth=80;tabHeight=20;tabPosition=left;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=0;fillColor=none;fontSize=12;strokeColor=#777777;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="509" y="50" width="285" height="335" as="geometry" /></mxCell><mxCell id="b9" value="«control»&lt;br&gt;&lt;b&gt;InteriorDesignerLogoutController&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fontSize=11;fillColor=#FFF3E0;strokeColor=#E65100;swimlaneFillColor=#FFFFFF;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="529" y="100" width="245" height="68" as="geometry" /></mxCell><mxCell id="b10" value="+logout(): bool" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=nowrap;html=1;fontSize=11;fontColor=#000000;" vertex="1" parent="b9"><mxGeometry x="0" y="40" width="245" height="28" as="geometry" /></mxCell><mxCell id="b11" value="logout() does the whole job itself:&lt;br&gt;loggedOut = &quot;userId&quot; in session&lt;br&gt;session.clear()&lt;br&gt;return loggedOut&lt;br&gt;It does not call US2's LogoutController.&lt;br&gt;Precondition: none is enforced - the route has&lt;br&gt;no decorator, so with no session the designer&lt;br&gt;just sees &quot;Your session has already ended&quot;." style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#FFF9C4;strokeColor=#B8A100;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=4;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="529" y="228" width="245" height="130" as="geometry" /></mxCell><mxCell id="b12" value="&lt;b&gt;Entity&lt;/b&gt;" style="shape=folder;tabWidth=80;tabHeight=20;tabPosition=left;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=0;fillColor=none;fontSize=12;strokeColor=#777777;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="874" y="50" width="283" height="335" as="geometry" /></mxCell><mxCell id="b13" value="No entity class is needed for log out.&lt;br&gt;Logging out does not read or change any&lt;br&gt;saved data - the controller only ends&lt;br&gt;the session that was started at log in (UC13)." style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#FFF9C4;strokeColor=#B8A100;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=4;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="894" y="100" width="243" height="74" as="geometry" /></mxCell><mxCell id="b14" value="calls" style="endArrow=open;endFill=0;endSize=10;html=1;rounded=0;fontSize=10;fontColor=#000000;strokeColor=#000000;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="b3" target="b9"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="6 Sequence Diagram"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="954" pageHeight="704" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="s1" value="&lt;b&gt;Sequence Diagram - UC19 Interior designer log out (US19)&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=15;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="427" height="24" as="geometry" /></mxCell><mxCell id="s2" value="POST /designer/logout has no decorator: with no session the designer just gets&lt;br&gt;&quot;Your session has already ended&quot;." style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#FFF9C4;strokeColor=#B8A100;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=4;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="42" width="408" height="46" as="geometry" /></mxCell><mxCell id="s3" value="Interior Designer" style="shape=umlLifeline;participant=umlActor;perimeter=lifelinePerimeter;whiteSpace=nowrap;html=1;container=0;collapsible=0;recursiveResize=0;verticalAlign=top;spacingTop=40;outlineConnect=0;size=40;fontSize=11;labelBackgroundColor=#FFFFFF;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="85" y="96" width="30" height="588" as="geometry" /></mxCell><mxCell id="s4" value=":InteriorDesignerLogoutPage" style="shape=umlLifeline;participant=umlBoundary;perimeter=lifelinePerimeter;whiteSpace=nowrap;html=1;container=0;collapsible=0;recursiveResize=0;verticalAlign=top;spacingTop=40;outlineConnect=0;size=40;fontSize=11;labelBackgroundColor=#FFFFFF;fillColor=#E3F2FD;strokeColor=#1565C0;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="300" y="96" width="50" height="588" as="geometry" /></mxCell><mxCell id="s5" value=":InteriorDesignerLogoutController" style="shape=umlLifeline;participant=umlControl;perimeter=lifelinePerimeter;whiteSpace=nowrap;html=1;container=0;collapsible=0;recursiveResize=0;verticalAlign=top;spacingTop=40;outlineConnect=0;size=40;fontSize=11;labelBackgroundColor=#FFFFFF;fillColor=#FFF3E0;strokeColor=#E65100;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="660" y="96" width="40" height="588" as="geometry" /></mxCell><mxCell id="s6" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=44;height=22;fillColor=none;fontStyle=1;fontSize=11;fontColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="30" y="374" width="634" height="260" as="geometry" /></mxCell><mxCell id="s7" value="[loggedOut == True]" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=11;fontStyle=1;fontColor=#000000;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="82" y="375" width="119" height="20" as="geometry" /></mxCell><mxCell id="s8" value="" style="endArrow=none;dashed=1;html=1;rounded=0;strokeColor=#