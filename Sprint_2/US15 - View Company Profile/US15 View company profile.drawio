idth="20" height="24" as="geometry" /></mxCell><mxCell id="49" value="Read-only view: no data changes. Back returns to the dashboard. Update/delete are later stories." style="text;html=0;align=left;verticalAlign=top;fontSize=16;fontStyle=0;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="90" y="1019" width="1160" height="23" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="5 BCE Class Diagram"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1292" pageHeight="496" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="b1" value="&lt;b&gt;B-C-E Class Diagram - UC15 View company profile (US15)&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=15;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="425" height="24" as="geometry" /></mxCell><mxCell id="b2" value="&lt;b&gt;Boundary&lt;/b&gt;" style="shape=folder;tabWidth=80;tabHeight=20;tabPosition=left;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=0;fillColor=none;fontSize=12;strokeColor=#777777;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="367" height="426" as="geometry" /></mxCell><mxCell id="b3" value="«boundary»&lt;br&gt;&lt;b&gt;ViewCompanyProfilePage&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fontSize=11;fillColor=#E3F2FD;strokeColor=#1565C0;swimlaneFillColor=#FFFFFF;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="100" width="327" height="131" as="geometry" /></mxCell><mxCell id="b4" value="-viewCompanyProfileController: ViewCompanyProfileController" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=nowrap;html=1;fontSize=11;fontColor=#000000;" vertex="1" parent="b3"><mxGeometry x="0" y="40" width="327" height="28" as="geometry" /></mxCell><mxCell id="b5" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=#1565C0;fontColor=#000000;" vertex="1" parent="b3"><mxGeometry x="0" y="68" width="327" height="8" as="geometry" /></mxCell><mxCell id="b6" value="+clickView()&lt;br&gt;+displayCompanyProfile(profile)&lt;br&gt;+displayErrorMessage(msg)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=nowrap;html=1;fontSize=11;fontColor=#000000;" vertex="1" parent="b3"><mxGeometry x="0" y="76" width="327" height="55" as="geometry" /></mxCell><mxCell id="b7" value="clickView() asks its controller for the logged-in&lt;br&gt;designer's profile (designerId = session userId -&lt;br&gt;nothing is taken from the URL). There is no typed&lt;br&gt;input. Found -&amp;gt; the company details; None -&amp;gt;&lt;br&gt;&quot;You have not created a company profile yet&quot; (404)." style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#FFF9C4;strokeColor=#B8A100;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=4;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="291" width="327" height="88" as="geometry" /></mxCell><mxCell id="b8" value="&lt;b&gt;Control&lt;/b&gt;" style="shape=folder;tabWidth=80;tabHeight=20;tabPosition=left;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=0;fillColor=none;fontSize=12;strokeColor=#777777;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="487" y="50" width="346" height="426" as="geometry" /></mxCell><mxCell id="b9" value="«control»&lt;br&gt;&lt;b&gt;ViewCompanyProfileController&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fontSize=11;fillColor=#FFF3E0;strokeColor=#E65100;swimlaneFillColor=#FFFFFF;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="507" y="100" width="306" height="68" as="geometry" /></mxCell><mxCell id="b10" value="+viewCompanyProfile(designerId): CompanyProfile | None" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=nowrap;html=1;fontSize=11;fontColor=#000000;" vertex="1" parent="b9"><mxGeometry x="0" y="40" width="306" height="28" as="geometry" /></mxCell><mxCell id="b11" value="The controller just calls the entity and returns&lt;br&gt;the profile (or None) - one call, no checks.&lt;br&gt;US13's dashboard borrows it too.&lt;br&gt;Precondition: logged in as an interior designer&lt;br&gt;(UC13). designerLoginRequired in app.py only&lt;br&gt;sends someone with no session to /designer/login." style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#FFF9C4;strokeColor=#B8A100;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=4;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="507" y="228" width="306" height="102" as="geometry" /></mxCell><mxCell id="b12" value="&lt;b&gt;Entity&lt;/b&gt;" style="shape=folder;tabWidth=80;tabHeight=20;tabPosition=left;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=0;fillColor=none;fontSize=12;strokeColor=#777777;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="913" y="50" width="339" height="426" as="geometry" /></mxCell><mxCell id="b13" value="«entity»&lt;br&gt;&lt;b&gt;CompanyProfile&lt;/b&