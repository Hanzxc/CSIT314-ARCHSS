# Boundary: Route handler for UC25 Add Past IDP
from flask import Blueprint, request, render_template, redirect, url_for, flash, session
from control.addPastIDPController import AddPastIDPController
from entity.idpCategory import IDPCategory

add_past_idp_bp = Blueprint('add_past_idp', __name__)

@add_past_idp_bp.route('/designer/past-idps/add', methods=['GET', 'POST'])
def addPastIDP():
    if session.get('user_role') != 'Interior Designer':
        return redirect('/designer/login')

    controller = AddPastIDPController()
    category_entity = IDPCategory()

    if request.method == 'POST':
        title = request.form.get('title')
        category_id = request.form.get('categoryId')
        description = request.form.get('description')
        location = request.form.get('location')

        success, message = controller.addPastIDP(
            designerId=session.get('user_id'),
            categoryId=category_id,
            title=title,
            description=description,
            location=location
        )

        if success:
            flash(message, "success")
            return redirect('/designer/past-idps')
        else:
            flash(message, "error")

    active_categories = category_entity.getActiveCategories()
    return render_template('add_past_idp.html', categories=active_categories)